---
// Reserved ad space. Replace the placeholder block with the Google AdSense snippet once the account is approved.
// The fixed minimum height keeps the layout from shifting when the real ad loads.
interface Props {
  slotType?: 'leaderboard' | 'infeed' | 'rectangle';
}

const { slotType = 'leaderboard' } = Astro.props;
const size = {
  leaderboard: { box: 'min-h-[100px] sm:min-h-[90px]', text: 'Banner ad space  728 x 90' },
  infeed: { box: 'min-h-[120px]', text: 'In-feed ad space  responsive' },
  rectangle: { box: 'min-h-[250px]', text: 'Rectangle ad space  300 x 250' },
}[slotType];
---

<aside
  aria-label="Advertisement"
  class={`my-6 flex w-full flex-col items-center justify-center border border-dashed editorial-rule-strong px-4 text-center ${size.box}`}
>
  <span class="text-[11px] font-semibold uppercase tracking-[0.2em] text-ink-muted">Advertisement</span>
  <span class="mt-1 text-[13px] text-ink-muted">{size.text}</span>
</aside>
