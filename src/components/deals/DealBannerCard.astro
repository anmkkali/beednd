---
import Icon from '../common/Icon.astro';

interface Props {
  deal: {
    id: string;
    slug: string;
    title: string;
    short_description: string;
    brand_id: string;
    country?: string;
    category: string;
    deal_type: string;
    discount_value: string;
    promo_code?: string;
    affiliate_url: string;
    cities?: string[];
    tags?: string[];
    bank_details?: {
      bank_id: string;
      eligible_cards: string[];
      cashback_percent?: number;
    };
  };
  brandName?: string;
  brandLogo?: string;
}

const { deal, brandName = deal.brand_id, brandLogo } = Astro.props;
const formattedType = deal.deal_type.replaceAll('-', ' ');
---

<article
  class="group border border-base-700 bg-base-950 p-4 transition-colors hover:bg-base-900 sm:p-5"
  data-deal-id={deal.id}
  data-market={deal.country || 'GLOBAL'}
  data-category={deal.category}
  data-tags={(deal.tags || []).join(' ').toLowerCase()}
>
  <div class="flex items-start gap-4">
    <a href={`/brands/${deal.brand_id}`} class="flex h-12 w-12 shrink-0 items-center justify-center border border-base-700 bg-white p-2">
      <img
        src={brandLogo || `https://www.google.com/s2/favicons?domain=${deal.brand_id}.com&sz=64`}
        alt={`${brandName} logo`}
        class="h-full w-full object-contain"
        loading="lazy"
        width="36"
        height="36"
      />
    </a>

    <div class="min-w-0 flex-1">
      <div class="mb-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px]">
        <a href={`/brands/${deal.brand_id}`} class="font-bold uppercase tracking-wide text-gray-300 hover:text-brand-blue">{brandName}</a>
        <span class="text-gray-700">/</span>
        <span class="capitalize text-gray-500">{formattedType}</span>
        {deal.country && deal.country !== 'GLOBAL' && (
          <>
            <span class="text-gray-700">/</span>
            <span class="text-gray-500">{deal.country}</span>
          </>
        )}
      </div>

      <div class="flex flex-col justify-between gap-3 sm:flex-row sm:items-start">
        <div class="min-w-0">
          <h3 class="text-base font-bold leading-snug text-white transition-colors group-hover:text-brand-blue sm:text-lg">
            <a href={`/deals/${deal.slug}`}>{deal.title}</a>
          </h3>
          <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-gray-500 sm:text-sm">{deal.short_description}</p>
        </div>
        <strong class="shrink-0 self-start border-b border-brand-blue px-1 py-1 text-sm text-brand-blue">
          {deal.discount_value}
        </strong>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <div class="flex flex-wrap items-center gap-3 text-[11px] text-gray-500">
          {deal.bank_details && (
            <a href={`/banks/${deal.bank_details.bank_id}`} class="flex items-center gap-1.5 hover:text-brand-blue">
              <Icon name="card" class="h-3.5 w-3.5" />
              {deal.bank_details.bank_id.toUpperCase()} {deal.bank_details.cashback_percent}% extra
            </a>
          )}
          {deal.cities && deal.cities.length > 0 && (
            <span class="flex items-center gap-1.5">
              <Icon name="location" class="h-3.5 w-3.5" />
              {deal.cities.slice(0, 2).join(', ')}{deal.cities.length > 2 ? ` +${deal.cities.length - 2}` : ''}
            </span>
          )}
        </div>

        <div class="flex items-center gap-2">
          {deal.promo_code && (
            <button
              type="button"
              class="copy-code-btn border border-base-700 bg-base-950 px-3 py-2 text-xs font-bold text-brand-blue hover:bg-base-900"
              data-code={deal.promo_code}
            >
              {deal.promo_code}
            </button>
          )}
          <a
            href={`/deals/${deal.slug}`}
            class="flex items-center gap-1.5 bg-brand-blue px-3 py-2 text-xs font-bold text-black hover:opacity-90"
          >
            View deal
            <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
