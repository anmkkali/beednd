---
interface Props {
  deal: {
    id: string;
    slug: string;
    title: string;
    short_description: string;
    brand_id: string;
    category: string;
    deal_type: string;
    discount_value: string;
    promo_code?: string;
    start_date: string;
    end_date?: string | null;
    last_verified_at: string;
    affiliate_url: string;
    is_featured?: boolean;
    is_sponsored?: boolean;
    cities?: string[];
    bank_details?: {
      bank_id: string;
      eligible_cards: string[];
      cashback_percent?: number;
    };
  };
  brandName?: string;
  brandLogo?: string;
}

const { deal, brandName = deal.brand_id, brandLogo } = Astro.props;

// Determine badge color
const typeBadgeColor = {
  'promo-code': 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30',
  'bank-card': 'bg-purple-500/10 text-purple-400 border-purple-500/30',
  'store-sale': 'bg-rose-500/10 text-rose-400 border-rose-500/30',
  'in-store': 'bg-cyan-500/10 text-cyan-400 border-cyan-500/30',
  'online': 'bg-blue-500/10 text-blue-400 border-blue-500/30',
  'campaign-stunt': 'bg-amber-500/10 text-amber-400 border-amber-500/30'
}[deal.deal_type] || 'bg-gray-500/10 text-gray-400 border-gray-500/30';

const formattedType = deal.deal_type.replace('-', ' ').toUpperCase();
---

<article 
  class:list={[
    "relative rounded-xl border p-4 sm:p-5 transition-all duration-150 hover:-translate-y-0.5 group",
    deal.is_sponsored 
      ? "bg-gradient-to-r from-base-900 to-base-900/90 border-brand-gold/40 shadow-lg shadow-brand-gold/5" 
      : "bg-base-900/80 border-base-700/70 hover:border-brand-blue/50 hover:bg-base-900"
  ]}
  data-deal-id={deal.id}
  data-bank-id={deal.bank_details?.bank_id || ''}
  data-card-types={JSON.stringify(deal.bank_details?.eligible_cards || [])}
  data-category={deal.category}
>
  <!-- Top Row: Brand, Badges, Verification -->
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2 text-xs">
    <div class="flex items-center space-x-2.5">
      <!-- Brand Logo / Favicon -->
      <div class="w-7 h-7 rounded-lg bg-base-800 border border-base-700 p-1 flex items-center justify-center shrink-0">
        <img 
          src={brandLogo || `https://www.google.com/s2/favicons?domain=${deal.brand_id}.com&sz=64`} 
          alt={`${brandName} logo`}
          class="w-full h-full object-contain"
          loading="lazy"
          width="24"
          height="24"
        />
      </div>
      <a href={`/brands/${deal.brand_id}`} class="font-bold text-gray-200 hover:text-brand-blue transition-colors">
        {brandName.toUpperCase()}
      </a>
      
      <!-- Type Badge -->
      <span class={`text-[10px] font-semibold uppercase tracking-wider px-2 py-0.5 rounded-full border ${typeBadgeColor}`}>
        {formattedType}
      </span>

      {deal.is_sponsored && (
        <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-full bg-brand-gold/20 text-brand-gold border border-brand-gold/40">
          SPONSORED
        </span>
      )}
    </div>

    <!-- Verified & Freshness Metadata -->
    <div class="flex items-center space-x-2 text-[11px] text-gray-400">
      <span class="flex items-center text-emerald-400 font-medium">
        <svg class="w-3.5 h-3.5 mr-1" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        Verified
      </span>
      <span>•</span>
      <span class="text-gray-500">Updated today</span>
    </div>
  </div>

  <!-- Headline & Discount Callout -->
  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 mb-2">
    <h3 class="text-base sm:text-lg font-bold text-white group-hover:text-brand-blue transition-colors leading-snug">
      <a href={`/deals/${deal.slug}`}>
        {deal.title}
      </a>
    </h3>
    
    <div class="shrink-0 self-start sm:self-auto">
      <span class="inline-block bg-brand-blue/15 text-brand-blue border border-brand-blue/30 text-xs sm:text-sm font-black px-2.5 py-1 rounded-md tracking-tight">
        {deal.discount_value}
      </span>
    </div>
  </div>

  <!-- Short Description -->
  <p class="text-xs sm:text-sm text-gray-400 mb-4 line-clamp-2 leading-relaxed">
    {deal.short_description}
  </p>

  <!-- Bottom Row: Metadata Chips + Interactive CTA -->
  <div class="flex flex-wrap items-center justify-between gap-3 pt-3 border-t border-base-800">
    <!-- Left Chips (Bank & City) -->
    <div class="flex flex-wrap items-center gap-1.5 text-[11px]">
      {deal.bank_details && (
        <a 
          href={`/banks/${deal.bank_details.bank_id}`}
          class="flex items-center bg-brand-purple/10 text-brand-purple border border-brand-purple/30 px-2 py-0.5 rounded hover:bg-brand-purple/20 transition-colors font-medium"
        >
          💳 {deal.bank_details.bank_id.toUpperCase()} Extra {deal.bank_details.cashback_percent}%
        </a>
      )}

      {deal.cities && deal.cities.length > 0 && (
        <span class="flex items-center bg-base-800 text-gray-300 border border-base-700 px-2 py-0.5 rounded font-mono">
          📍 {deal.cities.slice(0, 2).join(', ')}{deal.cities.length > 2 ? ` +${deal.cities.length - 2}` : ''}
        </span>
      )}
    </div>

    <!-- Right Actions: Promo Code Button + Claim Button -->
    <div class="flex items-center space-x-2 shrink-0">
      {deal.promo_code ? (
        <button
          type="button"
          class="copy-code-btn flex items-center space-x-1.5 bg-base-800 hover:bg-base-700 text-emerald-400 border border-emerald-500/40 text-xs font-mono font-bold px-3 py-1.5 rounded-lg transition-all"
          data-code={deal.promo_code}
          data-outbound={deal.affiliate_url}
        >
          <span>CODE: {deal.promo_code}</span>
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
          </svg>
        </button>
      ) : null}

      <a
        href={`/go/${deal.slug}`}
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        class="flex items-center space-x-1 text-xs font-bold bg-white text-base-950 px-3.5 py-1.5 rounded-lg hover:bg-brand-blue hover:text-base-950 transition-colors shadow-sm"
      >
        <span>Claim</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</article>
