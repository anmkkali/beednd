---
import Icon from '../common/Icon.astro';
import BrandMark from '../common/BrandMark.astro';

interface Props {
  deal: {
    id: string;
    slug: string;
    title: string;
    short_description: string;
    brand_id: string;
    country?: string;
    category: string;
    deal_type: string;
    discount_value: string;
    promo_code?: string;
    affiliate_url: string;
    cities?: string[];
    tags?: string[];
    bank_details?: {
      bank_id: string;
      eligible_cards: string[];
      cashback_percent?: number;
    };
  };
  brandName?: string;
  brandLogo?: string;
}

const { deal, brandName = deal.brand_id, brandLogo } = Astro.props;
const formattedType = deal.deal_type.replaceAll('-', ' ');
const searchTags = [
  ...(deal.tags || []),
  deal.brand_id,
  brandName,
  deal.title,
  deal.short_description,
].join(' ').toLowerCase();
---

<article
  class="group border-b editorial-rule py-6 transition-colors first:border-t hover:bg-base-900/45 px-2 sm:px-4"
  data-deal-id={deal.id}
  data-market={deal.country || 'GLOBAL'}
  data-category={deal.category}
  data-tags={searchTags}
>
  <div class="flex items-start gap-4 sm:gap-5">
    <a href={`/brands/${deal.brand_id}`} aria-label={`${brandName} deals`}>
      <BrandMark name={brandName} logoUrl={brandLogo} size="md" />
    </a>

    <div class="min-w-0 flex-1">
      <!-- Top Meta Line -->
      <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <div class="flex flex-wrap items-center gap-2 text-[13px] text-ink-muted">
          <a href={`/brands/${deal.brand_id}`} class="font-semibold uppercase tracking-[0.1em] text-ink hover:underline">
            {brandName}
          </a>
          <span>·</span>
          <span class="capitalize">{formattedType}</span>
          {deal.country && deal.country !== 'GLOBAL' && (
            <>
              <span>·</span>
              <span>{deal.country === 'PK' ? 'Pakistan' : deal.country === 'US' ? 'USA' : deal.country}</span>
            </>
          )}
        </div>

        <span class="editorial-pill px-3.5 py-1 text-[13px] font-semibold tracking-wide text-ink">
          {deal.discount_value}
        </span>
      </div>

      <!-- Editorial Serif Deal Title & Readable Description -->
      <h3 class="text-2xl sm:text-[28px] leading-[1.15] text-ink">
        <a href={`/deals/${deal.slug}`} class="hover:underline decoration-1 underline-offset-4">
          {deal.title}
        </a>
      </h3>

      <p class="mt-2 max-w-3xl text-[15px] leading-relaxed text-ink-muted">
        {deal.short_description}
      </p>

      <!-- Bottom Meta & Minimal Single-Color Actions -->
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 pt-2">
        <div class="flex flex-wrap items-center gap-4 text-[13.5px] text-ink-muted">
          {deal.bank_details && (
            <a href={`/banks/${deal.bank_details.bank_id}`} class="inline-flex items-center gap-1.5 text-ink hover:underline">
              <Icon name="card" class="h-4 w-4" />
              <span>{deal.bank_details.bank_id.toUpperCase()} +{deal.bank_details.cashback_percent}% off</span>
            </a>
          )}
          {deal.cities && deal.cities.length > 0 && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="location" class="h-4 w-4" />
              <span>{deal.cities.slice(0, 3).join(', ')}{deal.cities.length > 3 ? ` +${deal.cities.length - 3}` : ''}</span>
            </span>
          )}
        </div>

        <div class="flex items-center gap-2.5">
          {deal.promo_code && (
            <button
              type="button"
              class="copy-code-btn btn-outline inline-flex items-center gap-2 px-3.5 py-2 text-[13px] font-semibold tracking-wider"
              data-code={deal.promo_code}
            >
              <span>{deal.promo_code}</span>
            </button>
          )}
          <a
            href={`/deals/${deal.slug}`}
            class="btn-primary inline-flex items-center gap-2 px-4 py-2 text-[13px] font-semibold"
          >
            <span>View Offer</span>
            <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</article>
