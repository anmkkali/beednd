---
import { getCollection } from 'astro:content';
import Icon from '../common/Icon.astro';
import BrandMark from '../common/BrandMark.astro';
import { dealKind, dealTokens, expiryLabel, shortDate } from '../../lib/deals';

interface Props {
  deal: {
    id: string;
    slug: string;
    title: string;
    short_description: string;
    brand_id: string;
    country?: string;
    category: string;
    deal_type: string;
    discount_value: string;
    badge_text?: string;
    applies_to?: string;
    is_sponsored?: boolean;
    promo_code?: string;
    affiliate_url: string;
    cities?: string[];
    tags?: string[];
    channels?: string[];
    start_date: string;
    end_date?: string | null;
    last_verified_at: string;
    is_trending?: boolean;
    is_coming_soon?: boolean;
    limited_time?: boolean;
    offer_kind?: string;
    bank_details?: {
      bank_id: string;
      eligible_cards: string[];
      cashback_percent?: number;
    };
  };
  brandName?: string;
  brandLogo?: string;
}

const { deal, brandName = deal.brand_id, brandLogo } = Astro.props;
const activeDeals = await getCollection('deals', ({ data }) => data.status === 'active');
const brandDealCount = activeDeals.filter((d) => d.data.brand_id === deal.brand_id).length;
const allBanks = deal.bank_details ? await getCollection('banks') : [];
const bank = allBanks.find((b) => b.data.id === deal.bank_details?.bank_id);

const kind = dealKind(deal);
const tagLabel =
  { discount: 'Discounts', trial: 'Trials', free: 'Free', promo: 'Promo Codes', voucher: 'Vouchers', credits: 'Credits' }[kind] || 'Deals';
// Where the offer works. Not shown for AI tools, which are always online.
const channelSet = new Set(
  deal.channels && deal.channels.length
    ? deal.channels
    : deal.deal_type === 'online' ? ['online'] : deal.deal_type === 'in-store' ? ['in-store'] : []
);
const channelLabel =
  deal.category === 'ai-tools' || channelSet.size === 0
    ? ''
    : channelSet.size === 2 ? 'In-store + Online' : channelSet.has('in-store') ? 'In-store' : 'Online';
const expiry = expiryLabel(deal.end_date, !!deal.limited_time);
---

<article
  data-page-item
  class="group border-b editorial-rule px-2 py-3 transition-colors hover:bg-base-900/45 sm:px-4 sm:py-3.5"
  data-deal-id={deal.id}
  data-market={deal.country || 'GLOBAL'}
  data-kind={kind}
  data-category={deal.category}
  data-tokens={dealTokens(deal)}
>
  <!-- Mobile layout (< 640px) — Compact, neat, zero vertical stretching or text squishing -->
  <div class="flex flex-col gap-2 sm:hidden">
    <!-- Top row: Brand info on left, Badge on right -->
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2 min-w-0">
        <a href={`/brands/${deal.brand_id}`} aria-label={`${brandName} deals`} class="shrink-0">
          <BrandMark name={brandName} logoUrl={brandLogo} size="sm" />
        </a>
        <div class="flex items-center gap-1.5 min-w-0 text-[12px]">
          <a href={`/brands/${deal.brand_id}`} class="font-bold text-ink truncate">{brandName}</a>
          {channelLabel && (
            <span class="border editorial-rule px-1 py-0.2 text-[9.5px] font-medium text-ink shrink-0">{channelLabel}</span>
          )}
        </div>
      </div>
      <span class:list={['editorial-pill shrink-0 whitespace-nowrap px-2 py-0.5 text-right text-[11px] font-semibold leading-tight text-ink', deal.is_coming_soon && 'border-ink/40 bg-base-900']}>
        {deal.is_coming_soon ? (
          <span data-i18n="coming_soon">Discount Coming Soon</span>
        ) : (
          deal.badge_text || deal.discount_value
        )}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-[14.5px] font-semibold leading-snug text-ink">
      <a href={`/deals/${deal.slug}`} class="underline-offset-2 hover:underline line-clamp-2">{deal.title}</a>
    </h3>

    <!-- Description (compact) -->
    <p class="line-clamp-2 text-[12px] leading-relaxed text-ink-muted">{deal.short_description}</p>

    <!-- Bottom row: Chips/Timer on left, View offer on right -->
    <div class="flex items-center justify-between gap-2 pt-0.5">
      <div class="flex items-center gap-1.5 text-[11px] text-ink-muted truncate">
        {deal.is_coming_soon ? (
          <span class="inline-flex items-center gap-1.5 font-medium text-ink">
            <span class="inline-flex items-center gap-1">
              <Icon name="calendar" class="h-3 w-3 shrink-0" />
              <span><span data-i18n="starts">Starts</span> {shortDate(deal.start_date)}</span>
            </span>
            <span data-countdown={deal.start_date} class="inline-flex items-center gap-1 rounded-full border editorial-rule bg-base-900/60 px-1.5 py-0.5 text-[10px] font-mono font-semibold text-ink">
              <Icon name="clock" class="h-2.5 w-2.5 shrink-0" />
              <span data-countdown-text>--d --h</span>
            </span>
          </span>
        ) : deal.bank_details ? (
          <span class="inline-flex items-center gap-1 text-ink truncate">
            <Icon name="card" class="h-3 w-3 shrink-0" />
            <span class="truncate">{deal.bank_details.bank_id.toUpperCase()} +{deal.bank_details.cashback_percent}%</span>
          </span>
        ) : deal.cities && deal.cities.length > 0 ? (
          <span class="inline-flex items-center gap-1 truncate">
            <Icon name="location" class="h-3 w-3 shrink-0" />
            <span class="truncate">{deal.cities[0]}{deal.cities.length > 1 ? ` +${deal.cities.length - 1}` : ''}</span>
          </span>
        ) : (
          <span class="inline-flex items-center gap-1">
            <Icon name="calendar" class="h-3 w-3 shrink-0" />
            <span>{shortDate(deal.last_verified_at)}</span>
          </span>
        )}
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        {deal.promo_code && (
          <button type="button" class="copy-code-btn btn-outline px-2 py-0.5 text-[11px] font-mono font-semibold" data-code={deal.promo_code}>
            {deal.promo_code}
          </button>
        )}
        <a href={`/deals/${deal.slug}`} class="btn-primary inline-flex items-center gap-1 whitespace-nowrap px-2.5 py-1 text-[11.5px] font-semibold">
          <span data-i18n="view_offer">View offer</span>
          <Icon name="arrow" class="h-2.5 w-2.5" />
        </a>
      </div>
    </div>
  </div>

  <!-- Desktop layout (sm:flex) — 3-column perfected layout -->
  <div class="hidden sm:flex items-stretch gap-4">
    <div class="flex w-11 shrink-0 flex-col items-center gap-1.5 self-start">
      <a href={`/brands/${deal.brand_id}`} aria-label={`${brandName} deals`}>
        <BrandMark name={brandName} logoUrl={brandLogo} size="sm" />
      </a>
      {bank && (
        <>
          <span class="text-[10px] leading-none text-ink-muted" aria-hidden="true">x</span>
          <a href={`/banks/${bank.data.short_code}`} aria-label={`${bank.data.name} offers`}>
            <BrandMark name={bank.data.name} logoUrl={bank.data.logo_url} size="sm" />
          </a>
        </>
      )}
      {brandDealCount > 1 && (
        <a href={`/brands/${deal.brand_id}`} class="editorial-pill hidden whitespace-nowrap px-1.5 py-0.2 text-[10px] font-semibold text-ink-muted hover:text-ink sm:inline-block">
          +{brandDealCount - 1}
        </a>
      )}
    </div>

    <!-- Col 2: Main content -->
    <div class="min-w-0 flex-1">
      <!-- Meta line: brand, tag, status icons -->
      <div class="mb-1 flex flex-wrap items-center gap-x-2.5 gap-y-0.5 text-[12px] text-ink-muted">
        <a href={`/brands/${deal.brand_id}`} class="font-bold text-ink hover:underline">{brandName}</a>
        {deal.is_sponsored && <span class="border border-ink px-1.5 py-0.2 text-[9.5px] font-semibold uppercase tracking-[0.1em] text-ink">Sponsored</span>}
        <span
          data-new-badge
          data-since={deal.last_verified_at}
          class="editorial-pill hidden px-1.5 py-0.2 text-[10.5px] font-semibold text-ink"
        >New</span>
        {channelLabel && (
          <span class="border editorial-rule px-1.5 py-0.2 text-[10.5px] font-medium text-ink">{channelLabel}</span>
        )}
        <span class="inline-flex items-center gap-1">
          <Icon name="calendar" class="h-3 w-3" />
          {deal.is_coming_soon ? (
            <span><span data-i18n="starts">Starts</span> {shortDate(deal.start_date)}</span>
          ) : (
            shortDate(deal.last_verified_at)
          )}
        </span>
        {deal.is_coming_soon && (
          <span data-countdown={deal.start_date} class="inline-flex items-center gap-1 rounded-full border editorial-rule bg-base-900/60 px-2 py-0.2 text-[10.5px] font-mono font-semibold text-ink">
            <Icon name="clock" class="h-3 w-3" />
            <span data-countdown-text>--d --h</span>
          </span>
        )}
        {deal.is_trending && (
          <span class="inline-flex items-center gap-1 font-semibold text-ink">
            <Icon name="trending" class="h-3 w-3" />
            Trending
          </span>
        )}
        <span
          data-expiry
          data-end={deal.end_date || ''}
          data-limited={deal.limited_time ? 'true' : 'false'}
          class:list={['inline-flex items-center gap-1 font-semibold text-ink', !expiry.label && 'hidden']}
        >
          <Icon name="clock" class="h-3 w-3" />
          <span data-expiry-text>{expiry.label}</span>
        </span>
        {deal.country && deal.country !== 'GLOBAL' && <span class="font-medium text-ink-muted">{deal.country}</span>}
        {(deal.tags || []).includes('all-items') && (
          <span class="border editorial-rule px-1.5 py-0.2 text-[10.5px] font-medium text-ink">Entire brand</span>
        )}
        {deal.applies_to && !(deal.tags || []).includes('all-items') && (
          <span class="border editorial-rule px-1.5 py-0.2 text-[10.5px] font-medium text-ink">On: {deal.applies_to}</span>
        )}
      </div>

      <!-- Title -->
      <h3 class="text-[18px] font-semibold leading-snug text-ink">
        <a href={`/deals/${deal.slug}`} class="underline-offset-2 hover:underline">{deal.title}</a>
      </h3>

      <p class="mt-1 line-clamp-2 max-w-3xl text-[13.5px] leading-relaxed text-ink-muted">{deal.short_description}</p>

      <!-- Location/bank chips (only rendered if present) -->
      {(deal.bank_details || (deal.cities && deal.cities.length > 0)) && (
        <div class="mt-2 flex flex-wrap items-center gap-3 text-[12px] text-ink-muted">
          {deal.bank_details && (
            <a href={`/banks/${deal.bank_details.bank_id}`} class="inline-flex items-center gap-1 text-ink hover:underline">
              <Icon name="card" class="h-3.5 w-3.5" />
              {deal.bank_details.bank_id.toUpperCase()} +{deal.bank_details.cashback_percent}% off
            </a>
          )}
          {deal.cities && deal.cities.length > 0 && (
            <span class="inline-flex items-center gap-1">
              <Icon name="location" class="h-3.5 w-3.5" />
              {deal.cities.slice(0, 3).join(', ')}{deal.cities.length > 3 ? ` +${deal.cities.length - 3}` : ''}
            </span>
          )}
        </div>
      )}
    </div>

    <!-- Col 3: Right action column — badge at top, View offer & promo code at bottom -->
    <div class="flex shrink-0 flex-col justify-between items-end self-stretch gap-2 min-w-[8.5rem]">
      <span class:list={['editorial-pill whitespace-nowrap px-2.5 py-0.5 text-right text-[12px] font-semibold leading-tight text-ink', deal.is_coming_soon && 'border-ink/40 bg-base-900']}>
        {deal.is_coming_soon ? (
          <span data-i18n="coming_soon">Discount Coming Soon</span>
        ) : (
          deal.badge_text || deal.discount_value
        )}
      </span>
      <div class="mt-auto flex flex-wrap items-center justify-end gap-2">
        {deal.promo_code && (
          <button type="button" class="copy-code-btn btn-outline px-2.5 py-1 text-[11.5px] font-mono font-semibold tracking-wider" data-code={deal.promo_code}>
            {deal.promo_code}
          </button>
        )}
        <a href={`/deals/${deal.slug}`} class="btn-primary inline-flex items-center gap-1.5 whitespace-nowrap px-3 py-1.5 text-[12px] font-semibold">
          <span data-i18n="view_offer">View offer</span>
          <Icon name="arrow" class="h-3 w-3" />
        </a>
      </div>
    </div>
  </div>
</article>

<script>
  // Badges that depend on today's date are resolved in the browser, so they stay correct between builds.
  const DAY = 86_400_000;
  const now = Date.now();

  document.querySelectorAll<HTMLElement>('[data-new-badge]').forEach((badge) => {
    const since = Date.parse(badge.dataset.since || '');
    if (!Number.isNaN(since) && now - since >= 0 && now - since <= 14 * DAY) badge.classList.remove('hidden');
  });

  document.querySelectorAll<HTMLElement>('[data-expiry]').forEach((el) => {
    const end = el.dataset.end ? Date.parse(el.dataset.end) : NaN;
    const limited = el.dataset.limited === 'true';
    let label = '';
    if (!Number.isNaN(end)) {
      const days = Math.ceil((end - now) / DAY);
      if (days < 0) label = 'Expired';
      else if (days <= 30) label = days === 0 ? 'Expires today' : `Expires in ${days}d`;
    }
    if (!label && limited) label = 'Limited time';
    const text = el.querySelector('[data-expiry-text]');
    if (text) text.textContent = label;
    el.classList.toggle('hidden', !label);
  });

  // Live countdown timer for upcoming ("Discount Coming Soon") deals
  function updateCountdowns() {
    const t = Date.now();
    document.querySelectorAll<HTMLElement>('[data-countdown]').forEach((el) => {
      const target = Date.parse(el.dataset.countdown || '');
      const textEl = el.querySelector('[data-countdown-text]');
      if (!textEl || Number.isNaN(target)) return;
      const diff = target - t;
      if (diff <= 0) {
        textEl.textContent = 'Live now';
        return;
      }
      const d = Math.floor(diff / 86_400_000);
      const h = Math.floor((diff % 86_400_000) / 3_600_000);
      const m = Math.floor((diff % 3_600_000) / 60_000);
      textEl.textContent = d > 0 ? `${d}d ${h}h ${m}m` : `${h}h ${m}m`;
    });
  }
  updateCountdowns();
  if (document.querySelector('[data-countdown]')) {
    setInterval(updateCountdowns, 60_000);
  }
</script>
