---
import { getCollection } from 'astro:content';
import Icon from '../common/Icon.astro';
import BrandMark from '../common/BrandMark.astro';
import { dealKind, dealTokens, expiryLabel, shortDate } from '../../lib/deals';

interface Props {
  deal: {
    id: string;
    slug: string;
    title: string;
    short_description: string;
    brand_id: string;
    country?: string;
    category: string;
    deal_type: string;
    discount_value: string;
    badge_text?: string;
    applies_to?: string;
    is_sponsored?: boolean;
    promo_code?: string;
    affiliate_url: string;
    cities?: string[];
    tags?: string[];
    channels?: string[];
    start_date: string;
    end_date?: string | null;
    last_verified_at: string;
    is_trending?: boolean;
    limited_time?: boolean;
    offer_kind?: string;
    bank_details?: {
      bank_id: string;
      eligible_cards: string[];
      cashback_percent?: number;
    };
  };
  brandName?: string;
  brandLogo?: string;
}

const { deal, brandName = deal.brand_id, brandLogo } = Astro.props;
const activeDeals = await getCollection('deals', ({ data }) => data.status === 'active');
const brandDealCount = activeDeals.filter((d) => d.data.brand_id === deal.brand_id).length;
const allBanks = deal.bank_details ? await getCollection('banks') : [];
const bank = allBanks.find((b) => b.data.id === deal.bank_details?.bank_id);

const kind = dealKind(deal);
const tagLabel =
  { discount: 'Discounts', trial: 'Trials', free: 'Free', promo: 'Promo Codes', voucher: 'Vouchers', credits: 'Credits' }[kind] || 'Deals';
// Where the offer works. Not shown for AI tools, which are always online.
const channelSet = new Set(
  deal.channels && deal.channels.length
    ? deal.channels
    : deal.deal_type === 'online' ? ['online'] : deal.deal_type === 'in-store' ? ['in-store'] : []
);
const channelLabel =
  deal.category === 'ai-tools' || channelSet.size === 0
    ? ''
    : channelSet.size === 2 ? 'In-store + Online' : channelSet.has('in-store') ? 'In-store' : 'Online';
const expiry = expiryLabel(deal.end_date, !!deal.limited_time);
---

<article
  data-page-item
  class="group border-b editorial-rule px-1 py-4 transition-colors hover:bg-base-900/45 sm:px-4 sm:py-6"
  data-deal-id={deal.id}
  data-market={deal.country || 'GLOBAL'}
  data-kind={kind}
  data-tokens={dealTokens(deal)}
>
  <div class="flex items-start gap-3 sm:gap-5">
    <div class="flex w-10 shrink-0 flex-col items-center gap-1.5 sm:w-14 sm:gap-2">
      <a href={`/brands/${deal.brand_id}`} aria-label={`${brandName} deals`}>
        <BrandMark name={brandName} logoUrl={brandLogo} size="md" />
      </a>
      {bank && (
        <>
          <span class="text-[12px] leading-none text-ink-muted" aria-hidden="true">x</span>
          <a href={`/banks/${bank.data.short_code}`} aria-label={`${bank.data.name} offers`}>
            <BrandMark name={bank.data.name} logoUrl={bank.data.logo_url} size="sm" />
          </a>
        </>
      )}
      {brandDealCount > 1 && (
        <a href={`/brands/${deal.brand_id}`} class="editorial-pill hidden whitespace-nowrap px-2 py-0.5 text-[11.5px] font-semibold text-ink-muted hover:text-ink sm:inline-block">
          +{brandDealCount - 1} more
        </a>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <!-- Meta line: brand, tag, status icons -->
      <div class="mb-1.5 flex flex-wrap items-center gap-x-2.5 gap-y-1 text-[12px] text-ink-muted sm:mb-2 sm:gap-x-3 sm:gap-y-1.5 sm:text-[13px]">
        <a href={`/brands/${deal.brand_id}`} class="font-bold text-ink hover:underline">{brandName}</a>
        {deal.is_sponsored && <span class="border border-ink px-2 py-0.5 text-[10.5px] font-semibold uppercase tracking-[0.12em] text-ink">Sponsored</span>}
        <span class="font-semibold">#{tagLabel}</span>
        <span
          data-new-badge
          data-since={deal.last_verified_at}
          class="editorial-pill hidden px-2 py-0.5 text-[11.5px] font-semibold text-ink"
        >New</span>
        {channelLabel && (
          <span class="border editorial-rule px-2 py-0.5 text-[11.5px] font-semibold text-ink">{channelLabel}</span>
        )}
        <span class="inline-flex items-center gap-1">
          <Icon name="calendar" class="h-3.5 w-3.5" />
          {shortDate(deal.last_verified_at)}
        </span>
        {deal.is_trending && (
          <span class="inline-flex items-center gap-1 font-semibold text-ink">
            <Icon name="trending" class="h-3.5 w-3.5" />
            Trending
          </span>
        )}
        <span
          data-expiry
          data-end={deal.end_date || ''}
          data-limited={deal.limited_time ? 'true' : 'false'}
          class:list={['inline-flex items-center gap-1 font-semibold text-ink', !expiry.label && 'hidden']}
        >
          <Icon name="clock" class="h-3.5 w-3.5" />
          <span data-expiry-text>{expiry.label}</span>
        </span>
        {deal.country && deal.country !== 'GLOBAL' && <span class="font-medium">{deal.country}</span>}
        {(deal.tags || []).includes('all-items') && (
          <span class="border editorial-rule px-2 py-0.5 text-[11.5px] font-semibold text-ink">Entire brand</span>
        )}
        {deal.applies_to && !(deal.tags || []).includes('all-items') && (
          <span class="border editorial-rule px-2 py-0.5 text-[11.5px] font-semibold text-ink">On: {deal.applies_to}</span>
        )}
      </div>

      <!-- Title with summary pill on the right -->
      <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start sm:gap-5">
        <h3 class="text-[21px] leading-[1.15] text-ink sm:text-[28px]">
          <a href={`/deals/${deal.slug}`} class="underline-offset-4 hover:underline">{deal.title}</a>
        </h3>
        <span class="editorial-pill max-w-[16rem] shrink-0 self-start px-3 py-1 text-[12.5px] font-semibold leading-snug text-ink sm:px-3.5 sm:py-1.5 sm:text-[13px] sm:text-right">
          {deal.badge_text || deal.discount_value}
        </span>
      </div>

      <p class="mt-1.5 line-clamp-2 max-w-3xl text-[14px] leading-relaxed text-ink-muted sm:mt-2 sm:line-clamp-none sm:text-[15px]">{deal.short_description}</p>

      <div class="mt-3 flex flex-wrap items-center justify-between gap-2 sm:mt-4 sm:gap-3">
        <div class="flex flex-wrap items-center gap-4 text-[13.5px] text-ink-muted">
          {deal.bank_details && (
            <a href={`/banks/${deal.bank_details.bank_id}`} class="inline-flex items-center gap-1.5 text-ink hover:underline">
              <Icon name="card" class="h-4 w-4" />
              {deal.bank_details.bank_id.toUpperCase()} +{deal.bank_details.cashback_percent}% off
            </a>
          )}
          {deal.cities && deal.cities.length > 0 && (
            <span class="inline-flex items-center gap-1.5">
              <Icon name="location" class="h-4 w-4" />
              {deal.cities.slice(0, 3).join(', ')}{deal.cities.length > 3 ? ` +${deal.cities.length - 3}` : ''}
            </span>
          )}
        </div>

        <div class="flex w-full items-center gap-2.5 sm:w-auto">
          {deal.promo_code && (
            <button type="button" class="copy-code-btn btn-outline flex-1 px-3.5 py-2.5 text-[13px] font-semibold tracking-wider sm:flex-none sm:py-2" data-code={deal.promo_code}>
              {deal.promo_code}
            </button>
          )}
          <a href={`/deals/${deal.slug}`} class="btn-primary inline-flex flex-1 items-center justify-center gap-2 px-4 py-2.5 text-[13px] font-semibold sm:flex-none sm:py-2">
            View offer
            <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </div>
  </div>
</article>

<script>
  // Badges that depend on today's date are resolved in the browser, so they stay correct between builds.
  const DAY = 86_400_000;
  const now = Date.now();

  document.querySelectorAll<HTMLElement>('[data-new-badge]').forEach((badge) => {
    const since = Date.parse(badge.dataset.since || '');
    if (!Number.isNaN(since) && now - since >= 0 && now - since <= 14 * DAY) badge.classList.remove('hidden');
  });

  document.querySelectorAll<HTMLElement>('[data-expiry]').forEach((el) => {
    const end = el.dataset.end ? Date.parse(el.dataset.end) : NaN;
    const limited = el.dataset.limited === 'true';
    let label = '';
    if (!Number.isNaN(end)) {
      const days = Math.ceil((end - now) / DAY);
      if (days < 0) label = 'Expired';
      else if (days <= 30) label = days === 0 ? 'Expires today' : `Expires in ${days}d`;
    }
    if (!label && limited) label = 'Limited time';
    const text = el.querySelector('[data-expiry-text]');
    if (text) text.textContent = label;
    el.classList.toggle('hidden', !label);
  });
</script>
