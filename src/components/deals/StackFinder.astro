---
import Icon from '../common/Icon.astro';

interface Props {
  baseSalePercent?: number;
  bankCashbackPercent?: number;
  promoCodePercent?: number;
}

const { baseSalePercent = 40, bankCashbackPercent = 15, promoCodePercent = 0 } = Astro.props;
const combined = Math.round(
  (1 - (1 - baseSalePercent / 100) * (1 - bankCashbackPercent / 100) * (1 - promoCodePercent / 100)) * 100
);
---

<div class="my-6 border-t border-b editorial-rule py-5">
  <div class="mb-4 flex items-center justify-between">
    <div class="flex items-center gap-2 text-[15px] font-semibold text-ink">
      <Icon name="card" class="h-4 w-4" />
      <span>Combined Card & Sale Breakdown</span>
    </div>
    <span class="editorial-pill px-3 py-0.5 text-[12.5px] font-semibold text-ink">
      Net ~{combined}% Off
    </span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 divide-x editorial-rule border editorial-rule text-center">
    <div class="p-3.5">
      <div class="text-[12.5px] text-ink-muted">Store Markdown</div>
      <div class="mt-1 font-serif text-2xl text-ink">-{baseSalePercent}%</div>
    </div>
    <div class="p-3.5">
      <div class="text-[12.5px] text-ink-muted">Bank Card Extra</div>
      <div class="mt-1 font-serif text-2xl text-ink">-{bankCashbackPercent}%</div>
    </div>
    <div class="col-span-2 sm:col-span-1 border-t sm:border-t-0 editorial-rule p-3.5">
      <div class="text-[12.5px] text-ink-muted">Estimated Total</div>
      <div class="mt-1 font-serif text-2xl font-semibold text-ink">~{combined}% Off</div>
    </div>
  </div>
</div>
