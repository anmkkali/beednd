---
import { getCollection } from 'astro:content';
import Icon from '../common/Icon.astro';
import BrandMark from '../common/BrandMark.astro';
import { categories } from '../../data/taxonomy';

const deals = await getCollection('deals', ({ data }) => data.status === 'active');
const brands = await getCollection('brands');
const posts = await getCollection('blog', ({ data }) => data.is_published);
---

<div id="search-modal" class="fixed inset-0 z-[70] hidden items-start justify-center bg-black/55 p-4 pt-[7vh]">
  <div class="w-full max-w-2xl overflow-hidden border editorial-rule-strong bg-base-950 shadow-2xl">
    <div class="flex items-center gap-3 border-b editorial-rule px-5 py-4">
      <Icon name="search" class="h-5 w-5 shrink-0 text-ink" />
      <input
        type="search"
        id="pagefind-input"
        placeholder="Search brands, deals, categories"
        class="w-full bg-transparent text-[16px] text-ink placeholder:text-ink-muted focus:outline-none"
        autocomplete="off"
      />
      <button id="close-search-modal-btn" type="button" class="btn-outline px-2.5 py-1 text-[12px] font-semibold">ESC</button>
    </div>

    <div class="flex flex-wrap items-center gap-2 border-b editorial-rule bg-base-900/50 px-5 py-2.5 text-[13px]">
      <span class="font-medium text-ink-muted">Try:</span>
      <button type="button" data-quick-query="trial" class="editorial-pill px-3 py-0.5 text-ink hover:bg-base-800">Free trial</button>
      <button type="button" data-quick-query="video" class="editorial-pill px-3 py-0.5 text-ink hover:bg-base-800">AI video</button>
      <button type="button" data-quick-query="clothing" class="editorial-pill px-3 py-0.5 text-ink hover:bg-base-800">Clothing</button>
      <button type="button" data-quick-query="promo" class="editorial-pill px-3 py-0.5 text-ink hover:bg-base-800">Promo code</button>
    </div>

    <div class="max-h-[62vh] space-y-5 overflow-y-auto p-4">
      <p id="search-empty" class="hidden py-10 text-center text-[15px] text-ink-muted">No matching brands or offers found.</p>

      <div class="search-group">
        <p class="mb-2 px-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Brands</p>
        <div class="divide-y editorial-rule border-y editorial-rule">
          {brands.map((brand) => (
            <a
              href={`/brands/${brand.data.slug}`}
              data-search-item
              data-market={brand.data.country}
              data-search-term={`${brand.data.name} ${brand.data.categories.join(' ')} brand`}
              class="flex items-center justify-between gap-3 px-2 py-2.5 hover:bg-base-900"
            >
              <span class="flex items-center gap-3">
                <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="sm" />
                <span class="text-[15px] font-semibold text-ink">{brand.data.name}</span>
              </span>
              <Icon name="arrow" class="h-4 w-4 text-ink-muted" />
            </a>
          ))}
        </div>
      </div>

      <div class="search-group">
        <p class="mb-2 px-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Deals</p>
        <div class="divide-y editorial-rule border-y editorial-rule">
          {deals.map((deal) => (
            <a
              href={`/deals/${deal.data.slug}`}
              data-search-item
              data-market={deal.data.country}
              data-search-term={`${deal.data.title} ${deal.data.brand_id} ${deal.data.category} ${deal.data.offer_kind || ''} ${deal.data.deal_type} ${deal.data.cities.join(' ')} ${deal.data.tags.join(' ')}`}
              class="flex items-center justify-between gap-4 px-2 py-3 hover:bg-base-900"
            >
              <span class="line-clamp-1 text-[14.5px] font-medium text-ink">{deal.data.title}</span>
              <span class="editorial-pill shrink-0 px-2.5 py-0.5 text-[12.5px] font-semibold text-ink">{deal.data.discount_value}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="search-group">
        <p class="mb-2 px-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Categories</p>
        <div class="grid grid-cols-2 gap-2">
          {categories.map((category) => (
            <a
              href={`/categories/${category.id}`}
              data-search-item
              data-search-term={`${category.name} ${category.groups.map((g) => g.label).join(' ')}`}
              class="flex items-center gap-2.5 border editorial-rule px-3 py-2.5 text-[14px] font-medium text-ink hover:bg-base-900"
            >
              <Icon name={category.icon} class="h-4 w-4 shrink-0" />
              <span class="truncate">{category.name}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="search-group">
        <p class="mb-2 px-2 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Blog</p>
        <div class="divide-y editorial-rule border-y editorial-rule">
          {posts.map((post) => (
            <a
              href={`/blog/${post.slug}`}
              data-search-item
              data-market={post.data.target_country}
              data-search-term={`${post.data.title} ${post.data.tags.join(' ')} blog`}
              class="flex items-center justify-between gap-3 px-2 py-2.5 text-[14.5px] text-ink hover:bg-base-900"
            >
              <span>{post.data.title}</span>
              <Icon name="arrow" class="h-4 w-4 shrink-0 text-ink-muted" />
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const modal = document.getElementById('search-modal');
  const input = document.getElementById('pagefind-input') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-search-item]'));
  const groups = Array.from(document.querySelectorAll<HTMLElement>('.search-group'));
  const emptyMsg = document.getElementById('search-empty');
  const shown = (el: Element) => getComputedStyle(el).display !== 'none';

  function filter() {
    const query = input?.value.trim().toLowerCase() || '';
    items.forEach((item) => {
      const match = !query || (item.dataset.searchTerm || '').toLowerCase().includes(query);
      item.classList.toggle('search-miss', !match);
    });
    let anyVisible = false;
    groups.forEach((group) => {
      const has = Array.from(group.querySelectorAll<HTMLElement>('[data-search-item]')).some(
        (el) => !el.classList.contains('search-miss') && shown(el)
      );
      group.style.display = has ? '' : 'none';
      if (has) anyVisible = true;
    });
    emptyMsg?.classList.toggle('hidden', anyVisible);
  }

  function openSearch() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    filter();
    window.setTimeout(() => input?.focus(), 10);
  }

  function closeSearch() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.querySelectorAll('#header-search-btn, [data-search-open]').forEach((el) => el.addEventListener('click', openSearch));
  document.getElementById('close-search-modal-btn')?.addEventListener('click', closeSearch);
  input?.addEventListener('input', filter);
  modal?.addEventListener('click', (event) => {
    if (event.target === modal) closeSearch();
  });
  document.querySelectorAll<HTMLButtonElement>('[data-quick-query]').forEach((btn) =>
    btn.addEventListener('click', () => {
      if (!input) return;
      input.value = btn.dataset.quickQuery || '';
      filter();
      input.focus();
    })
  );

  window.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openSearch();
    }
    if (event.key === 'Escape') closeSearch();
  });

  // Copy-code buttons used on deal cards and deal pages
  document.addEventListener('click', (event) => {
    const button = (event.target as HTMLElement).closest('.copy-code-btn') as HTMLElement | null;
    if (!button) return;
    const code = button.dataset.code;
    if (!code) return;
    navigator.clipboard?.writeText(code);
    const original = button.textContent;
    button.textContent = 'Copied';
    window.setTimeout(() => (button.textContent = original), 1800);
    if (button.dataset.outbound) window.open(button.dataset.outbound, '_blank', 'noopener,noreferrer');
  });
</script>

<style is:global>
  .search-miss {
    display: none !important;
  }
</style>
