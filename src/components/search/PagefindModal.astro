---
// Pagefind Search Modal Component
---

<div id="search-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-start justify-center pt-20 p-4">
  <div class="bg-base-900 border border-base-700 rounded-2xl max-w-2xl w-full p-4 shadow-2xl relative text-xs">
    <div class="flex items-center space-x-3 border-b border-base-700 pb-3">
      <svg class="w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input 
        type="search" 
        id="pagefind-input"
        placeholder="Type to search deals, brands, banks, categories..."
        class="w-full bg-transparent text-sm text-white placeholder-gray-500 focus:outline-none"
        autofocus
      />
      <button id="close-search-modal-btn" class="text-gray-400 hover:text-white px-2 py-1 rounded">
        ESC
      </button>
    </div>

    <!-- Results Container -->
    <div id="pagefind-results" class="mt-4 max-h-96 overflow-y-auto space-y-2">
      <div class="p-8 text-center text-gray-500">
        Start typing to search deals across Pakistan & US retail brands...
      </div>
    </div>
  </div>
</div>

<script>
  // Search modal keybind listeners (Ctrl+K and ESC)
  const searchModal = document.getElementById('search-modal');
  const searchInput = document.getElementById('pagefind-input') as HTMLInputElement | null;
  const headerSearchBtn = document.getElementById('header-search-btn');
  const closeSearchBtn = document.getElementById('close-search-modal-btn');

  function openSearch() {
    searchModal?.classList.remove('hidden');
    searchModal?.classList.add('flex');
    searchInput?.focus();
  }

  function closeSearch() {
    searchModal?.classList.add('hidden');
    searchModal?.classList.remove('flex');
  }

  headerSearchBtn?.addEventListener('click', openSearch);
  closeSearchBtn?.addEventListener('click', closeSearch);

  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') {
      e.preventDefault();
      openSearch();
    }
    if (e.key === 'Escape' && !searchModal?.classList.contains('hidden')) {
      closeSearch();
    }
  });

  // Client clipboard copy handler for promo codes
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.copy-code-btn') as HTMLElement | null;
    if (target) {
      const code = target.getAttribute('data-code');
      const outbound = target.getAttribute('data-outbound');
      if (code) {
        navigator.clipboard.writeText(code);
        const originalText = target.innerHTML;
        target.innerHTML = `<span class="text-emerald-300 font-bold">✓ COPIED!</span>`;
        setTimeout(() => {
          target.innerHTML = originalText;
        }, 2500);

        if (outbound) {
          window.open(outbound, '_blank', 'noopener,noreferrer');
        }
      }
    }
  });

  // 'My Card' Modal toggles
  const cardModal = document.getElementById('my-card-modal');
  const cardTrigger = document.getElementById('my-card-trigger-btn');
  const closeCardBtn = document.getElementById('close-card-modal-btn');
  const saveCardsBtn = document.getElementById('save-cards-btn');
  const resetCardsBtn = document.getElementById('reset-cards-btn');

  cardTrigger?.addEventListener('click', () => {
    cardModal?.classList.remove('hidden');
    cardModal?.classList.add('flex');
  });

  closeCardBtn?.addEventListener('click', () => {
    cardModal?.classList.add('hidden');
    cardModal?.classList.remove('flex');
  });

  saveCardsBtn?.addEventListener('click', () => {
    const checked = Array.from(document.querySelectorAll('input[name="bank-select"]:checked')).map(
      (el) => (el as HTMLInputElement).value
    );
    localStorage.setItem('dealssite_user_cards', JSON.stringify(checked));
    cardModal?.classList.add('hidden');
    cardModal?.classList.remove('flex');
    applyCardFilter(checked);
  });

  resetCardsBtn?.addEventListener('click', () => {
    document.querySelectorAll('input[name="bank-select"]').forEach((el) => {
      (el as HTMLInputElement).checked = false;
    });
    localStorage.removeItem('dealssite_user_cards');
    applyCardFilter([]);
  });

  function applyCardFilter(selectedBanks: string[]) {
    const dealCards = document.querySelectorAll('article[data-bank-id]');
    if (selectedBanks.length === 0) {
      dealCards.forEach((c) => (c as HTMLElement).style.display = '');
      return;
    }
    dealCards.forEach((card) => {
      const bankId = card.getAttribute('data-bank-id');
      if (bankId && selectedBanks.includes(bankId)) {
        (card as HTMLElement).style.display = '';
      } else if (!bankId) {
        (card as HTMLElement).style.display = ''; // General deals remain visible
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  // Restore saved cards from localStorage on page load
  try {
    const saved = JSON.parse(localStorage.getItem('dealssite_user_cards') || '[]');
    if (saved && saved.length > 0) {
      saved.forEach((bankVal: string) => {
        const checkbox = document.querySelector(`input[name="bank-select"][value="${bankVal}"]`) as HTMLInputElement | null;
        if (checkbox) checkbox.checked = true;
      });
      applyCardFilter(saved);
    }
  } catch (err) {
    console.error('Error restoring cards from localStorage', err);
  }
</script>
