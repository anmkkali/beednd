---
import Icon from './Icon.astro';
import { getCollection } from 'astro:content';

const brands = await getCollection('brands');
const brandNames = new Map(brands.map((brand) => [brand.data.id, brand.data.name]));
const latest = (await getCollection('deals', ({ data }) => data.status === 'active'))
  .sort((a, b) => b.data.last_verified_at.localeCompare(a.data.last_verified_at))
  .slice(0, 8);
---

<header class="sticky top-0 z-30 w-full border-b editorial-rule bg-base-950/95 backdrop-blur-md">
  <div class="flex h-14 items-center gap-1 px-2 sm:h-16 sm:gap-3 sm:px-6 lg:px-10">
    <!-- Mobile only: menu, logo and theme switch. On desktop the logo lives in the sidebar. -->
    <button type="button" data-sidebar-open-btn class="icon-btn lg:hidden" aria-label="Open menu">
      <Icon name="menu" class="h-5 w-5" />
    </button>
    <a href="/" class="flex-1 text-center font-serif text-[26px] font-semibold leading-none tracking-tight text-ink sm:flex-none sm:text-left lg:hidden" aria-label="DealsSite home">
      DealsSite
    </a>

    <button
      type="button"
      id="header-search-btn"
      class="flex h-10 w-10 shrink-0 items-center justify-center gap-3 border-0 bg-transparent text-[14px] sm:border editorial-rule sm:bg-base-900/60 text-ink-muted transition-colors hover:border-ink/50 hover:bg-base-900 hover:text-ink sm:w-auto sm:min-w-0 sm:flex-1 sm:justify-start sm:px-3.5"
      aria-label="Search deals, brands and categories"
    >
      <Icon name="search" class="h-[18px] w-[18px] shrink-0 text-ink" />
      <span class="hidden truncate sm:inline">Search brands, categories or deals</span>
      <kbd class="ml-auto hidden border editorial-rule px-1.5 py-0.5 text-[11px] font-medium md:inline-block">Ctrl K</kbd>
    </button>

    <nav class="hidden shrink-0 items-center gap-2 lg:flex" aria-label="Primary">
      <a href="/brands" class="btn-primary inline-flex h-10 items-center gap-2 px-4 text-[13.5px] font-semibold">
        <Icon name="grid" class="h-4 w-4" />
        Browse Brands
      </a>
      <a href="/blog" class="btn-outline inline-flex h-10 items-center gap-2 px-4 text-[13.5px] font-semibold">
        <Icon name="book" class="h-4 w-4" />
        Blog
      </a>

      <details class="relative" data-dropdown>
        <summary class="btn-outline flex h-10 cursor-pointer list-none items-center gap-2 px-3.5 text-[13.5px] font-semibold">
          <Icon name="location" class="h-4 w-4" />
          Cities
          <Icon name="chevron" class="h-4 w-4 text-ink-muted" />
        </summary>
        <div data-cities-panel class="absolute right-0 top-12 z-50 max-h-[70vh] w-64 overflow-y-auto border editorial-rule bg-base-950 shadow-xl"></div>
      </details>

      <label class="btn-outline relative flex h-10 cursor-pointer items-center gap-2 px-3.5 text-[13.5px] font-medium" title="Country">
        <Icon name="globe" class="h-4 w-4 shrink-0" />
        <span data-country-label class="max-w-[10rem] truncate">Detecting</span>
        <Icon name="chevron" class="h-4 w-4 text-ink-muted" />
        <select data-country-select class="absolute inset-0 h-full w-full cursor-pointer opacity-0" aria-label="Choose country">
          <option value="AUTO">Auto-detect</option>
          <option value="ALL">All countries</option>
        </select>
      </label>
    </nav>

    <!-- Notifications -->
    <details class="relative ml-auto shrink-0 lg:ml-0" data-dropdown data-bell>
      <summary class="icon-btn relative cursor-pointer list-none" aria-label="New discounts" title="New discounts">
        <Icon name="bell" class="h-5 w-5" />
        <span data-bell-badge class="btn-primary absolute right-0.5 top-0.5 hidden min-w-[1.1rem] px-1 text-center text-[11px] font-bold leading-[1.1rem]">0</span>
      </summary>
      <div data-mobile-panel class="fixed left-3 right-3 top-14 z-50 border editorial-rule bg-base-950 shadow-xl sm:absolute sm:left-auto sm:right-0 sm:top-12 sm:w-96">
        <p class="border-b editorial-rule px-4 py-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">New discounts</p>
        <ul class="max-h-[60vh] overflow-y-auto">
          {latest.map((deal) => (
            <li data-notif-item data-market={deal.data.country} data-ts={Date.parse(deal.data.last_verified_at)}>
              <a href={`/deals/${deal.data.slug}`} class="block border-b editorial-rule px-4 py-3 hover:bg-base-900">
                <span class="block text-[12.5px] font-semibold uppercase tracking-[0.08em] text-ink-muted">{brandNames.get(deal.data.brand_id) || deal.data.brand_id}</span>
                <span class="mt-0.5 block text-[14.5px] leading-snug text-ink">{deal.data.title}</span>
                <span class="mt-1 inline-block text-[13px] font-semibold text-ink">{deal.data.badge_text || deal.data.discount_value}</span>
              </a>
            </li>
          ))}
        </ul>
        <p data-notif-empty class="hidden px-4 py-6 text-center text-[14px] text-ink-muted">No new discounts for your country yet.</p>
        <button type="button" data-notify-open class="flex w-full items-center justify-center gap-2 border-t editorial-rule px-4 py-3 text-[13.5px] font-semibold text-ink hover:bg-base-900">
          <Icon name="bell" class="h-4 w-4" />
          Get email alerts by brand
        </button>
      </div>
    </details>
  </div>

  <!-- Mobile and tablet quick bar -->
  <div data-quickbar class="flex items-center gap-2 overflow-x-auto border-t editorial-rule px-4 py-2 lg:hidden">
    <a href="/brands" class="btn-primary inline-flex h-9 shrink-0 items-center px-3.5 text-[13px] font-semibold">Browse Brands</a>
    <a href="/blog" class="btn-outline inline-flex h-9 shrink-0 items-center px-3.5 text-[13px] font-semibold">Blog</a>
    <details class="shrink-0" data-dropdown>
      <summary class="btn-outline flex h-9 cursor-pointer list-none items-center gap-1.5 px-3.5 text-[13px] font-semibold">
        <Icon name="location" class="h-3.5 w-3.5" />
        Cities
        <Icon name="chevron" class="h-3.5 w-3.5 text-ink-muted" />
      </summary>
      <div data-cities-panel data-mobile-panel class="fixed left-3 right-3 top-[104px] z-50 max-h-[60vh] overflow-y-auto border editorial-rule bg-base-950 shadow-xl"></div>
    </details>
    <label class="btn-outline relative flex h-9 shrink-0 cursor-pointer items-center gap-1.5 px-3.5 text-[13px] font-medium">
      <Icon name="globe" class="h-3.5 w-3.5 shrink-0" />
      <span data-country-label class="max-w-[8rem] truncate">Detecting</span>
      <select data-country-select class="absolute inset-0 h-full w-full cursor-pointer opacity-0" aria-label="Choose country">
        <option value="AUTO">Auto-detect</option>
        <option value="ALL">All countries</option>
      </select>
    </label>
  </div>
</header>
