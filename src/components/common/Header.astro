---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { getCollection } from 'astro:content';

const brands = await getCollection('brands');
const brandNames = new Map(brands.map((brand) => [brand.data.id, brand.data.name]));
const latest = (await getCollection('deals', ({ data }) => data.status === 'active'))
  .sort((a, b) => b.data.last_verified_at.localeCompare(a.data.last_verified_at))
  .slice(0, 8);
---

<header class="w-full border-b editorial-rule bg-base-950/95 backdrop-blur-md">
  <div class="relative flex h-14 items-center justify-between px-3 sm:h-16 sm:px-5">
    <!-- LEFT: Menu button (hamburger + Menu label) -->
    <div class="flex items-center gap-2">
      <button
        type="button"
        data-menu-toggle
        class="inline-flex h-9 items-center gap-1.5 rounded-full px-2.5 py-1 text-ink transition-colors hover:bg-base-900 focus:outline-none sm:h-10 sm:px-3"
        aria-label="Open or close menu"
      >
        <Icon name="menu" class="hb-open h-5 w-5" />
        <Icon name="close" class="hb-close h-5 w-5" />
        <span class="hidden text-[13.5px] font-semibold tracking-wide sm:inline">Menu</span>
      </button>
    </div>

    <!-- CENTER: Brand Logo perfectly centered on desktop and mobile -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 text-center pointer-events-auto">
      <a href="/" class="flex items-center justify-center transition-opacity hover:opacity-85" aria-label="DealsSite home">
        <Logo class="h-6 sm:h-7.5 w-auto max-w-[130px] sm:max-w-[170px]" />
      </a>
    </div>

    <!-- RIGHT: Expanding Search, Blog (Icon + Text), Cities, Country, Notifications -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <!-- Expanding search trigger: icon-only by default, expands on hover -->
      <button
        type="button"
        id="header-search-btn"
        class="group flex h-9 w-9 items-center justify-center overflow-hidden rounded-full border editorial-rule bg-base-900/60 text-ink transition-all duration-300 hover:border-ink/50 hover:bg-base-900 focus:outline-none sm:h-10 sm:w-10 sm:hover:w-48 sm:hover:justify-start sm:hover:px-3"
        aria-label="Search deals, brands and categories"
        title="Search (Ctrl+K)"
      >
        <Icon name="search" class="h-4 w-4 shrink-0 text-ink transition-transform group-hover:scale-105" />
        <span class="hidden max-w-0 overflow-hidden whitespace-nowrap text-[13px] text-ink-muted transition-all duration-300 sm:group-hover:ml-2 sm:group-hover:max-w-[7rem] sm:group-hover:inline sm:group-hover:text-ink">Search deals...</span>
        <kbd class="ml-auto hidden border editorial-rule px-1.5 py-0.5 text-[10px] font-mono text-ink-muted sm:group-hover:inline-block">Ctrl K</kbd>
      </button>

      <!-- Blog button (desktop header; mobile has it in quickbar below) -->
      <a
        href="/blog"
        class="btn-outline hidden sm:inline-flex h-9 items-center gap-1.5 rounded-full px-2.5 text-[12.5px] font-semibold transition-colors sm:h-10 sm:px-3.5 sm:text-[13px]"
        aria-label="Blog"
        title="Blog"
      >
        <Icon name="book" class="h-4 w-4 shrink-0 text-ink" />
        <span>Blog</span>
      </a>

      <!-- Cities dropdown (desktop header; mobile has it in quickbar below) -->
      <details class="relative hidden sm:block" data-dropdown>
        <summary
          class="btn-outline flex h-9 cursor-pointer list-none items-center gap-1.5 rounded-full px-2.5 text-[12.5px] font-semibold transition-colors sm:h-10 sm:px-3 sm:text-[13px]"
          title="Select city"
        >
          <Icon name="location" class="h-4 w-4 shrink-0 text-ink" />
          <span class="hidden sm:inline">Cities</span>
          <Icon name="chevron" class="h-3.5 w-3.5 text-ink-muted" />
        </summary>
        <div data-cities-panel class="absolute right-0 top-11 z-50 max-h-[70vh] w-64 overflow-y-auto border editorial-rule bg-base-950 shadow-xl sm:top-12"></div>
      </details>

      <!-- Country selector (desktop header; mobile has it in quickbar below) -->
      <label
        class="btn-outline relative hidden sm:flex h-9 cursor-pointer items-center gap-1.5 rounded-full px-2.5 text-[12.5px] font-medium transition-colors sm:h-10 sm:px-3 sm:text-[13px]"
        title="Change country"
      >
        <Icon name="globe" class="h-4 w-4 shrink-0 text-ink" />
        <span data-country-label class="max-w-[7.5rem] truncate hidden md:inline">Detecting</span>
        <Icon name="chevron" class="h-3.5 w-3.5 text-ink-muted hidden md:inline" />
        <select data-country-select class="absolute inset-0 h-full w-full cursor-pointer opacity-0" aria-label="Choose country">
          <option value="AUTO">Auto-detect</option>
          <option value="ALL">All countries</option>
        </select>
      </label>

      <!-- Notification Bell -->
      <details class="relative shrink-0" data-dropdown data-bell>
        <summary class="icon-btn relative h-9 w-9 cursor-pointer list-none rounded-full sm:h-10 sm:w-10" aria-label="New discounts" title="New discounts">
          <Icon name="bell" class="h-4 w-4 sm:h-[18px] sm:w-[18px]" />
          <span data-bell-badge class="absolute -right-0.5 -top-0.5 flex h-4 min-w-[1.05rem] items-center justify-center rounded-full bg-red-600 px-1 text-[10px] font-bold leading-none text-white shadow-sm">
            {latest.length || 8}
          </span>
        </summary>
        <div data-mobile-panel class="fixed left-3 right-3 top-14 z-50 border editorial-rule bg-base-950 shadow-xl sm:absolute sm:left-auto sm:right-0 sm:top-12 sm:w-96">
          <p class="border-b editorial-rule px-4 py-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">New discounts</p>
          <ul class="max-h-[60vh] overflow-y-auto">
            {latest.map((deal) => (
              <li data-notif-item data-market={deal.data.country} data-ts={Date.parse(deal.data.last_verified_at)}>
                <a href={`/deals/${deal.data.slug}`} class="block border-b editorial-rule px-4 py-3 hover:bg-base-900">
                  <span class="block text-[12px] font-semibold uppercase tracking-[0.08em] text-ink-muted">{brandNames.get(deal.data.brand_id) || deal.data.brand_id}</span>
                  <span class="mt-0.5 block text-[14px] leading-snug text-ink">{deal.data.title}</span>
                  <span class="mt-1 inline-block text-[12.5px] font-semibold text-ink">{deal.data.badge_text || deal.data.discount_value}</span>
                </a>
              </li>
            ))}
          </ul>
          <p data-notif-empty class="hidden px-4 py-6 text-center text-[14px] text-ink-muted">No new discounts for your country yet.</p>
          <button type="button" data-notify-open class="flex w-full items-center justify-center gap-2 border-t editorial-rule px-4 py-3 text-[13px] font-semibold text-ink hover:bg-base-900">
            <Icon name="bell" class="h-4 w-4" />
            Get email alerts by brand
          </button>
        </div>
      </details>
    </div>
  </div>
</header>

<!-- Mobile quick row: 3 equal expanded buttons with icons, even space across mobile -->
<div data-quickbar class="grid grid-cols-3 gap-2 border-b editorial-rule bg-base-950 px-3 py-2 sm:hidden">
  <a href="/blog" class="btn-outline flex h-8 w-full items-center justify-center gap-1.5 rounded-full px-2 text-[12px] font-semibold">
    <Icon name="book" class="h-3.5 w-3.5 shrink-0 text-ink" />
    <span>Blog</span>
  </a>
  <details class="relative w-full" data-dropdown>
    <summary class="btn-outline flex h-8 w-full cursor-pointer list-none items-center justify-center gap-1 rounded-full px-2 text-[12px] font-semibold">
      <Icon name="location" class="h-3.5 w-3.5 shrink-0 text-ink" />
      <span>Cities</span>
      <Icon name="chevron" class="h-3 w-3 text-ink-muted shrink-0" />
    </summary>
    <div data-cities-panel data-mobile-panel class="fixed left-3 right-3 top-[105px] z-50 max-h-[60vh] overflow-y-auto border editorial-rule bg-base-950 shadow-xl"></div>
  </details>
  <label class="btn-outline relative flex h-8 w-full cursor-pointer items-center justify-center gap-1 rounded-full px-2 text-[12px] font-medium">
    <Icon name="globe" class="h-3.5 w-3.5 shrink-0 text-ink" />
    <span data-country-label class="max-w-[4.5rem] truncate text-[11.5px]">Detecting</span>
    <Icon name="chevron" class="h-3 w-3 text-ink-muted shrink-0" />
    <select data-country-select class="absolute inset-0 h-full w-full cursor-pointer opacity-0" aria-label="Choose country">
      <option value="AUTO">Auto-detect</option>
      <option value="ALL">All countries</option>
    </select>
  </label>
</div>
