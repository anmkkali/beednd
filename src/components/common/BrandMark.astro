---
interface Props {
  name: string;
  logoUrl?: string;
  size?: 'sm' | 'md' | 'lg';
}

const { name, logoUrl, size = 'md' } = Astro.props;
const sizeClasses = {
  sm: 'h-8 w-8 p-1 text-sm sm:h-9 sm:w-9 sm:p-1.5',
  md: 'h-10 w-10 p-1.5 text-base sm:h-12 sm:w-12 sm:p-2',
  lg: 'h-12 w-12 p-2 text-lg sm:h-14 sm:w-14 sm:p-2.5',
}[size];
const initial = name.trim().charAt(0).toUpperCase();
---

<span class={`relative inline-flex shrink-0 items-center justify-center border editorial-rule bg-white text-[#141413] font-serif font-semibold ${sizeClasses}`}>
  {logoUrl ? (
    <img
      src={logoUrl}
      alt={`${name} logo`}
      class="h-full w-full object-contain"
      loading="lazy"
      decoding="async"
      onerror="this.style.display='none';this.nextElementSibling.style.display='inline';"
    />
  ) : null}
  <span style={logoUrl ? 'display:none;' : ''}>{initial}</span>
</span>
