---
import Icon from './Icon.astro';
---

<footer class="mt-16 border-t border-base-800 bg-base-950 text-xs text-gray-500">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-[1.5fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="mb-3 flex items-center gap-2 text-base font-extrabold text-white">
          <span class="flex h-7 w-7 items-center justify-center rounded-md bg-brand-blue text-base-950">
            <Icon name="tag" class="h-4 w-4" />
          </span>
          DealsSite
        </a>
        <p class="max-w-sm leading-relaxed">Current discounts and promo codes organized by country, brand, category and city.</p>
      </div>

      <div>
        <h2 class="mb-3 font-bold text-gray-200">Browse</h2>
        <div class="space-y-2">
          <a href="/brands" class="block hover:text-brand-blue">All brands</a>
          <a href="/categories/clothing-fashion" class="block hover:text-brand-blue">Clothing & fashion</a>
          <a href="/categories/tech-electronics" class="block hover:text-brand-blue">Tech & electronics</a>
          <a href="/blog" class="block hover:text-brand-blue">Blog</a>
        </div>
      </div>

      <div>
        <h2 class="mb-3 font-bold text-gray-200">Cities</h2>
        <div class="space-y-2">
          <a href="/pakistan/karachi" class="block hover:text-brand-blue">Karachi</a>
          <a href="/pakistan/lahore" class="block hover:text-brand-blue">Lahore</a>
          <a href="/pakistan/islamabad" class="block hover:text-brand-blue">Islamabad</a>
          <a href="/pakistan/rawalpindi" class="block hover:text-brand-blue">Rawalpindi</a>
        </div>
      </div>

      <div>
        <h2 class="mb-3 font-bold text-gray-200">Banks</h2>
        <div class="space-y-2">
          <a href="/banks/hbl" class="block hover:text-brand-blue">HBL</a>
          <a href="/banks/meezan" class="block hover:text-brand-blue">Meezan Bank</a>
          <a href="/banks/alfalah" class="block hover:text-brand-blue">Bank Alfalah</a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-base-800 pt-6 text-[11px] sm:flex-row sm:items-center sm:justify-between">
      <p>Brand names and logos belong to their respective owners.</p>
      <p>&copy; {new Date().getFullYear()} DealsSite</p>
    </div>
  </div>
</footer>
