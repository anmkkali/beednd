---
import Icon from './Icon.astro';

const columns = [
  {
    title: 'Explore',
    links: [
      ['Browse Brands', '/brands'],
      ['AI Tools', '/categories/ai-tools'],
      ['Clothing & Fashion', '/categories/clothing-fashion'],
      ['Tech & Electronics', '/categories/tech-electronics'],
      ['Blog', '/blog'],
    ],
  },
  {
    title: 'Company',
    links: [
      ['About Us', '/about'],
      ['Contact Us', '/contact'],
      ['Submit a Deal', '#submit-deal'],
      ['Sitemap', '/sitemap.xml'],
    ],
  },
  {
    title: 'Legal',
    links: [
      ['Privacy Policy', '/privacy-policy'],
      ['Terms of Service', '/terms-of-service'],
      ['Cookie Policy', '/cookie-policy'],
      ['Affiliate Disclosure', '/affiliate-disclosure'],
      ['Disclaimer', '/disclaimer'],
    ],
  },
];
---

<footer class="border-t editorial-rule bg-base-950 text-[14.5px] text-ink-muted">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 lg:px-10">
    <div class="grid gap-10 md:grid-cols-[1.6fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex items-center gap-2.5 text-ink">
          <span class="btn-primary flex h-8 w-8 items-center justify-center">
            <Icon name="tag" class="h-4 w-4" />
          </span>
          <span class="font-serif text-[28px] font-semibold leading-none">DealsSite</span>
        </a>
        <p class="mt-3 max-w-sm leading-relaxed">
          Discounts, promo codes and free trials from brands around the world, shown for the country you are in.
        </p>
      </div>

      {columns.map((column) => (
        <div>
          <h2 class="mb-3 font-sans text-[12px] font-semibold uppercase tracking-[0.16em] text-ink">{column.title}</h2>
          <ul class="space-y-2.5">
            {column.links.map(([label, href]) => (
              <li>
                {href === '#submit-deal' ? (
                  <button type="button" data-submit-open class="hover:text-ink hover:underline">{label}</button>
                ) : (
                  <a href={href} class="hover:text-ink hover:underline">{label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t editorial-rule pt-6 text-[13.5px] sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {new Date().getFullYear()} DealsSite. Brand names and logos belong to their owners.</p>
      <p>Some links are affiliate links. See our <a href="/affiliate-disclosure" class="text-ink underline">disclosure</a>.</p>
    </div>
  </div>
</footer>
