---
import BaseLayout from '../../layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  updated?: string;
}

const { title, description, updated = 'November 20, 2026' } = Astro.props;
---

<BaseLayout title={title} description={description} showTopAd={false} showBottom={false}>
  <article class="max-w-3xl">
    <nav class="mb-4 flex items-center gap-2 text-[13.5px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">{title}</span>
    </nav>
    <header class="mb-8 border-b editorial-rule pb-6">
      <h1 class="text-5xl leading-[1.02] text-ink sm:text-6xl">{title}</h1>
      <p class="mt-3 text-[14px] text-ink-muted">Last updated: {updated}</p>
    </header>
    <div class="editorial-prose">
      <slot />
    </div>
  </article>
</BaseLayout>
