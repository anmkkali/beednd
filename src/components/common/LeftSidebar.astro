---
import Icon from './Icon.astro';

interface Props {
  activeCategory?: string;
  activeTopic?: string;
}

const { activeCategory = 'all', activeTopic = '' } = Astro.props;

const categories = [
  {
    id: 'clothing-fashion',
    name: 'Clothing & Fashion',
    icon: 'apparel',
    children: ['Women', 'Men', 'Footwear', 'Accessories'],
  },
  {
    id: 'tech-electronics',
    name: 'Tech & Electronics',
    icon: 'tech',
    children: ['Mobiles', 'Laptops', 'Home Appliances'],
  },
  {
    id: 'hosting-software',
    name: 'Software & Hosting',
    icon: 'software',
    children: ['Hosting', 'AI Tools', 'Business Software'],
  },
  {
    id: 'food-dining',
    name: 'Food & Dining',
    icon: 'food',
    children: ['Restaurants', 'Fast Food', 'Delivery'],
  },
  {
    id: 'beauty-wellness',
    name: 'Beauty & Wellness',
    icon: 'beauty',
    children: ['Skincare', 'Makeup', 'Health'],
  },
  {
    id: 'travel-lifestyle',
    name: 'Travel & Hotels',
    icon: 'travel',
    children: ['Hotels', 'Flights', 'Experiences'],
  },
  {
    id: 'groceries-essentials',
    name: 'Groceries',
    icon: 'grocery',
    children: ['Supermarkets', 'Household', 'Essentials'],
  },
];

const dealTypes = [
  { id: 'promo-code', name: 'Promo codes', icon: 'tag' },
  { id: 'bank-card', name: 'Bank card deals', icon: 'card' },
  { id: 'store-sale', name: 'Store sales', icon: 'store' },
];
---

<aside class="sticky top-24 hidden h-[calc(100vh-7rem)] w-64 shrink-0 overflow-y-auto pr-4 lg:block">
  <div class="mb-8">
    <p class="mb-3 px-2 text-[11px] font-bold uppercase tracking-[0.16em] text-gray-500">Categories</p>
    <nav class="space-y-1" aria-label="Deal categories">
      {categories.map((category) => (
        <details open={activeTopic === category.id} class="group">
          <summary
            class:list={[
              'flex cursor-pointer list-none items-center gap-3 rounded-lg px-2.5 py-2.5 text-sm transition-colors',
              activeTopic === category.id
                ? 'bg-brand-blue/10 font-semibold text-brand-blue'
                : 'text-gray-300 hover:bg-base-900 hover:text-white',
            ]}
          >
            <Icon name={category.icon} class="h-[18px] w-[18px] shrink-0" />
            <a href={`/categories/${category.id}`} class="min-w-0 flex-1 truncate">{category.name}</a>
            <svg class="h-3.5 w-3.5 text-gray-600 transition-transform group-open:rotate-90" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="m7 4 6 6-6 6V4Z"></path>
            </svg>
          </summary>
          <div class="ml-[21px] border-l border-base-800 py-1 pl-4">
            {category.children.map((child) => (
              <a
                href={`/categories/${category.id}?sub=${encodeURIComponent(child.toLowerCase())}`}
                class="block rounded-md px-2 py-1.5 text-xs text-gray-500 hover:text-brand-blue"
              >
                {child}
              </a>
            ))}
          </div>
        </details>
      ))}
    </nav>
  </div>

  <div class="mb-8">
    <p class="mb-3 px-2 text-[11px] font-bold uppercase tracking-[0.16em] text-gray-500">Offer type</p>
    <nav class="space-y-1">
      <a
        href="/"
        class:list={[
          'flex items-center gap-3 rounded-lg px-2.5 py-2 text-sm transition-colors',
          activeCategory === 'all' ? 'bg-base-900 text-white' : 'text-gray-400 hover:text-white',
        ]}
      >
        <Icon name="grid" class="h-4 w-4" />
        All offers
      </a>
      {dealTypes.map((type) => (
        <a
          href={`/?type=${type.id}`}
          class:list={[
            'flex items-center gap-3 rounded-lg px-2.5 py-2 text-sm transition-colors',
            activeCategory === type.id ? 'bg-base-900 text-white' : 'text-gray-400 hover:text-white',
          ]}
        >
          <Icon name={type.icon} class="h-4 w-4" />
          {type.name}
        </a>
      ))}
    </nav>
  </div>

  <a href="/brands" class="flex items-center justify-between bg-brand-blue px-4 py-3 text-sm font-bold text-black">
    Browse all brands
    <Icon name="arrow" class="h-4 w-4" />
  </a>
</aside>
