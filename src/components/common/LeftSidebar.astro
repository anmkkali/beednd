---
import Icon from './Icon.astro';
import { categories } from '../../data/taxonomy';

interface Props {
  activeCategory?: string;
  activeTopic?: string;
}

const quickLinks = [
  { label: 'All offers', href: '/', icon: 'grid' },
  { label: 'Trending', href: '/?type=trending', icon: 'trending' },
  { label: 'Free trials', href: '/?type=trial', icon: 'sparkle' },
  { label: 'Promo codes', href: '/?type=promo-code', icon: 'tag' },
  { label: 'Vouchers', href: '/?type=voucher', icon: 'tag' },
  { label: 'Store sales', href: '/?type=store-sale', icon: 'store' },
  { label: 'Bank deals', href: '/banks', icon: 'card' },
];

const filterHref = (categoryId: string, groupId: string, filter: { sub?: string; kind?: string }) => {
  const params = new URLSearchParams({ group: groupId });
  if (filter.sub) params.set('sub', filter.sub);
  if (filter.kind) params.set('kind', filter.kind);
  return `/categories/${categoryId}?${params.toString()}`;
};
---

<div id="sidebar-backdrop" class="fixed inset-0 z-50 bg-black/40" data-sidebar-close></div>

<aside id="app-sidebar" class="flex flex-col border-r editorial-rule bg-base-950" aria-label="Site navigation">
  <!-- Logo row: logo, theme switch, search, collapse (like the ChatGPT sidebar) -->
  <div class="sb-top flex h-16 shrink-0 items-center justify-between gap-1 px-3">
    <a href="/" class="flex min-w-0 items-center gap-2.5" aria-label="DealsSite home">
      <span class="btn-primary flex h-8 w-8 shrink-0 items-center justify-center">
        <Icon name="tag" class="h-4 w-4" />
      </span>
      <span class="sb-label whitespace-nowrap font-serif text-[24px] font-semibold leading-none tracking-tight text-ink">DealsSite</span>
    </a>
    <div class="sb-actions flex shrink-0 items-center">
      <button type="button" data-theme-toggle class="icon-btn sb-hide-collapsed" aria-label="Switch between light and dark mode" title="Light / dark mode">
        <span class="theme-icon-moon inline-flex"><Icon name="moon" class="h-[18px] w-[18px]" /></span>
        <span class="theme-icon-sun"><Icon name="sun" class="h-[18px] w-[18px]" /></span>
      </button>
      <button type="button" id="sidebar-toggle" class="icon-btn" aria-label="Collapse or expand sidebar" title="Collapse / expand sidebar">
        <Icon name="panel" class="h-[18px] w-[18px]" />
      </button>
    </div>
  </div>

  <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-8">
    <nav class="space-y-0.5 pt-1" aria-label="Offer types">
      {quickLinks.map((link) => (
        <a href={link.href} data-sb-link class="sb-link" title={link.label}>
          <Icon name={link.icon} class="h-[18px] w-[18px] shrink-0" />
          <span class="sb-label truncate">{link.label}</span>
        </a>
      ))}
    </nav>

    <p class="sb-heading mb-2 mt-7 px-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Categories</p>

    <nav class="space-y-0.5" aria-label="Categories">
      {categories.map((category) => (
        <details class="sb-cat" data-category={category.id}>
          <summary class="sb-link cursor-pointer list-none" data-sb-summary title={category.name}>
            <Icon name={category.icon} class="h-[18px] w-[18px] shrink-0" />
            <span class="sb-label flex-1 truncate">{category.name}</span>
            <Icon name="chevron" class="sb-chevron h-4 w-4 shrink-0 text-ink-muted" />
          </summary>

          <div class="sb-nested ml-[1.4rem] border-l editorial-rule pl-2">
            <a href={`/categories/${category.id}`} data-sb-link class="sb-link">
              All {category.name}
            </a>

            {(category.kinds || []).map((kind) => (
              <a href={`/categories/${category.id}?kind=${kind.kind}`} data-sb-link class="sb-link">
                {kind.label}
              </a>
            ))}

            {category.groups.map((group) => (
              <details class="sb-group" data-group={group.id}>
                <summary class="sb-link cursor-pointer list-none" data-sb-summary>
                  <span class="flex-1 truncate">{group.label}</span>
                  <Icon name="chevron" class="h-3.5 w-3.5 shrink-0 text-ink-muted" />
                </summary>
                <div class="ml-3 border-l editorial-rule pl-2">
                  {group.filters.map((filter) => (
                    <a href={filterHref(category.id, group.id, filter)} data-sb-link class="sb-link">
                      {filter.label}
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      ))}
    </nav>

    <div class="mt-6 border-t editorial-rule pt-4">
      <button type="button" data-notify-open class="sb-link" title="Notify me">
        <Icon name="bell" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate">Notify me</span>
      </button>
      <button type="button" data-submit-open class="sb-link mt-0.5" title="Submit deal">
        <Icon name="plus" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate">Submit deal</span>
      </button>
    </div>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const sidebar = document.getElementById('app-sidebar');
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
  const isCollapsed = () => isDesktop() && root.dataset.sidebar === 'collapsed';

  // On blog pages the sidebar starts minimised. That choice is not saved, so other pages keep your own setting.
  const persist = !window.location.pathname.startsWith('/blog');

  function setCollapsed(collapsed: boolean) {
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    if (persist) localStorage.setItem('dealssite_sidebar', collapsed ? 'collapsed' : 'open');
  }

  function closeDrawer() {
    delete root.dataset.sidebarOpen;
  }

  // Collapse button: collapses the desktop rail, closes the mobile drawer
  document.getElementById('sidebar-toggle')?.addEventListener('click', () => {
    if (isDesktop()) setCollapsed(!isCollapsed());
    else closeDrawer();
  });

  document.querySelectorAll('[data-sidebar-close]').forEach((el) => el.addEventListener('click', closeDrawer));
  document.querySelectorAll('[data-sidebar-open-btn]').forEach((el) =>
    el.addEventListener('click', () => {
      root.dataset.sidebarOpen = '';
    })
  );

  // A click anywhere on the minimised rail opens it. Links still go to their page.
  sidebar?.addEventListener(
    'click',
    (event) => {
      if (!isCollapsed()) return;
      const target = event.target as HTMLElement;
      if (target.closest('#sidebar-toggle')) return;
      const summary = target.closest('summary');
      if (summary) {
        event.preventDefault();
        (summary.parentElement as HTMLDetailsElement).open = true;
      }
      if (target.closest('button[data-notify-open], button[data-submit-open]')) event.stopPropagation();
      setCollapsed(false);
    },
    true
  );

  // Highlight where you are and open the matching category and group
  const FILTER_KEYS = ['group', 'sub', 'kind', 'type'];
  const trimSlash = (path: string) => path.replace(/\/+$/, '') || '/';

  function markActive() {
    if (!sidebar) return;
    const here = new URL(window.location.href);
    sidebar.querySelectorAll<HTMLElement>('[data-active], [data-ancestor]').forEach((el) => {
      delete el.dataset.active;
      delete el.dataset.ancestor;
    });

    sidebar.querySelectorAll<HTMLAnchorElement>('a[data-sb-link]').forEach((link) => {
      const target = new URL(link.href);
      let active = trimSlash(target.pathname) === trimSlash(here.pathname);
      if (active) {
        for (const key of FILTER_KEYS) {
          if ((target.searchParams.get(key) || '') !== (here.searchParams.get(key) || '')) active = false;
        }
      }
      if (!active) return;
      link.dataset.active = 'true';
      let parent = link.parentElement;
      while (parent && parent !== sidebar) {
        if (parent instanceof HTMLDetailsElement) {
          parent.open = true;
          const summary = parent.querySelector(':scope > summary');
          if (summary instanceof HTMLElement) summary.dataset.ancestor = 'true';
        }
        parent = parent.parentElement;
      }
      link.scrollIntoView({ block: 'nearest' });
    });
  }

  markActive();
  window.addEventListener('popstate', markActive);
  window.addEventListener('dealssite:filters-changed', markActive);
</script>
