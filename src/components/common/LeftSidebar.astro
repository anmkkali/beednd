---
import Icon from './Icon.astro';

interface Props {
  activeCategory?: string;
  activeTopic?: string;
}

const { activeCategory = 'all', activeTopic = '' } = Astro.props;

const categories = [
  {
    id: 'clothing-fashion',
    name: 'Clothing & Fashion',
    icon: 'apparel',
    subcategories: [
      { label: "Women's Pret", query: 'women' },
      { label: 'Unstitched Fabrics', query: 'unstitched' },
      { label: "Men's Wear", query: 'men' },
      { label: 'Footwear & Active', query: 'footwear' },
      { label: 'Accessories', query: 'accessories' },
    ],
    brands: [
      { name: 'Khaadi', slug: 'khaadi', market: 'PK' },
      { name: 'Sapphire', slug: 'sapphire', market: 'PK' },
      { name: 'J. Junaid Jamshed', slug: 'jdot', market: 'PK' },
      { name: 'Nike', slug: 'nike', market: 'US' },
    ],
  },
  {
    id: 'tech-electronics',
    name: 'Tech & Electronics',
    icon: 'tech',
    subcategories: [
      { label: 'Smartphones', query: 'mobiles' },
      { label: 'Laptops & Gear', query: 'laptops' },
      { label: 'Market Tools', query: 'stocks' },
    ],
    brands: [{ name: 'TradingView', slug: 'tradingview', market: 'GLOBAL' }],
  },
  {
    id: 'hosting-software',
    name: 'Software & Hosting',
    icon: 'software',
    subcategories: [
      { label: 'Web Hosting', query: 'hosting' },
      { label: 'AI Website Builders', query: 'ai' },
      { label: 'Charting & Finance', query: 'finance' },
    ],
    brands: [
      { name: 'Bluehost', slug: 'bluehost', market: 'GLOBAL' },
      { name: 'TradingView', slug: 'tradingview', market: 'GLOBAL' },
    ],
  },
  {
    id: 'beauty-wellness',
    name: 'Beauty & Wellness',
    icon: 'beauty',
    subcategories: [
      { label: 'Skincare', query: 'skincare' },
      { label: 'Makeup', query: 'makeup' },
      { label: 'Fragrances', query: 'fragrance' },
    ],
    brands: [
      { name: 'Sephora', slug: 'sephora', market: 'US' },
      { name: 'J. Fragrances', slug: 'jdot', market: 'PK' },
    ],
  },
  {
    id: 'food-dining',
    name: 'Food & Dining',
    icon: 'food',
    subcategories: [
      { label: 'Restaurants', query: 'restaurants' },
      { label: 'Cafes & Bakery', query: 'cafes' },
      { label: 'Delivery Deals', query: 'delivery' },
    ],
    brands: [],
  },
  {
    id: 'travel-lifestyle',
    name: 'Travel & Hotels',
    icon: 'travel',
    subcategories: [
      { label: 'Hotels & Stays', query: 'hotels' },
      { label: 'Flights', query: 'flights' },
    ],
    brands: [],
  },
  {
    id: 'groceries-essentials',
    name: 'Groceries',
    icon: 'grocery',
    subcategories: [
      { label: 'Supermarkets', query: 'supermarkets' },
      { label: 'Daily Essentials', query: 'essentials' },
    ],
    brands: [],
  },
];

const dealTypes = [
  { id: 'promo-code', name: 'Promo Codes', icon: 'tag' },
  { id: 'store-sale', name: 'Store Sales', icon: 'store' },
  { id: 'bank-card', name: 'Bank Card Deals', icon: 'card' },
];
---

<aside class="sticky top-24 hidden h-[calc(100vh-7rem)] w-64 shrink-0 overflow-y-auto border-r editorial-rule pr-6 lg:block select-none">
  <!-- Categories with Expandable Subcategories & Brand Links -->
  <div class="mb-8">
    <p class="mb-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">
      Categories
    </p>
    <nav class="divide-y editorial-rule border-t border-b editorial-rule" aria-label="Deal categories">
      {categories.map((category, index) => {
        const isActive = activeTopic === category.id;
        return (
          <details open={isActive || index === 0} class="group py-1">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2.5 py-2.5 text-[15px] text-ink transition-colors hover:opacity-75">
              <span class="flex min-w-0 items-center gap-3">
                <Icon name={category.icon} class="h-[18px] w-[18px] shrink-0 text-ink" />
                <span class:list={['truncate', isActive ? 'font-bold' : 'font-medium']}>
                  {category.name}
                </span>
              </span>
              <Icon
                name="chevron"
                class="h-4 w-4 shrink-0 text-ink-muted transition-transform duration-150 group-open:rotate-180"
              />
            </summary>

            <div class="mb-2 ml-3 border-l editorial-rule pl-4 pt-1 space-y-1">
              <a
                href={`/categories/${category.id}`}
                class="block py-1 text-[13.5px] font-semibold text-ink hover:underline"
              >
                All {category.name}
              </a>

              {category.subcategories.map((sub) => (
                <a
                  href={`/categories/${category.id}?sub=${encodeURIComponent(sub.query)}`}
                  class="block py-1 text-[13.5px] text-ink-muted transition-colors hover:text-ink"
                >
                  {sub.label}
                </a>
              ))}

              {category.brands.length > 0 && (
                <div class="pt-2 mt-1.5 border-t editorial-rule">
                  <span class="block text-[11px] font-semibold uppercase tracking-[0.14em] text-ink-muted mb-1">
                    Brands
                  </span>
                  {category.brands.map((brand) => (
                    <a
                      href={`/brands/${brand.slug}`}
                      data-market={brand.market}
                      class="block py-1 text-[13.5px] font-medium text-ink hover:underline"
                    >
                      {brand.name}
                    </a>
                  ))}
                </div>
              )}
            </div>
          </details>
        );
      })}
    </nav>
  </div>

  <!-- Offer Types -->
  <div class="mb-8">
    <p class="mb-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">
      Filter by Offer
    </p>
    <nav class="space-y-1">
      <a
        href="/"
        class:list={[
          'flex items-center gap-3 px-2.5 py-2 text-[14.5px] transition-colors',
          activeCategory === 'all' ? 'bg-base-900 font-semibold text-ink' : 'text-ink-muted hover:bg-base-900/60 hover:text-ink',
        ]}
      >
        <Icon name="grid" class="h-4 w-4 shrink-0" />
        <span>All Offers</span>
      </a>
      {dealTypes.map((type) => (
        <a
          href={`/?type=${type.id}`}
          class:list={[
            'flex items-center gap-3 px-2.5 py-2 text-[14.5px] transition-colors',
            activeCategory === type.id ? 'bg-base-900 font-semibold text-ink' : 'text-ink-muted hover:bg-base-900/60 hover:text-ink',
          ]}
        >
          <Icon name={type.icon} class="h-4 w-4 shrink-0" />
          <span>{type.name}</span>
        </a>
      ))}
    </nav>
  </div>

  <!-- Cities Collapsible Dropdown -->
  <div class="mb-8">
    <details class="border-t border-b editorial-rule py-2.5 group">
      <summary class="flex cursor-pointer list-none items-center justify-between text-[14.5px] font-semibold text-ink">
        <span class="flex items-center gap-2.5">
          <Icon name="location" class="h-4 w-4" />
          <span>City Deals</span>
        </span>
        <Icon name="chevron" class="h-4 w-4 text-ink-muted transition-transform group-open:rotate-180" />
      </summary>
      <div class="mt-2 ml-3 border-l editorial-rule pl-4 space-y-1.5">
        <a href="/pakistan/karachi" class="block py-1 text-[14px] text-ink-muted hover:text-ink">Karachi</a>
        <a href="/pakistan/lahore" class="block py-1 text-[14px] text-ink-muted hover:text-ink">Lahore</a>
        <a href="/pakistan/islamabad" class="block py-1 text-[14px] text-ink-muted hover:text-ink">Islamabad</a>
        <a href="/pakistan/rawalpindi" class="block py-1 text-[14px] text-ink-muted hover:text-ink">Rawalpindi</a>
      </div>
    </details>
  </div>

  <!-- Quick Directory Actions -->
  <div class="space-y-2.5">
    <a href="/brands" class="btn-primary flex items-center justify-between px-4 py-3 text-[14px] font-semibold">
      <span>Browse Brands</span>
      <Icon name="arrow" class="h-4 w-4" />
    </a>
    <a href="/blog" class="btn-outline flex items-center justify-between px-4 py-2.5 text-[14px] font-semibold">
      <span>Read Blog</span>
      <Icon name="book" class="h-4 w-4" />
    </a>
  </div>
</aside>
