---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { categories } from '../../data/taxonomy';
import { SUPPORTED_LANGUAGES } from '../../data/i18n';
import { getCollection } from 'astro:content';
import { dealKind } from '../../lib/deals';

interface Props {
  activeCategory?: string;
  activeTopic?: string;
}

const nowMs = Date.now();
const allDeals = (await getCollection('deals', ({ data }) => data.status === 'active')).filter(
  (d) => !d.data.end_date || Number.isNaN(Date.parse(d.data.end_date)) || Date.parse(d.data.end_date) >= nowMs
);
const allBrands = await getCollection('brands');
const activeBrandIds = new Set(allDeals.map((d) => d.data.brand_id));
const brandsWithDeals = allBrands.filter((b) => activeBrandIds.has(b.data.id));

const dealsMeta = allDeals.map((d) => ({
  m: d.data.country || 'GLOBAL',
  k: dealKind(d.data),
  t: !!d.data.is_trending,
  s: d.data.deal_type === 'in-store' || (d.data.channels || []).includes('in-store'),
  b: !!d.data.bank_details,
  c: d.data.category,
  ed: d.data.end_date || '',
}));

const brandsMeta = brandsWithDeals.map((b) => ({
  m: b.data.country || 'GLOBAL',
}));

const counts: Record<string, number> = {
  'all': allDeals.length,
  'trending': allDeals.filter((d) => d.data.is_trending).length,
  'brands': brandsWithDeals.length,
  'trial': allDeals.filter((d) => dealKind(d.data) === 'trial').length,
  'promo-code': allDeals.filter((d) => dealKind(d.data) === 'promo').length,
  'voucher': allDeals.filter((d) => dealKind(d.data) === 'voucher').length,
  'store-sale': allDeals.filter((d) => d.data.deal_type === 'in-store' || (d.data.channels || []).includes('in-store')).length,
  'bank-deals': allDeals.filter((d) => !!d.data.bank_details).length,
};

const categoryCounts = new Map<string, number>();
categories.forEach((cat) => {
  categoryCounts.set(cat.id, allDeals.filter((d) => d.data.category === cat.id).length);
});

const quickLinks = [
  { label: 'All offers', href: '/', icon: 'grid', key: 'all', i18n: 'all_offers' },
  { label: 'Trending', href: '/trending/', icon: 'trending', key: 'trending', i18n: 'trending' },
  { label: 'Browse Brands', href: '/brands/', icon: 'store', key: 'brands', i18n: 'browse_brands' },
  { label: 'Free trials', href: '/free-trials/', icon: 'sparkle', key: 'trial', i18n: 'free_trials' },
  { label: 'Promo codes', href: '/promo-codes/', icon: 'tag', key: 'promo-code', i18n: 'promo_codes' },
  { label: 'Vouchers', href: '/vouchers/', icon: 'tag', key: 'voucher', i18n: 'vouchers' },
  { label: 'Store sales', href: '/store-sales/', icon: 'store', key: 'store-sale', i18n: 'store_sales' },
  { label: 'Bank deals', href: '/banks/', icon: 'card', key: 'bank-deals', i18n: 'bank_deals' },
];

const filterHref = (categoryId: string, groupId: string, filter: { sub?: string; kind?: string }) => {
  const leaf = filter.sub || filter.kind;
  return leaf ? `/categories/${categoryId}/${groupId}/${leaf}/` : `/categories/${categoryId}/${groupId}/`;
};
---

<div id="sidebar-backdrop" transition:persist="sidebar-backdrop" class="fixed inset-0 z-[75] bg-black/60 backdrop-blur-sm" data-sidebar-close></div>

<aside
  id="app-sidebar"
  transition:persist="app-sidebar"
  class="flex flex-col border-r editorial-rule bg-base-950"
  aria-label="Site navigation"
  data-deals-meta={JSON.stringify(dealsMeta)}
  data-brands-meta={JSON.stringify(brandsMeta)}
>
  <!-- Mobile Drawer Header with brand logo & close button -->
  <div class="flex items-center justify-between border-b editorial-rule px-4 py-3.5 lg:hidden">
    <a href="/" class="flex items-center" aria-label="DealsSite home">
      <Logo class="h-6 w-auto max-w-[130px]" />
    </a>
    <button
      type="button"
      data-sidebar-close
      class="icon-btn -mr-1.5 h-8 w-8 text-ink"
      aria-label="Close menu"
    >
      <Icon name="close" class="h-5 w-5" />
    </button>
  </div>

  <div class="sb-scroll min-h-0 flex-1 overflow-y-auto overscroll-contain px-2 pb-10">
    <nav class="space-y-0.5 pt-3" aria-label="Offer types">
      {quickLinks.map((link) => (
        <a href={link.href} data-sb-link data-astro-prefetch class="sb-link group" title={link.label}>
          <Icon name={link.icon} class="h-[18px] w-[18px] shrink-0" />
          <span class="sb-label truncate" data-i18n={link.i18n}>{link.label}</span>
          <span data-sb-count={link.key} class="sb-badge ml-auto rounded-full bg-base-900 border editorial-rule px-2 py-0.5 text-[11px] font-mono font-medium text-ink-muted group-hover:text-ink">
            {counts[link.key] ?? 0}
          </span>
        </a>
      ))}
    </nav>

    <p class="sb-heading mb-2 mt-7 px-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted" data-i18n="categories">Categories</p>

    <nav class="space-y-0.5" aria-label="Categories">
      {categories.map((category) => (
        <details class="sb-cat group" data-category={category.id}>
          <summary class="sb-link cursor-pointer list-none group" data-sb-summary title={category.name}>
            <Icon name={category.icon} class="h-[18px] w-[18px] shrink-0" />
            <span class="sb-label flex-1 truncate">{category.name}</span>
            <span data-sb-cat-count={category.id} class="sb-badge mr-1 rounded-full bg-base-900 border editorial-rule px-2 py-0.5 text-[11px] font-mono font-medium text-ink-muted group-hover:text-ink">
              {categoryCounts.get(category.id) ?? 0}
            </span>
            <Icon name="chevron" class="sb-chevron h-4 w-4 shrink-0 text-ink-muted" />
          </summary>

          <div class="sb-nested ml-[1.4rem] border-l editorial-rule pl-2">
            <a href={`/categories/${category.id}/`} data-sb-link data-astro-prefetch class="sb-link">
              All {category.name}
            </a>

            {category.groups.map((group) => (
              <details class="sb-group" data-group={group.id}>
                <summary class="sb-link cursor-pointer list-none" data-sb-summary>
                  <span class="flex-1 truncate">{group.label}</span>
                  <Icon name="chevron" class="h-3.5 w-3.5 shrink-0 text-ink-muted" />
                </summary>
                <div class="ml-3 border-l editorial-rule pl-2">
                  {group.filters.map((filter) => (
                    <a href={filterHref(category.id, group.id, filter)} data-sb-link data-astro-prefetch class="sb-link">
                      {filter.label}
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      ))}
    </nav>

    <div class="mt-6 border-t editorial-rule pt-4">
      <!-- Language switcher (web & mobile) -->
      <label class="sb-link relative cursor-pointer" title="Language">
        <Icon name="globe" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate" data-i18n="language">Language</span>
        <span class="sb-label ml-auto flex items-center gap-1 text-[11.5px] font-semibold text-ink">
          <span data-lang-label>English</span>
          <Icon name="chevron" class="h-3 w-3 text-ink-muted" />
        </span>
        <select
          data-lang-select
          class="absolute inset-0 h-full w-full cursor-pointer opacity-0"
          aria-label="Choose language"
        >
          <option value="AUTO">Auto (Country)</option>
          {SUPPORTED_LANGUAGES.map((lang) => (
            <option value={lang.code}>{lang.native} ({lang.label})</option>
          ))}
        </select>
      </label>

      <button type="button" data-notify-open class="sb-link mt-0.5" title="Notify me">
        <Icon name="bell" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate" data-i18n="notify_me">Notify me</span>
      </button>
      <button type="button" data-theme-toggle class="sb-link mt-0.5" title="Switch light or dark mode">
        <span class="theme-icon-moon inline-flex"><Icon name="moon" class="h-[18px] w-[18px] shrink-0" /></span>
        <span class="theme-icon-sun"><Icon name="sun" class="h-[18px] w-[18px] shrink-0" /></span>
        <span class="sb-label theme-text-dark truncate" data-i18n="dark_mode">Dark mode</span>
        <span class="sb-label theme-text-light truncate" data-i18n="light_mode">Light mode</span>
      </button>
      <button type="button" data-submit-open class="sb-link mt-0.5" title="Submit deal">
        <Icon name="plus" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate" data-i18n="submit_deal">Submit deal</span>
      </button>
    </div>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const sidebar = document.getElementById('app-sidebar');
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
  const isCollapsed = () => isDesktop() && root.dataset.sidebar === 'collapsed';

  // On blog pages the sidebar starts minimised. That choice is not saved, so other pages keep your own setting.
  const persist = !window.location.pathname.startsWith('/blog');

  function setCollapsed(collapsed: boolean) {
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    if (persist) localStorage.setItem('dealssite_sidebar', collapsed ? 'collapsed' : 'open');
  }

  function openDrawer() {
    if (sidebar) sidebar.style.top = '0px';
    root.dataset.sidebarOpen = '';
  }
  function closeDrawer() {
    delete root.dataset.sidebarOpen;
  }

  // Delegated listeners so menu toggle & backdrop close always work after any ViewTransitions navigation
  if (!(window as any).__dsSidebarBound) {
    (window as any).__dsSidebarBound = true;
    document.addEventListener('click', (event) => {
      const target = event.target as HTMLElement | null;
      if (!target) return;
      if (target.closest('[data-menu-toggle]')) {
        if (isDesktop()) setCollapsed(!isCollapsed());
        else if ('sidebarOpen' in root.dataset) closeDrawer();
        else openDrawer();
        return;
      }
      if (target.closest('[data-sidebar-close]')) {
        closeDrawer();
      }
    });
  }

  // Highlight active link matching current path (updates smoothly without reloading sidebar)
  function syncSidebarActive() {
    const currentPath = window.location.pathname;
    const currentFull = window.location.pathname + window.location.search;
    document.querySelectorAll<HTMLElement>('[data-sb-summary]').forEach((s) => delete s.dataset.ancestor);
    document.querySelectorAll<HTMLAnchorElement>('[data-sb-link]').forEach((a) => {
      delete a.dataset.active;
      const href = a.getAttribute('href') || '';
      const exact = href === currentFull || (href === '/' && currentFull === '/');
      const pathMatch = !href.includes('?') && (href === currentPath || (href !== '/' && currentPath.startsWith(href) && !window.location.search));
      if (exact || pathMatch) {
        a.dataset.active = 'true';
        const details = a.closest('details');
        if (details) {
          details.open = true;
          const summaryLink = details.querySelector<HTMLElement>('[data-sb-summary]');
          if (summaryLink) summaryLink.dataset.ancestor = 'true';
        }
      }
    });
    closeDrawer();
  }

  document.addEventListener('astro:page-load', syncSidebarActive);

  let cachedDealsMeta: any[] | null = null;
  let cachedBrandsMeta: any[] | null = null;

  // Update sidebar counts dynamically based on the active country (market) and non-expired deals
  function updateSidebarCounts() {
    if (!sidebar) return;
    try {
      if (!cachedDealsMeta) cachedDealsMeta = JSON.parse(sidebar.dataset.dealsMeta || '[]');
      if (!cachedBrandsMeta) cachedBrandsMeta = JSON.parse(sidebar.dataset.brandsMeta || '[]');
      const market = root.dataset.activeMarket || 'ALL';
      const now = Date.now();
      const deals = cachedDealsMeta!.filter((d) => {
        if (d.ed) {
          const t = Date.parse(d.ed);
          if (!Number.isNaN(t) && t < now) return false;
        }
        return market === 'ALL' || d.m === market || d.m === 'GLOBAL';
      });
      const brands = cachedBrandsMeta!.filter(
        (b) => market === 'ALL' || b.m === market || b.m === 'GLOBAL'
      );

      const map: Record<string, number> = {
        all: deals.length,
        trending: deals.filter((d) => d.t).length,
        brands: brands.length,
        trial: deals.filter((d) => d.k === 'trial').length,
        'promo-code': deals.filter((d) => d.k === 'promo').length,
        voucher: deals.filter((d) => d.k === 'voucher').length,
        'store-sale': deals.filter((d) => d.s).length,
        'bank-deals': deals.filter((d) => d.b).length,
      };

      document.querySelectorAll<HTMLElement>('[data-sb-count]').forEach((el) => {
        const key = el.dataset.sbCount || '';
        if (key in map) el.textContent = String(map[key]);
      });
      document.querySelectorAll<HTMLElement>('[data-sb-cat-count]').forEach((el) => {
        const cat = el.dataset.sbCatCount || '';
        el.textContent = String(deals.filter((d) => d.c === cat).length);
      });
    } catch {}
  }

  window.addEventListener('dealssite:market-updated', updateSidebarCounts);
  updateSidebarCounts();
</script>
