---
import Icon from './Icon.astro';
import { categories } from '../../data/taxonomy';
import { getCollection } from 'astro:content';
import { dealKind } from '../../lib/deals';

interface Props {
  activeCategory?: string;
  activeTopic?: string;
}

const allDeals = await getCollection('deals', ({ data }) => data.status === 'active');
const allBrands = await getCollection('brands');

const counts: Record<string, number> = {
  'all': allDeals.length,
  'trending': allDeals.filter((d) => d.data.is_trending).length,
  'brands': allBrands.length,
  'trial': allDeals.filter((d) => dealKind(d.data) === 'trial').length,
  'promo-code': allDeals.filter((d) => dealKind(d.data) === 'promo').length,
  'voucher': allDeals.filter((d) => dealKind(d.data) === 'voucher').length,
  'store-sale': allDeals.filter((d) => d.data.deal_type === 'in-store' || (d.data.channels || []).includes('in-store')).length,
  'bank-deals': allDeals.filter((d) => !!d.data.bank_details).length,
};

const categoryCounts = new Map<string, number>();
categories.forEach((cat) => {
  categoryCounts.set(cat.id, allDeals.filter((d) => d.data.category === cat.id).length);
});

const quickLinks = [
  { label: 'All offers', href: '/', icon: 'grid', key: 'all' },
  { label: 'Trending', href: '/?type=trending', icon: 'trending', key: 'trending' },
  { label: 'Browse Brands', href: '/brands', icon: 'store', key: 'brands' },
  { label: 'Free trials', href: '/?type=trial', icon: 'sparkle', key: 'trial' },
  { label: 'Promo codes', href: '/?type=promo-code', icon: 'tag', key: 'promo-code' },
  { label: 'Vouchers', href: '/?type=voucher', icon: 'tag', key: 'voucher' },
  { label: 'Store sales', href: '/?type=store-sale', icon: 'store', key: 'store-sale' },
  { label: 'Bank deals', href: '/banks', icon: 'card', key: 'bank-deals' },
];

const filterHref = (categoryId: string, groupId: string, filter: { sub?: string; kind?: string }) => {
  const params = new URLSearchParams({ group: groupId });
  if (filter.sub) params.set('sub', filter.sub);
  if (filter.kind) params.set('kind', filter.kind);
  return `/categories/${categoryId}?${params.toString()}`;
};
---

<div id="sidebar-backdrop" class="fixed inset-0 z-[25] bg-black/40" data-sidebar-close></div>

<aside id="app-sidebar" class="flex flex-col border-r editorial-rule bg-base-950" aria-label="Site navigation">
  <div class="min-h-0 flex-1 overflow-y-auto px-2 pb-8">
    <nav class="space-y-0.5 pt-3" aria-label="Offer types">
      {quickLinks.map((link) => (
        <a href={link.href} data-sb-link class="sb-link group" title={link.label}>
          <Icon name={link.icon} class="h-[18px] w-[18px] shrink-0" />
          <span class="sb-label truncate">{link.label}</span>
          <span class="sb-badge ml-auto rounded-full bg-base-900 border editorial-rule px-2 py-0.5 text-[11px] font-mono font-medium text-ink-muted group-hover:text-ink">
            {counts[link.key] ?? 0}
          </span>
        </a>
      ))}
    </nav>

    <p class="sb-heading mb-2 mt-7 px-3 text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Categories</p>

    <nav class="space-y-0.5" aria-label="Categories">
      {categories.map((category) => (
        <details class="sb-cat group" data-category={category.id}>
          <summary class="sb-link cursor-pointer list-none group" data-sb-summary title={category.name}>
            <Icon name={category.icon} class="h-[18px] w-[18px] shrink-0" />
            <span class="sb-label flex-1 truncate">{category.name}</span>
            <span class="sb-badge mr-1 rounded-full bg-base-900 border editorial-rule px-2 py-0.5 text-[11px] font-mono font-medium text-ink-muted group-hover:text-ink">
              {categoryCounts.get(category.id) ?? 0}
            </span>
            <Icon name="chevron" class="sb-chevron h-4 w-4 shrink-0 text-ink-muted" />
          </summary>

          <div class="sb-nested ml-[1.4rem] border-l editorial-rule pl-2">
            <a href={`/categories/${category.id}`} data-sb-link class="sb-link">
              All {category.name}
            </a>

            {category.groups.map((group) => (
              <details class="sb-group" data-group={group.id}>
                <summary class="sb-link cursor-pointer list-none" data-sb-summary>
                  <span class="flex-1 truncate">{group.label}</span>
                  <Icon name="chevron" class="h-3.5 w-3.5 shrink-0 text-ink-muted" />
                </summary>
                <div class="ml-3 border-l editorial-rule pl-2">
                  {group.filters.map((filter) => (
                    <a href={filterHref(category.id, group.id, filter)} data-sb-link class="sb-link">
                      {filter.label}
                    </a>
                  ))}
                </div>
              </details>
            ))}
          </div>
        </details>
      ))}
    </nav>

    <div class="mt-6 border-t editorial-rule pt-4">
      <button type="button" data-notify-open class="sb-link" title="Notify me">
        <Icon name="bell" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate">Notify me</span>
      </button>
      <button type="button" data-theme-toggle class="sb-link mt-0.5" title="Switch light or dark mode">
        <span class="theme-icon-moon inline-flex"><Icon name="moon" class="h-[18px] w-[18px] shrink-0" /></span>
        <span class="theme-icon-sun"><Icon name="sun" class="h-[18px] w-[18px] shrink-0" /></span>
        <span class="sb-label theme-text-dark truncate">Dark mode</span>
        <span class="sb-label theme-text-light truncate">Light mode</span>
      </button>
      <button type="button" data-submit-open class="sb-link mt-0.5" title="Submit deal">
        <Icon name="plus" class="h-[18px] w-[18px] shrink-0" />
        <span class="sb-label truncate">Submit deal</span>
      </button>
    </div>
  </div>
</aside>

<script>
  const root = document.documentElement;
  const sidebar = document.getElementById('app-sidebar');
  const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
  const isCollapsed = () => isDesktop() && root.dataset.sidebar === 'collapsed';

  // On blog pages the sidebar starts minimised. That choice is not saved, so other pages keep your own setting.
  const persist = !window.location.pathname.startsWith('/blog');

  function setCollapsed(collapsed: boolean) {
    if (collapsed) root.dataset.sidebar = 'collapsed';
    else delete root.dataset.sidebar;
    if (persist) localStorage.setItem('dealssite_sidebar', collapsed ? 'collapsed' : 'open');
  }

  const header = document.querySelector('header');
  function openDrawer() {
    // The drawer starts right under the header, so the cross button stays visible and clickable.
    if (sidebar && header) sidebar.style.top = `${Math.round(header.getBoundingClientRect().bottom)}px`;
    root.dataset.sidebarOpen = '';
  }
  function closeDrawer() {
    delete root.dataset.sidebarOpen;
  }

  // Header menu button: collapses or expands the desktop rail, opens or closes the mobile drawer
  document.querySelectorAll('[data-menu-toggle]').forEach((el) =>
    el.addEventListener('click', () => {
      if (isDesktop()) setCollapsed(!isCollapsed());
      else if ('sidebarOpen' in root.dataset) closeDrawer();
      else openDrawer();
    })
  );

  document.querySelectorAll('[data-sidebar-close]').forEach((el) => el.addEventListener('click', closeDrawer));

  // Highlight active link matching current path
  const currentPath = window.location.pathname;
  document.querySelectorAll<HTMLAnchorElement>('[data-sb-link]').forEach((a) => {
    const href = a.getAttribute('href');
    if (href === currentPath || (href && href !== '/' && currentPath.startsWith(href))) {
      a.dataset.active = 'true';
      const details = a.closest('details');
      if (details) {
        details.open = true;
        const summaryLink = details.querySelector<HTMLElement>('[data-sb-summary]');
        if (summaryLink) summaryLink.dataset.ancestor = 'true';
      }
    }
  });
</script>
