---

{
  outline ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      set:html={outline}
    />
  ) : (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path fill-rule={name === 'ai' ? 'evenodd' : undefined} d={filled[name] || filled.grid} />
    </svg>
  )
}
