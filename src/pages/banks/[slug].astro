---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealBannerCard from '../../components/deals/DealBannerCard.astro';
import BrandMark from '../../components/common/BrandMark.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const banks = await getCollection('banks');
  const deals = await getCollection('deals', ({ data }) => data.status === 'active');
  const brands = await getCollection('brands');
  const brandMap = new Map(brands.map((b) => [b.data.id, b.data]));

  return banks.map((bank) => {
    const bankDeals = deals.filter((d) => d.data.bank_details?.bank_id === bank.data.id);
    return {
      params: { slug: bank.data.short_code },
      props: { bank: bank.data, deals: bankDeals, brandMap },
    };
  });
}

const { bank, deals, brandMap } = Astro.props;
---

<BaseLayout
  title={`${bank.name} Card Discounts`}
  description={`Active retail and fashion discounts on ${bank.name} debit and credit cards.`}
>
  <div class="mb-8 border-b editorial-rule pb-8">
    <nav class="mb-4 flex items-center gap-2 text-[13px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">{bank.name}</span>
    </nav>

    <div class="flex items-start gap-4">
      <BrandMark name={bank.name} logoUrl={bank.logo_url} size="lg" />
      <div>
        <h1 class="text-4xl sm:text-5xl leading-none text-ink">{bank.name}</h1>
        <p class="mt-2 text-[14.5px] text-ink-muted">Helpline: {bank.helpline_number}</p>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2">
      {bank.supported_card_tiers.map((tier) => (
        <span class="editorial-pill px-3.5 py-1 text-[13px] text-ink">
          {tier}
        </span>
      ))}
    </div>
  </div>

  <div>
    {deals.length > 0 ? (
      deals.map((deal) => (
        <DealBannerCard
          deal={deal.data}
          brandName={brandMap.get(deal.data.brand_id)?.name}
          brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
        />
      ))
    ) : (
      <div class="border-t border-b editorial-rule py-12 text-center text-[15px] text-ink-muted">
        No active card discounts listed for {bank.name} right now.
      </div>
    )}
  </div>
</BaseLayout>
