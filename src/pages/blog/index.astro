---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.is_published);
---

<BaseLayout title="Blog" description="Practical shopping and savings articles.">
  <div class="mb-10 max-w-2xl">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-blue">Blog</p>
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Useful reads for smarter shopping</h1>
    <p class="mt-3 text-sm leading-6 text-gray-400">Clear comparisons, local deal roundups and practical buying advice.</p>
  </div>

  <div class="grid gap-5 md:grid-cols-2">
    {allPosts.map((post) => (
      <article data-market={post.data.target_country} class="group overflow-hidden rounded-2xl bg-base-900 transition-colors hover:bg-base-800">
        <a href={`/blog/${post.slug}`} class="block aspect-[16/8] overflow-hidden">
          <img
            src={post.data.hero_image}
            alt={post.data.title}
            class="h-full w-full object-cover opacity-80 transition-transform duration-300 group-hover:scale-[1.02]"
            loading="lazy"
          />
        </a>
        <div class="p-5">
          <p class="mb-2 text-[10px] uppercase tracking-wide text-brand-blue">
            {post.data.target_country === 'GLOBAL' ? 'Global' : post.data.target_country} · {post.data.published_date.split('T')[0]}
          </p>
          <h2 class="text-lg font-bold leading-snug text-white">
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </h2>
          <p class="mt-2 line-clamp-3 text-xs leading-relaxed text-gray-500">{post.data.description}</p>
          <a href={`/blog/${post.slug}`} class="mt-5 inline-flex items-center gap-1.5 text-xs font-bold text-brand-blue">
            Read article
            <Icon name="arrow" class="h-3.5 w-3.5" />
          </a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
