---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => data.is_published);
---

<BaseLayout title="Editorial Blog" description="Practical shopping calendars, card comparisons, and brand discount guides.">
  <div class="mb-10 border-b editorial-rule pb-8">
    <nav class="mb-3 flex items-center gap-2 text-[13px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">Blog</span>
    </nav>
    <h1 class="text-4xl sm:text-6xl leading-[0.98] text-ink">Editorial Journal</h1>
    <p class="mt-3 max-w-2xl text-[15.5px] leading-relaxed text-ink-muted">
      Clear sale calendars, card discount comparisons, and practical notes on shopping smarter.
    </p>
  </div>

  <div class="grid border-l border-t editorial-rule md:grid-cols-2">
    {allPosts.map((post) => (
      <article
        data-market={post.data.target_country}
        class="group flex flex-col justify-between border-b border-r editorial-rule transition-colors hover:bg-base-900/60"
      >
        <div>
          <a href={`/blog/${post.slug}`} class="block aspect-[16/9] overflow-hidden border-b editorial-rule bg-base-900">
            <img
              src={post.data.hero_image}
              alt={post.data.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="p-6">
            <p class="mb-2 text-[12.5px] font-medium text-ink-muted">
              {post.data.published_date.split('T')[0]} · {post.data.target_country === 'GLOBAL' ? 'Global' : post.data.target_country}
            </p>
            <h2 class="text-3xl leading-snug text-ink group-hover:underline">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>
            <p class="mt-2.5 text-[15px] leading-relaxed text-ink-muted">{post.data.description}</p>
          </div>
        </div>
        <div class="px-6 pb-6">
          <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-2 text-[14px] font-semibold text-ink hover:underline">
            <span>Read Article</span>
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
