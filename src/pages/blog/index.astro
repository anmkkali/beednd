---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => data.is_published)).sort((a, b) =>
  b.data.published_date.localeCompare(a.data.published_date)
);
---

<BaseLayout title="Blog" description="Shopping calendars, discount guides and practical tips for saving money.">
  <div class="mb-8 border-b editorial-rule pb-8">
    <nav class="mb-3 flex items-center gap-2 text-[13.5px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">Blog</span>
    </nav>
    <h1 class="text-5xl leading-[0.98] text-ink sm:text-6xl">Blog</h1>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
      Sale calendars, card discount comparisons and practical notes on shopping smarter.
    </p>
  </div>

  <div class="grid border-l border-t editorial-rule sm:grid-cols-2 xl:grid-cols-3">
    {allPosts.map((post) => (
      <article data-market={post.data.target_country} class="group flex flex-col border-b border-r editorial-rule transition-colors hover:bg-base-900/60">
        <a href={`/blog/${post.slug}`} class="block aspect-[16/10] overflow-hidden border-b editorial-rule bg-base-900">
          <img
            src={post.data.hero_image}
            alt={post.data.title}
            width="600"
            height="375"
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="flex flex-1 flex-col p-5">
          <p class="mb-2 text-[12.5px] font-medium text-ink-muted">{post.data.published_date.split('T')[0]}</p>
          <h2 class="text-[26px] leading-[1.12] text-ink group-hover:underline">
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </h2>
          <p class="mt-2 text-[14.5px] leading-relaxed text-ink-muted">{post.data.description}</p>
          <a href={`/blog/${post.slug}`} class="mt-auto inline-flex items-center gap-2 pt-5 text-[14px] font-semibold text-ink hover:underline">
            Read article
            <Icon name="arrow" class="h-4 w-4" />
          </a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
