---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/ads/AdSlot.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.is_published);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: {
      post,
      relatedPosts: posts
        .filter((p) => p.slug !== post.slug)
        .sort((a, b) => b.data.published_date.localeCompare(a.data.published_date))
        .slice(0, 3),
    },
  }));
}

const { post, relatedPosts } = Astro.props;
const { Content } = await post.render();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: post.data.hero_image,
  datePublished: post.data.published_date,
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  image={post.data.hero_image}
  structuredData={structuredData}
  showBottom={false}
>
  <article class="mx-auto max-w-4xl">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-[13px] text-ink-muted">
      <nav class="flex items-center gap-2" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink hover:underline">Home</a>
        <span>/</span>
        <a href="/blog/" class="hover:text-ink hover:underline">Blog &amp; articles</a>
      </nav>
      <span>{post.data.published_date.split('T')[0]}</span>
    </div>

    <div class="mb-8 aspect-[16/9] max-h-[420px] w-full overflow-hidden border editorial-rule bg-base-900">
      <img
        src={post.data.hero_image}
        alt={post.data.title}
        class="h-full w-full object-cover"
        decoding="async"
        onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
      />
      <div class="hidden h-full w-full items-center justify-center bg-base-900 p-8 text-center">
        <span class="font-serif text-2xl text-ink-muted">{post.data.title}</span>
      </div>
    </div>

    <header class="mb-8 border-b editorial-rule pb-8 md:pl-[30%]">
      <h1 class="text-4xl leading-[1.03] text-ink sm:text-5xl lg:text-[54px]">
        {post.data.title}
      </h1>
      <p class="mt-4 max-w-xl text-[16px] leading-relaxed text-ink-muted">
        {post.data.description}
      </p>
    </header>

    <div class="editorial-prose editorial-staggered max-w-none">
      <Content />
    </div>
  </article>

  <div class="mx-auto mt-10 max-w-4xl">
    <AdSlot slotType="leaderboard" />
  </div>

  {relatedPosts.length > 0 && (
    <section class="mx-auto mt-12 max-w-4xl border-t editorial-rule pt-8" aria-labelledby="more-articles-heading">
      <div class="mb-5 flex items-end justify-between border-b editorial-rule pb-2.5">
        <div>
          <p class="text-[11.5px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Journal</p>
          <h2 id="more-articles-heading" class="mt-1 text-3xl text-ink">From the blog</h2>
        </div>
        <a href="/blog/" class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-ink hover:underline">
          All posts
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {relatedPosts.map((rel) => (
          <a
            href={`/blog/${rel.slug}/`}
            data-market={rel.data.target_country}
            class="group flex flex-col border editorial-rule bg-base-900/30 transition-colors hover:bg-base-900/70"
          >
            <div class="aspect-[16/9] overflow-hidden border-b editorial-rule bg-base-900">
              <img
                src={rel.data.hero_image}
                alt={rel.data.title}
                width="600"
                height="338"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                loading="lazy"
                decoding="async"
                onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
              />
              <div class="hidden h-full w-full items-center justify-center bg-base-900 p-4 text-center">
                <span class="font-serif text-base text-ink-muted line-clamp-2">{rel.data.title}</span>
              </div>
            </div>
            <div class="flex flex-1 flex-col p-4">
              <h3 class="line-clamp-2 text-[20px] leading-[1.18] text-ink group-hover:underline">{rel.data.title}</h3>
              <p class="mt-1.5 line-clamp-1 text-[13.5px] leading-snug text-ink-muted">{rel.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1.5 pt-3 text-[13px] font-semibold text-ink group-hover:underline">
                Read article
                <Icon name="arrow" class="h-3.5 w-3.5" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style is:global>
  @media (min-width: 768px) {
    .editorial-staggered > h2:nth-of-type(odd),
    .editorial-staggered > h2:nth-of-type(odd) + p,
    .editorial-staggered > h2:nth-of-type(odd) + p + ul,
    .editorial-staggered > h2:nth-of-type(odd) + p + ol,
    .editorial-staggered > h2:nth-of-type(odd) + ul,
    .editorial-staggered > h2:nth-of-type(odd) + ol {
      margin-left: 34%;
    }
    .editorial-staggered > h2:nth-of-type(even),
    .editorial-staggered > h2:nth-of-type(even) + p,
    .editorial-staggered > h2:nth-of-type(even) + p + ul,
    .editorial-staggered > h2:nth-of-type(even) + p + ol,
    .editorial-staggered > h2:nth-of-type(even) + ul,
    .editorial-staggered > h2:nth-of-type(even) + ol {
      max-width: 36rem;
    }
  }
</style>
