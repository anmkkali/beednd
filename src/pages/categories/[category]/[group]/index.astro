---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import DealBannerCard from '../../../../components/deals/DealBannerCard.astro';
import BrandMark from '../../../../components/common/BrandMark.astro';
import Pagination from '../../../../components/common/Pagination.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../../../data/taxonomy';
import { dealTokens } from '../../../../lib/deals';

export async function getStaticPaths() {
  const nowMs = Date.now();
  const allDeals = (await getCollection('deals', ({ data }) => data.status === 'active')).filter(
    (d) => !d.data.end_date || Number.isNaN(Date.parse(d.data.end_date)) || Date.parse(d.data.end_date) >= nowMs
  );
  const allBrands = await getCollection('brands');
  const brandMap = new Map(allBrands.map((b) => [b.data.id, b.data]));

  const paths: any[] = [];
  for (const category of categories) {
    for (const group of category.groups) {
      const deals = allDeals
        .filter((d) => {
          if (d.data.category !== category.id) return false;
          const t = dealTokens(d.data);
          return t.includes(`|${group.id}|`);
        })
        .sort((a, b) => Number(b.data.is_sponsored) - Number(a.data.is_sponsored));

      const brandIds = new Set(deals.map((d) => d.data.brand_id));
      const groupBrands = allBrands.filter((b) => brandIds.has(b.data.id));

      paths.push({
        params: { category: category.id, group: group.id },
        props: { category, group, deals, groupBrands, brandMap },
      });
    }
  }
  return paths;
}

const { category, group, deals, groupBrands, brandMap } = Astro.props;
---

<BaseLayout
  title={`${group.label} — ${category.name} Discounts`}
  description={`Browse verified ${group.label.toLowerCase()} discounts, promo codes and deals in ${category.name}.`}
  activeTopic={category.id}
  noindex={deals.length === 0}
>
  <div class="mb-6 border-b editorial-rule pb-6">
    <nav class="mb-4 flex flex-wrap items-center gap-2 text-[13.5px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <a href={`/categories/${category.id}/`} class="hover:text-ink hover:underline">{category.name}</a>
      <span>/</span>
      <span class="text-ink">{group.label}</span>
    </nav>
    <h1 class="text-4xl leading-[1.02] text-ink sm:text-5xl">{group.label}</h1>
    <p class="mt-3 max-w-2xl text-[15.5px] leading-relaxed text-ink-muted">
      Verified {group.label.toLowerCase()} offers and participating brands in {category.name}.
    </p>
  </div>

  {groupBrands.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-2xl sm:text-3xl text-ink">Brands</h2>
      <div class="grid grid-cols-2 border-l border-t editorial-rule sm:grid-cols-4">
        {groupBrands.map((brand) => (
          <a
            href={`/brands/${brand.data.slug}/`}
            data-market={brand.data.country}
            class="flex items-center gap-3 border-b border-r editorial-rule p-3 transition-colors hover:bg-base-900/70 sm:p-4"
          >
            <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="sm" />
            <span class="truncate text-[14px] font-semibold text-ink">{brand.data.name}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section>
    <h2 class="mb-2 text-2xl sm:text-3xl text-ink">Offers</h2>
    <div id="group-deals" class="scroll-mt-24 border-t editorial-rule">
      {deals.map((deal) => (
        <div data-market={deal.data.country}>
          <DealBannerCard
            deal={deal.data}
            brandName={brandMap.get(deal.data.brand_id)?.name}
            brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
          />
        </div>
      ))}
    </div>
    {deals.length === 0 && (
      <p class="border-b editorial-rule py-12 text-center text-[15px] text-ink-muted">
        No active offers in {group.label} for your country yet.
      </p>
    )}
    <Pagination target="group-deals" />
  </section>
</BaseLayout>
