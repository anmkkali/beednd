---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealBannerCard from '../../components/deals/DealBannerCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const categories = [
    'clothing-fashion',
    'tech-electronics',
    'hosting-software',
    'food-dining',
    'beauty-wellness',
    'travel-lifestyle',
    'groceries-essentials'
  ];
  const allDeals = await getCollection('deals');
  const allBrands = await getCollection('brands');
  const brandMap = new Map(allBrands.map(b => [b.data.id, b.data]));

  return categories.map(cat => {
    const catDeals = allDeals.filter(d => d.data.category === cat);
    const categoryBrands = allBrands.filter(brand => brand.data.categories.includes(cat));
    return {
      params: { category: cat },
      props: { 
        categoryName: cat.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' & '),
        categoryId: cat,
        deals: catDeals,
        categoryBrands,
        brandMap
      }
    };
  });
}

const { categoryName, categoryId, deals, categoryBrands, brandMap } = Astro.props;
---

<BaseLayout 
  title={`${categoryName} Promo Codes & Deals`}
  description={`Browse verified ${categoryName} coupon codes, discounts, and store sales.`}
  activeTopic={categoryId}
>
  <div class="mb-8 max-w-3xl">
    <div class="flex items-center space-x-2 text-xs text-gray-500 mb-1">
      <a href="/" class="hover:text-brand-blue">Home</a>
      <span>/</span>
      <a href="/categories" class="hover:text-brand-blue">Categories</a>
      <span>/</span>
      <span class="text-gray-300">{categoryName}</span>
    </div>
    
    <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white">
      {categoryName} deals
    </h1>
    <p class="text-xs sm:text-sm text-gray-400 mt-1">
      Browse brands and current offers in {categoryName.toLowerCase()}.
    </p>
  </div>

  {categoryBrands.length > 0 && (
    <section class="mb-10">
      <h2 class="mb-4 text-sm font-bold text-white">Brands in this category</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {categoryBrands.map(brand => (
          <a
            href={`/brands/${brand.data.slug}`}
            data-market={brand.data.country}
            class="flex items-center gap-3 rounded-xl bg-base-900 p-3 hover:bg-base-800"
          >
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-white p-1.5">
              <img src={brand.data.logo_url} alt="" class="h-full w-full object-contain" />
            </span>
            <span class="truncate text-xs font-bold text-white">{brand.data.name}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <h2 class="mb-4 text-sm font-bold text-white">Current offers</h2>
  <div class="space-y-3">
    {deals.length > 0 ? (
      deals.map(deal => (
        <DealBannerCard 
          deal={deal.data} 
          brandName={brandMap.get(deal.data.brand_id)?.name}
          brandLogo={brandMap.get(deal.data.brand_id)?.logo_url} 
        />
      ))
    ) : (
      <div class="rounded-xl bg-base-900 p-8 text-center text-gray-500">
        No active deals currently in {categoryName}.
      </div>
    )}
  </div>
</BaseLayout>
