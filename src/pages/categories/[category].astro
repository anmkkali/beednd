---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealBannerCard from '../../components/deals/DealBannerCard.astro';
import BrandMark from '../../components/common/BrandMark.astro';
import Pagination from '../../components/common/Pagination.astro';
import { getCollection } from 'astro:content';
import { categories, ALL_KIND_LABELS } from '../../data/taxonomy';
import { dealKind, dealTokens } from '../../lib/deals';

export async function getStaticPaths() {
  const nowMs = Date.now();
  const allDeals = (await getCollection('deals', ({ data }) => data.status === 'active')).filter(
    (d) => !d.data.end_date || Number.isNaN(Date.parse(d.data.end_date)) || Date.parse(d.data.end_date) >= nowMs
  );
  const allBrands = await getCollection('brands');
  const brandMap = new Map(allBrands.map((b) => [b.data.id, b.data]));

  return categories.map((category) => {
    const catDeals = allDeals
      .filter((d) => d.data.category === category.id)
      // Sponsored and affiliate placements always lead the list.
      .sort((a, b) => Number(b.data.is_sponsored) - Number(a.data.is_sponsored));

    const brandTokensMap = new Map<string, string>();
    catDeals.forEach((d) => {
      const prev = brandTokensMap.get(d.data.brand_id) || '';
      brandTokensMap.set(d.data.brand_id, prev + dealTokens(d.data));
    });

    return {
      params: { category: category.id },
      props: {
        category,
        deals: catDeals,
        categoryBrands: allBrands.filter((b) => b.data.categories.includes(category.id) && brandTokensMap.has(b.data.id)),
        brandTokensMap,
        brandMap,
      },
    };
  });
}

const { category, deals, categoryBrands, brandTokensMap, brandMap } = Astro.props;

// Labels used for the "Showing" line. Filtering itself is driven by the sidebar links.
const subLabels: Record<string, string> = {};
category.groups.forEach((group) => group.filters.forEach((f) => f.sub && (subLabels[f.sub] ||= f.label)));
const labels = {
  groups: Object.fromEntries(category.groups.map((g) => [g.id, g.label])),
  subs: subLabels,
  kinds: ALL_KIND_LABELS,
};
---

<BaseLayout
  title={`${category.name} Discounts and Promo Codes`}
  description={`Browse ${category.name.toLowerCase()} brands, discounts and promo codes.`}
  activeTopic={category.id}
>
  <div class="mb-6 border-b editorial-rule pb-6">
    <nav class="mb-3 flex items-center gap-2 text-[13.5px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">{category.name}</span>
    </nav>
    <h1 class="text-5xl leading-[0.98] text-ink sm:text-6xl">{category.name}</h1>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-muted">{category.blurb}</p>
    <p id="filter-summary" data-labels={JSON.stringify(labels)} class="mt-4 hidden text-[14.5px] text-ink-muted">
      Showing <strong id="filter-text" class="text-ink"></strong>.
      <a href={`/categories/${category.id}`} class="ml-1 font-semibold text-ink underline">Clear filter</a>
    </p>
  </div>

  {categoryBrands.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 text-3xl text-ink">Brands</h2>
      <div class="grid grid-cols-2 border-l border-t editorial-rule sm:grid-cols-4">
        {categoryBrands.map((brand) => (
          <a
            href={`/brands/${brand.data.slug}`}
            data-cat-brand
            data-market={brand.data.country}
            data-brand-tokens={brandTokensMap.get(brand.data.id) || ''}
            class="flex items-center gap-3 border-b border-r editorial-rule p-3 transition-colors hover:bg-base-900/70 sm:p-4"
          >
            <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="sm" />
            <span class="truncate text-[14.5px] font-semibold text-ink">{brand.data.name}</span>
          </a>
        ))}
      </div>
      <button type="button" id="brands-more" class="btn-outline mt-3 hidden px-4 py-2 text-[13.5px] font-semibold"></button>
    </section>
  )}

  <section>
    <h2 class="mb-2 text-3xl text-ink">Offers</h2>
    <div id="category-deals" class="scroll-mt-24 border-t editorial-rule">
      {deals.map((deal) => (
        <div data-cat-deal data-market={deal.data.country} data-tokens={dealTokens(deal.data)} data-kind={dealKind(deal.data)}>
          <DealBannerCard
            deal={deal.data}
            brandName={brandMap.get(deal.data.brand_id)?.name}
            brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
          />
        </div>
      ))}
    </div>
    <p id="category-empty" class:list={['border-b editorial-rule py-12 text-center text-[15px] text-ink-muted', deals.length > 0 && 'hidden']}>
      No offers here yet for your country. Try another filter, or choose a different country.
    </p>
    <Pagination target="category-deals" />
  </section>

  <script>
    function initCategoryPage() {
      const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-deal]'));
      if (!rows.length && !document.getElementById('category-deals')) return;
      const emptyMsg = document.getElementById('category-empty');
      const summary = document.getElementById('filter-summary');
      const summaryText = document.getElementById('filter-text');

      // Show the first few brands, with a button for the rest
      const brandItems = Array.from(document.querySelectorAll<HTMLElement>('[data-cat-brand]'));
      const moreButton = document.getElementById('brands-more');
      const BRAND_LIMIT = 8;
      let brandsExpanded = false;

      function limitBrands() {
        if (!moreButton) return;
        brandItems.forEach((item) => item.classList.remove('brand-extra'));
        const shown = brandItems.filter((item) => !item.classList.contains('hidden') && item.getClientRects().length > 0);
        if (!brandsExpanded) shown.slice(BRAND_LIMIT).forEach((item) => item.classList.add('brand-extra'));
        moreButton.classList.toggle('hidden', shown.length <= BRAND_LIMIT);
        moreButton.textContent = brandsExpanded ? 'Show fewer brands' : `Show all ${shown.length} brands`;
      }
      moreButton?.addEventListener('click', () => {
        brandsExpanded = !brandsExpanded;
        limitBrands();
      });

      const params = new URLSearchParams(window.location.search);
      const group = params.get('group') || '';
      const sub = params.get('sub') || '';
      const kind = params.get('kind') || '';

      function apply() {
        rows.forEach((row) => {
          const tokens = row.dataset.tokens || '';
          const ok =
            (!group || tokens.includes(`|${group}|`) || tokens.includes('|all-items|')) &&
            (!sub || tokens.includes(`|${sub}|`) || tokens.includes('|all-items|')) &&
            (!kind || row.dataset.kind === kind);
          row.classList.toggle('hidden', !ok);
        });
        brandItems.forEach((b) => {
          const bTokens = b.dataset.brandTokens || '';
          const ok =
            (!group || bTokens.includes(`|${group}|`) || bTokens.includes('|all-items|')) &&
            (!sub || bTokens.includes(`|${sub}|`) || bTokens.includes('|all-items|'));
          b.classList.toggle('hidden', !ok);
        });
        const visibleRows = rows.some((row) => !row.classList.contains('hidden') && row.getClientRects().length > 0);
        emptyMsg?.classList.toggle('hidden', visibleRows);
        limitBrands();
        window.dispatchEvent(new CustomEvent('dealssite:list-changed'));
      }

      if (summary && summaryText) {
        if (group || sub || kind) {
          const labels = JSON.parse(summary.dataset.labels || '{}');
          const parts = [labels.groups?.[group], labels.subs?.[sub], labels.kinds?.[kind]].filter(Boolean);
          summaryText.textContent = parts.join(' / ');
          summary.classList.remove('hidden');
        } else {
          summary.classList.add('hidden');
        }
      }

      window.addEventListener('dealssite:market-updated', apply);
      apply();
    }

    document.addEventListener('astro:page-load', initCategoryPage);
  </script>

  <style is:global>
    .brand-extra {
      display: none !important;
    }
  </style>
</BaseLayout>
