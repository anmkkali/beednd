---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealBannerCard from '../components/deals/DealBannerCard.astro';
import BrandMark from '../components/common/BrandMark.astro';
import Pagination from '../components/common/Pagination.astro';
import Icon from '../components/common/Icon.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import { getCollection } from 'astro:content';
import { dealKind } from '../lib/deals';
import { categoryById } from '../data/taxonomy';

const allDeals = (await getCollection('deals', ({ data }) => data.status === 'active')).sort(
  (a, b) =>
    Number(b.data.is_trending) - Number(a.data.is_trending) ||
    b.data.last_verified_at.localeCompare(a.data.last_verified_at)
);
const allBrands = await getCollection('brands');
const brandMap = new Map(allBrands.map((brand) => [brand.data.id, brand.data]));
const withDeals = new Set(allDeals.map((deal) => deal.data.brand_id));
const localBrands = allBrands.filter((b) => b.data.country !== 'GLOBAL' && withDeals.has(b.data.id));
const globalBrands = allBrands.filter((b) => b.data.country === 'GLOBAL' && withDeals.has(b.data.id)).slice(0, 8);
const homeBrands = [...localBrands, ...globalBrands];

const brandHighlight = new Map<string, string>();
allDeals.forEach((deal) => {
  if (!brandHighlight.has(deal.data.brand_id)) brandHighlight.set(deal.data.brand_id, deal.data.discount_value);
});

const filterPills = [
  { label: 'All offers', value: 'all' },
  { label: 'Trending', value: 'trending' },
  { label: 'Free trials', value: 'trial' },
  { label: 'Promo codes', value: 'promo-code' },
  { label: 'Vouchers', value: 'voucher' },
  { label: 'Store sales', value: 'store-sale' },
  { label: 'Bank deals', value: 'bank-card' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DealsSite',
  url: 'https://dealssite.com',
};
---

<BaseLayout
  title="Discounts, Promo Codes and Free Trials"
  description="Browse current brand discounts, promo codes and free trials, automatically matched to your country."
  structuredData={structuredData}
>
  <section class="mb-8 border-b editorial-rule pb-8">
    <div class="mb-3 flex flex-wrap items-center justify-between gap-2 text-[13px] text-ink-muted">
      <span class="editorial-pill px-3 py-0.5 font-medium text-ink text-[12.5px]">Updated daily</span>
      <span id="hero-market-caption" class="font-medium text-[13px]">Offers for your location</span>
    </div>
    <!-- Two-column layout: text left, right reserved for future graphic -->
    <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:gap-10">
      <div class="lg:max-w-[55%]">
        <h1 class="text-[38px] font-serif leading-[1.05] text-ink sm:text-[48px] lg:text-[58px]">Everyday discounts, curated simply.</h1>
        <p class="mt-4 max-w-lg text-[14.5px] leading-relaxed text-ink-muted sm:text-[15.5px]">
          Brands and offers adjust to the country you open the site from. Browse by brand, category or city.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a href="/brands" class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 text-[13.5px] font-semibold">
            Browse Brands
            <Icon name="arrow" class="h-4 w-4" />
          </a>
          <a href="/blog" class="btn-outline inline-flex items-center gap-2 px-5 py-2.5 text-[13.5px] font-semibold">Read Blog</a>
        </div>
      </div>
      <!-- Right side: reserved for future graphic / illustration -->
      <div class="hidden lg:block lg:flex-1 lg:min-h-[160px]" aria-hidden="true"></div>
    </div>
  </section>

  <!-- Leaderboard Ad: Placed below Hero heading & description -->
  <div class="my-6">
    <AdSlot slotType="leaderboard" />
  </div>

  <section class="mb-4" aria-labelledby="brands-heading">
    <div class="mb-5 flex items-end justify-between gap-4 border-b editorial-rule pb-3">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Brands with offers</p>
        <h2 id="brands-heading" class="mt-1 text-3xl text-ink sm:text-4xl">Shop by brand</h2>
      </div>
      <div class="flex items-center gap-2">
        <button type="button" data-brand-prev class="icon-btn border editorial-rule inline-flex" aria-label="Previous brands" title="Previous brands">
          <Icon name="arrow" class="h-4 w-4 rotate-180" />
        </button>
        <button type="button" data-brand-next class="icon-btn border editorial-rule inline-flex" aria-label="Next brands" title="Next brands">
          <Icon name="arrow" class="h-4 w-4" />
        </button>
        <a href="/brands" class="inline-flex items-center gap-1.5 whitespace-nowrap text-[14px] sm:ml-1 font-semibold text-ink hover:underline">
          All brands
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>
    <div id="brand-track" class="brand-track flex overflow-x-auto border-l border-t editorial-rule">
      {homeBrands.map((brand) => (
        <a
          href={`/brands/${brand.data.slug}`}
          data-market={brand.data.country}
          data-brand-card
          class="group flex w-[10.5rem] shrink-0 flex-col justify-between border-b border-r editorial-rule p-4 transition-colors hover:bg-base-900/70 sm:w-[15rem] sm:p-5"
        >
          <div class="flex items-start justify-between gap-2">
            <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="md" />
            {brandHighlight.get(brand.data.id) && (
              <span class="editorial-pill whitespace-nowrap px-2 py-0.5 text-[11px] font-semibold text-ink">{brandHighlight.get(brand.data.id)}</span>
            )}
          </div>
          <div class="mt-4 sm:mt-5">
            <strong class="block truncate text-[15px] font-semibold text-ink group-hover:underline sm:text-[16px]">{brand.data.name}</strong>
            <span class="mt-0.5 block truncate text-[12.5px] text-ink-muted sm:text-[13px]">{categoryById.get(brand.data.categories[0])?.name}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="deals-heading">
    <div class="mb-3 flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Verified markdowns</p>
        <h2 id="deals-heading" class="mt-1 text-4xl text-ink">Active offers</h2>
      </div>
      <div class="flex flex-wrap gap-1.5" id="deal-type-filters">
        {filterPills.map((filter) => (
          <button
            type="button"
            data-type-filter={filter.value}
            aria-pressed={filter.value === 'all'}
            class:list={[
              'editorial-pill px-3.5 py-1.5 text-[13.5px] font-medium transition-colors',
              filter.value === 'all' ? 'btn-primary' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>

    <div id="deal-feed" class="scroll-mt-24 border-t editorial-rule">
      {allDeals.map((deal) => (
        <div
          data-deal-wrapper
          data-market={deal.data.country}
          data-deal-type={deal.data.deal_type}
          data-kind={dealKind(deal.data)}
          data-trending={deal.data.is_trending ? 'true' : 'false'}
          data-has-bank={deal.data.bank_details ? 'true' : 'false'}
        >
          <DealBannerCard
            deal={deal.data}
            brandName={brandMap.get(deal.data.brand_id)?.name}
            brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
          />
        </div>
      ))}
    </div>
    <p id="deals-empty-msg" class="hidden border-y editorial-rule py-10 text-center text-[15px] text-ink-muted">
      No offers match this filter for your country yet. Try "All offers" or change the country.
    </p>
    <Pagination target="deal-feed" />
  </section>

  <script>
    import { countryByCode } from '../data/countries';

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-type-filter]'));
    const wrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-deal-wrapper]'));
    const emptyMsg = document.getElementById('deals-empty-msg');
    const caption = document.getElementById('hero-market-caption');
    const shown = (el: Element) => getComputedStyle(el).display !== 'none';

    let current = 'all';

    function matches(wrapper: HTMLElement, type: string) {
      if (type === 'all') return true;
      if (type === 'trending') return wrapper.dataset.trending === 'true';
      if (type === 'trial') return wrapper.dataset.kind === 'trial';
      if (type === 'promo-code') return wrapper.dataset.kind === 'promo';
      if (type === 'voucher') return wrapper.dataset.kind === 'voucher';
      if (type === 'bank-card') return wrapper.dataset.hasBank === 'true';
      return wrapper.dataset.dealType === type;
    }

    function refresh() {
      wrappers.forEach((wrapper) => wrapper.classList.toggle('hidden', !matches(wrapper, current)));
      buttons.forEach((button) => {
        const active = button.dataset.typeFilter === current;
        button.classList.toggle('btn-primary', active);
        button.classList.toggle('text-ink-muted', !active);
        button.setAttribute('aria-pressed', String(active));
      });
      emptyMsg?.classList.toggle('hidden', wrappers.some(shown));
      window.dispatchEvent(new CustomEvent('dealssite:list-changed'));
      if (caption) {
        const market = document.documentElement.dataset.activeMarket || 'ALL';
        const name = countryByCode.get(market)?.name || market;
        caption.textContent = market === 'ALL' ? 'Offers from every country' : `Offers for ${name} and worldwide`;
      }
    }

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        current = button.dataset.typeFilter || 'all';
        const url = new URL(window.location.href);
        if (current === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', current);
        history.replaceState({}, '', url);
        refresh();
      })
    );

    window.addEventListener('dealssite:market-updated', refresh);
    current = new URLSearchParams(window.location.search).get('type') || 'all';
    refresh();
  </script>
</BaseLayout>

<script>
  // Brand strip: auto-drifts in continuous loop, pauses on hover / focus / touch, left/right buttons step smoothly
  const track = document.getElementById('brand-track');
  if (track) {
    const originalChildren = Array.from(track.children);
    // Duplicate cards twice to ensure smooth infinite loop
    for (let i = 0; i < 2; i++) {
      originalChildren.forEach((card) => {
        const clone = card.cloneNode(true) as HTMLElement;
        clone.setAttribute('aria-hidden', 'true');
        clone.tabIndex = -1;
        track.appendChild(clone);
      });
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let paused = false;
    let resumeTimer = 0;
    let pos = track.scrollLeft;
    let last = 0;

    const baseWidth = () => originalChildren.reduce((acc, el) => acc + (el as HTMLElement).offsetWidth, 0) || (track.scrollWidth / 3);

    const wrap = () => {
      const bw = baseWidth();
      if (bw <= 0) return;
      if (track.scrollLeft >= bw * 2) {
        track.scrollLeft -= bw;
        pos = track.scrollLeft;
      } else if (track.scrollLeft <= 0) {
        track.scrollLeft += bw;
        pos = track.scrollLeft;
      }
    };

    const hold = (ms = 0) => {
      paused = true;
      clearTimeout(resumeTimer);
      if (ms > 0) {
        resumeTimer = window.setTimeout(() => {
          paused = false;
          pos = track.scrollLeft;
        }, ms);
      }
    };

    const release = () => {
      clearTimeout(resumeTimer);
      paused = false;
      pos = track.scrollLeft;
    };

    track.addEventListener('mouseenter', () => hold(0));
    track.addEventListener('mouseleave', release);
    track.addEventListener('focusin', () => hold(0));
    track.addEventListener('focusout', release);
    track.addEventListener('touchstart', () => hold(4000), { passive: true });
    track.addEventListener('touchend', () => hold(1500), { passive: true });
    track.addEventListener('wheel', () => hold(2000), { passive: true });
    track.addEventListener('scroll', wrap, { passive: true });

    const step = () => (track.querySelector<HTMLElement>('[data-brand-card]')?.offsetWidth || 240) * 2;
    const prevBtn = document.querySelector('[data-brand-prev]');
    const nextBtn = document.querySelector('[data-brand-next]');

    prevBtn?.addEventListener('mouseenter', () => hold(0));
    prevBtn?.addEventListener('mouseleave', release);
    prevBtn?.addEventListener('click', () => {
      hold(2500);
      wrap();
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    nextBtn?.addEventListener('mouseenter', () => hold(0));
    nextBtn?.addEventListener('mouseleave', release);
    nextBtn?.addEventListener('click', () => {
      hold(2500);
      wrap();
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });

    const tick = (t: number) => {
      const dt = last ? Math.min(t - last, 64) : 16;
      last = t;
      if (!paused && !reduce && track.scrollWidth > track.clientWidth) {
        pos += dt * 0.075;
        track.scrollLeft = pos;
        wrap();
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
</script>
