---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealBannerCard from '../components/deals/DealBannerCard.astro';
import BrandMark from '../components/common/BrandMark.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import Icon from '../components/common/Icon.astro';
import { getCollection } from 'astro:content';
import { dealKind } from '../lib/deals';
import { categoryById } from '../data/taxonomy';

const allDeals = (await getCollection('deals', ({ data }) => data.status === 'active')).sort(
  (a, b) =>
    Number(b.data.is_trending) - Number(a.data.is_trending) ||
    b.data.last_verified_at.localeCompare(a.data.last_verified_at)
);
const allBrands = await getCollection('brands');
const allPosts = (await getCollection('blog', ({ data }) => data.is_published)).sort((a, b) =>
  b.data.published_date.localeCompare(a.data.published_date)
);
const brandMap = new Map(allBrands.map((brand) => [brand.data.id, brand.data]));

const brandHighlight = new Map<string, string>();
allDeals.forEach((deal) => {
  if (!brandHighlight.has(deal.data.brand_id)) brandHighlight.set(deal.data.brand_id, deal.data.discount_value);
});

const filterPills = [
  { label: 'All offers', value: 'all' },
  { label: 'Trending', value: 'trending' },
  { label: 'Free trials', value: 'trial' },
  { label: 'Promo codes', value: 'promo-code' },
  { label: 'Store sales', value: 'store-sale' },
  { label: 'Bank deals', value: 'bank-card' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DealsSite',
  url: 'https://dealssite.com',
};
---

<BaseLayout
  title="Discounts, Promo Codes and Free Trials"
  description="Browse current brand discounts, promo codes and free trials, automatically matched to your country."
  structuredData={structuredData}
>
  <section class="mb-12 border-b editorial-rule pb-10">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-[13.5px] text-ink-muted">
      <span class="editorial-pill px-3.5 py-1 font-medium text-ink">Updated daily</span>
      <span id="hero-market-caption" class="font-medium">Offers for your location</span>
    </div>
    <h1 class="text-5xl leading-[0.95] text-ink sm:text-7xl lg:text-[84px]">Everyday discounts, curated simply.</h1>
    <div class="mt-6 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <p class="max-w-xl text-[16px] leading-relaxed text-ink-muted">
        Brands and offers adjust to the country you open the site from. Browse by brand, category or city.
      </p>
      <div class="flex shrink-0 flex-wrap items-center gap-3">
        <a href="/brands" class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 text-[14px] font-semibold">
          Browse Brands
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/blog" class="btn-outline inline-flex items-center gap-2 px-5 py-2.5 text-[14px] font-semibold">Read Blog</a>
      </div>
    </div>
  </section>

  <section class="mb-4" aria-labelledby="brands-heading">
    <div class="mb-5 flex items-end justify-between gap-4 border-b editorial-rule pb-3">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Brands with offers</p>
        <h2 id="brands-heading" class="mt-1 text-4xl text-ink">Shop by brand</h2>
      </div>
      <a href="/brands" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-ink hover:underline">
        All brands
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <div class="grid grid-cols-2 border-l border-t editorial-rule sm:grid-cols-3 md:grid-cols-4">
      {allBrands.map((brand) => (
        <a
          href={`/brands/${brand.data.slug}`}
          data-market={brand.data.country}
          class="group flex flex-col justify-between border-b border-r editorial-rule p-5 transition-colors hover:bg-base-900/70"
        >
          <div class="flex items-start justify-between gap-2">
            <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="md" />
            {brandHighlight.get(brand.data.id) && (
              <span class="editorial-pill px-2.5 py-0.5 text-[11.5px] font-semibold text-ink">{brandHighlight.get(brand.data.id)}</span>
            )}
          </div>
          <div class="mt-5">
            <strong class="block text-[16px] font-semibold text-ink group-hover:underline">{brand.data.name}</strong>
            <span class="mt-0.5 block text-[13px] text-ink-muted">{categoryById.get(brand.data.categories[0])?.name}</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <AdSlot slotType="infeed" />

  <section aria-labelledby="deals-heading">
    <div class="mb-3 flex flex-col justify-between gap-4 lg:flex-row lg:items-end">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Verified markdowns</p>
        <h2 id="deals-heading" class="mt-1 text-4xl text-ink">Active offers</h2>
      </div>
      <div class="flex flex-wrap gap-1.5" id="deal-type-filters">
        {filterPills.map((filter) => (
          <button
            type="button"
            data-type-filter={filter.value}
            aria-pressed={filter.value === 'all'}
            class:list={[
              'editorial-pill px-3.5 py-1.5 text-[13.5px] font-medium transition-colors',
              filter.value === 'all' ? 'btn-primary' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>

    <div id="deal-feed">
      {allDeals.map((deal) => (
        <div
          data-deal-wrapper
          data-market={deal.data.country}
          data-deal-type={deal.data.deal_type}
          data-kind={dealKind(deal.data)}
          data-trending={deal.data.is_trending ? 'true' : 'false'}
          data-has-bank={deal.data.bank_details ? 'true' : 'false'}
        >
          <DealBannerCard
            deal={deal.data}
            brandName={brandMap.get(deal.data.brand_id)?.name}
            brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
          />
        </div>
      ))}
    </div>
    <p id="deals-empty-msg" class="hidden border-y editorial-rule py-10 text-center text-[15px] text-ink-muted">
      No offers match this filter for your country yet. Try "All offers" or change the country.
    </p>
  </section>

  <section class="mt-16" aria-labelledby="blog-heading">
    <div class="mb-6 flex items-end justify-between border-b editorial-rule pb-3">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Journal</p>
        <h2 id="blog-heading" class="mt-1 text-4xl text-ink">From the blog</h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-ink hover:underline">
        All posts
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>
    <div class="grid border-l border-t editorial-rule md:grid-cols-3">
      {allPosts.slice(0, 3).map((post) => (
        <a
          href={`/blog/${post.slug}`}
          data-market={post.data.target_country}
          class="group flex flex-col border-b border-r editorial-rule transition-colors hover:bg-base-900/60"
        >
          <div class="aspect-[16/10] overflow-hidden border-b editorial-rule bg-base-900">
            <img
              src={post.data.hero_image}
              alt={post.data.title}
              width="600"
              height="375"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-5">
            <p class="mb-2 text-[12.5px] font-medium text-ink-muted">{post.data.published_date.split('T')[0]}</p>
            <h3 class="text-[24px] leading-[1.15] text-ink group-hover:underline">{post.data.title}</h3>
            <p class="mt-2 line-clamp-3 text-[14.5px] leading-relaxed text-ink-muted">{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    import { countryByCode } from '../data/countries';

    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-type-filter]'));
    const wrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-deal-wrapper]'));
    const emptyMsg = document.getElementById('deals-empty-msg');
    const caption = document.getElementById('hero-market-caption');
    const shown = (el: Element) => getComputedStyle(el).display !== 'none';

    let current = 'all';

    function matches(wrapper: HTMLElement, type: string) {
      if (type === 'all') return true;
      if (type === 'trending') return wrapper.dataset.trending === 'true';
      if (type === 'trial') return wrapper.dataset.kind === 'trial';
      if (type === 'promo-code') return wrapper.dataset.kind === 'promo';
      if (type === 'bank-card') return wrapper.dataset.hasBank === 'true';
      return wrapper.dataset.dealType === type;
    }

    function refresh() {
      wrappers.forEach((wrapper) => wrapper.classList.toggle('hidden', !matches(wrapper, current)));
      buttons.forEach((button) => {
        const active = button.dataset.typeFilter === current;
        button.classList.toggle('btn-primary', active);
        button.classList.toggle('text-ink-muted', !active);
        button.setAttribute('aria-pressed', String(active));
      });
      emptyMsg?.classList.toggle('hidden', wrappers.some(shown));
      if (caption) {
        const market = document.documentElement.dataset.activeMarket || 'ALL';
        const name = countryByCode.get(market)?.name || market;
        caption.textContent = market === 'ALL' ? 'Offers from every country' : `Offers for ${name} and worldwide`;
      }
    }

    buttons.forEach((button) =>
      button.addEventListener('click', () => {
        current = button.dataset.typeFilter || 'all';
        const url = new URL(window.location.href);
        if (current === 'all') url.searchParams.delete('type');
        else url.searchParams.set('type', current);
        history.replaceState({}, '', url);
        refresh();
        window.dispatchEvent(new CustomEvent('dealssite:filters-changed'));
      })
    );

    window.addEventListener('dealssite:market-updated', refresh);
    current = new URLSearchParams(window.location.search).get('type') || 'all';
    refresh();
  </script>
</BaseLayout>
