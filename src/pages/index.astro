---
import BaseLayout from '../layouts/BaseLayout.astro';
import DealBannerCard from '../components/deals/DealBannerCard.astro';
import BrandMark from '../components/common/BrandMark.astro';
import Icon from '../components/common/Icon.astro';
import { getCollection } from 'astro:content';

const allDeals = await getCollection('deals', ({ data }) => data.status === 'active');
const allBrands = await getCollection('brands');
const allPosts = await getCollection('blog', ({ data }) => data.is_published);
const brandMap = new Map(allBrands.map((brand) => [brand.data.id, brand.data]));

const brandHighlight = new Map<string, string>();
allDeals.forEach((deal) => {
  if (!brandHighlight.has(deal.data.brand_id)) {
    brandHighlight.set(deal.data.brand_id, deal.data.discount_value);
  }
});

const filterPills = [
  { label: 'All Offers', value: 'all' },
  { label: 'Promo Codes', value: 'promo-code' },
  { label: 'Store Sales', value: 'store-sale' },
  { label: 'Bank Deals', value: 'bank-card' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DealsSite',
  url: 'https://dealssite.com',
};
---

<BaseLayout
  title="Curated Brand Discounts & Promo Codes"
  description="Discover active discounts, brand sales, and promo codes automatically matched to your country."
  structuredData={structuredData}
>
  <!-- Editorial Minimal Hero Inspired by Natural Muse -->
  <section class="mb-14 border-b editorial-rule pb-10">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-[13px] text-ink-muted">
      <span class="editorial-pill px-3.5 py-1 font-medium text-ink">Curated Savings Directory</span>
      <span id="hero-market-caption" class="font-medium">Showing offers for your location</span>
    </div>

    <h1 class="mt-4 text-5xl sm:text-7xl lg:text-[82px] leading-[0.94] tracking-tight text-ink">
      Everyday Discounts, Curated Simply.
    </h1>

    <div class="mt-6 flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <p class="max-w-xl text-[16px] leading-relaxed text-ink-muted">
        Brands and active markdowns automatically adjust to the country you open from. Browse by brand logo, category, or city without clutter.
      </p>
      <div class="flex flex-wrap items-center gap-3 shrink-0">
        <a href="/brands" class="btn-primary inline-flex items-center gap-2 px-5 py-2.5 text-[14px] font-semibold">
          <span>Browse Brands</span>
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href="/blog" class="btn-outline inline-flex items-center gap-2 px-5 py-2.5 text-[14px] font-semibold">
          <span>Read Blog</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Brands on Discount Grid (Logos + Active Discount Tag) -->
  <section class="mb-14" aria-labelledby="brands-heading">
    <div class="mb-5 flex items-end justify-between gap-4 border-b editorial-rule pb-3">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Brands on Sale</p>
        <h2 id="brands-heading" class="mt-1 text-3xl sm:text-4xl text-ink">Shop by Brand</h2>
      </div>
      <a href="/brands" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-ink hover:underline">
        <span>All Brands</span>
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid grid-cols-2 border-l border-t editorial-rule sm:grid-cols-3 md:grid-cols-4">
      {allBrands.map((brand) => (
        <a
          href={`/brands/${brand.data.slug}`}
          data-market={brand.data.country}
          class="group flex flex-col justify-between border-b border-r editorial-rule p-5 transition-colors hover:bg-base-900/70"
        >
          <div class="flex items-start justify-between gap-2">
            <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="md" />
            {brandHighlight.get(brand.data.id) && (
              <span class="editorial-pill px-2.5 py-0.5 text-[11.5px] font-semibold text-ink">
                {brandHighlight.get(brand.data.id)}
              </span>
            )}
          </div>

          <div class="mt-5">
            <strong class="block text-[16px] font-semibold text-ink group-hover:underline">
              {brand.data.name}
            </strong>
            <span class="mt-0.5 block text-[13px] text-ink-muted capitalize">
              {brand.data.categories[0]?.replaceAll('-', ' ')}
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Active Deals Feed -->
  <section aria-labelledby="deals-heading">
    <div class="mb-4 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Verified Markdowns</p>
        <h2 id="deals-heading" class="mt-1 text-3xl sm:text-4xl text-ink">Active Offers</h2>
      </div>

      <div class="flex flex-wrap gap-1.5" id="deal-type-filters">
        {filterPills.map((filter) => (
          <button
            type="button"
            data-type-filter={filter.value}
            class:list={[
              'px-3.5 py-1.5 text-[13.5px] font-medium transition-colors editorial-pill',
              filter.value === 'all' ? 'btn-primary' : 'text-ink-muted hover:text-ink',
            ]}
          >
            {filter.label}
          </button>
        ))}
      </div>
    </div>

    <div id="deal-feed">
      {allDeals.map((deal) => (
        <div
          data-deal-wrapper
          data-deal-type={deal.data.deal_type}
          data-has-bank={deal.data.bank_details ? 'true' : 'false'}
          data-market={deal.data.country}
        >
          <DealBannerCard
            deal={deal.data}
            brandName={brandMap.get(deal.data.brand_id)?.name}
            brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
          />
        </div>
      ))}
    </div>

    <p id="deals-empty-msg" class="hidden border-t border-b editorial-rule py-10 text-center text-[15px] text-ink-muted">
      No offers match this filter right now. Try selecting "All Offers".
    </p>
  </section>

  <!-- Bottom Blog Section -->
  <section class="mt-16 pt-4" aria-labelledby="blog-heading">
    <div class="mb-6 flex items-end justify-between border-b editorial-rule pb-3">
      <div>
        <p class="text-[12px] font-semibold uppercase tracking-[0.16em] text-ink-muted">Editorial Journal</p>
        <h2 id="blog-heading" class="mt-1 text-3xl sm:text-4xl text-ink">From the Blog</h2>
      </div>
      <a href="/blog" class="inline-flex items-center gap-1.5 text-[14px] font-semibold text-ink hover:underline">
        <span>View All Posts</span>
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    <div class="grid border-l border-t editorial-rule md:grid-cols-2">
      {allPosts.slice(0, 4).map((post) => (
        <a
          href={`/blog/${post.slug}`}
          data-market={post.data.target_country}
          class="group flex flex-col justify-between border-b border-r editorial-rule transition-colors hover:bg-base-900/60"
        >
          <div class="aspect-[16/9] overflow-hidden bg-base-900 border-b editorial-rule">
            <img
              src={post.data.hero_image}
              alt={post.data.title}
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-6">
            <div class="mb-2 flex items-center gap-2 text-[12.5px] font-medium text-ink-muted">
              <span>{post.data.published_date.split('T')[0]}</span>
              <span>·</span>
              <span>{post.data.target_country === 'GLOBAL' ? 'Global' : post.data.target_country}</span>
            </div>
            <h3 class="text-2xl sm:text-3xl leading-snug text-ink group-hover:underline">
              {post.data.title}
            </h3>
            <p class="mt-2.5 line-clamp-2 text-[15px] leading-relaxed text-ink-muted">
              {post.data.description}
            </p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <script>
    const typeButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-type-filter]'));
    const dealWrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-deal-wrapper]'));
    const emptyMsg = document.getElementById('deals-empty-msg');
    const marketCaption = document.getElementById('hero-market-caption');

    function checkVisibleDeals() {
      const anyVisible = dealWrappers.some(
        (el) => !el.classList.contains('hidden') && !el.classList.contains('market-hidden')
      );
      emptyMsg?.classList.toggle('hidden', anyVisible);

      if (marketCaption) {
        const m = document.documentElement.dataset.market || 'ALL';
        marketCaption.textContent =
          m === 'PK'
            ? 'Showing brands for Pakistan'
            : m === 'US'
            ? 'Showing brands for United States'
            : 'Showing international & local brands';
      }
    }

    function applyType(type: string) {
      dealWrappers.forEach((wrapper) => {
        const matches =
          type === 'all' ||
          wrapper.dataset.dealType === type ||
          (type === 'bank-card' && wrapper.dataset.hasBank === 'true');
        wrapper.classList.toggle('hidden', !matches);
      });
      typeButtons.forEach((button) => {
        const active = button.dataset.typeFilter === type;
        button.classList.toggle('btn-primary', active);
        button.classList.toggle('text-ink-muted', !active);
      });
      checkVisibleDeals();
    }

    typeButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.dataset.typeFilter || 'all';
        applyType(type);
        const url = new URL(window.location.href);
        type === 'all' ? url.searchParams.delete('type') : url.searchParams.set('type', type);
        history.replaceState({}, '', url);
      });
    });

    window.addEventListener('dealssite:market-updated', checkVisibleDeals);
    applyType(new URLSearchParams(window.location.search).get('type') || 'all');
  </script>
</BaseLayout>
