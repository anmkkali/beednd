---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DealBannerCard from '../../../components/deals/DealBannerCard.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cities = ['karachi', 'lahore', 'islamabad', 'rawalpindi'];
  const allDeals = await getCollection('deals', ({ data }) => data.status === 'active');
  const allBrands = await getCollection('brands');
  const brandMap = new Map(allBrands.map((b) => [b.data.id, b.data]));

  return cities.map((city) => {
    const cityDeals = allDeals.filter((d) =>
      d.data.cities.some((c) => c.toLowerCase() === city.toLowerCase())
    );
    return {
      params: { city },
      props: {
        citySlug: city,
        cityName: city.charAt(0).toUpperCase() + city.slice(1),
        deals: cityDeals,
        brandMap,
      },
    };
  });
}

const { citySlug, cityName, deals, brandMap } = Astro.props;
const allCities = [
  { slug: 'karachi', label: 'Karachi' },
  { slug: 'lahore', label: 'Lahore' },
  { slug: 'islamabad', label: 'Islamabad' },
  { slug: 'rawalpindi', label: 'Rawalpindi' },
];
---

<BaseLayout
  title={`${cityName} Store Sales & Discounts`}
  description={`Active mall outlet sales, brand markdowns, and card discounts in ${cityName}.`}
>
  <div class="mb-8 border-b editorial-rule pb-8">
    <nav class="mb-3 flex items-center gap-2 text-[13px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">{cityName}</span>
    </nav>

    <h1 class="text-4xl sm:text-6xl leading-[0.98] text-ink">
      {cityName} Offers
    </h1>
    <p class="mt-3 max-w-2xl text-[15.5px] leading-relaxed text-ink-muted">
      In-store outlet markdowns and brand promotions available across malls and shopping districts in {cityName}.
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {allCities.map((c) => (
        <a
          href={`/pakistan/${c.slug}`}
          class:list={[
            'editorial-pill px-4 py-1.5 text-[13.5px] font-medium transition-colors',
            c.slug === citySlug ? 'btn-primary' : 'text-ink-muted hover:text-ink',
          ]}
        >
          {c.label}
        </a>
      ))}
    </div>
  </div>

  <div>
    {deals.length > 0 ? (
      deals.map((deal) => (
        <DealBannerCard
          deal={deal.data}
          brandName={brandMap.get(deal.data.brand_id)?.name}
          brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
        />
      ))
    ) : (
      <div class="border-t border-b editorial-rule py-12 text-center text-[15px] text-ink-muted">
        No active in-store deals currently listed for {cityName}.
      </div>
    )}
  </div>
</BaseLayout>
