---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StackFinder from '../../components/deals/StackFinder.astro';
import BrandMark from '../../components/common/BrandMark.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const deals = await getCollection('deals');
  const brands = await getCollection('brands');
  const brandMap = new Map(brands.map((b) => [b.data.id, b.data]));

  return deals.map((deal) => ({
    params: { slug: deal.data.slug },
    props: {
      deal: deal.data,
      brand: brandMap.get(deal.data.brand_id),
    },
  }));
}

const { deal, brand } = Astro.props;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Offer',
  name: deal.title,
  description: deal.short_description,
  category: deal.category,
  url: deal.affiliate_url,
};
---

<BaseLayout
  title={`${deal.title} — ${brand?.name || ''}`}
  description={deal.short_description}
  structuredData={structuredData}
>
  <!-- Breadcrumb -->
  <nav class="mb-6 flex flex-wrap items-center gap-2 text-[13px] text-ink-muted" aria-label="Breadcrumb">
    <a href="/" class="hover:text-ink hover:underline">Home</a>
    <span>/</span>
    <a href={`/categories/${deal.category}`} class="capitalize hover:text-ink hover:underline">
      {deal.category.replaceAll('-', ' ')}
    </a>
    <span>/</span>
    <a href={`/brands/${deal.brand_id}`} class="hover:text-ink hover:underline">
      {brand?.name || deal.brand_id}
    </a>
  </nav>

  <!-- Editorial Deal Detail Sheet -->
  <article class="border-t border-b editorial-rule py-8">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <BrandMark name={brand?.name || deal.brand_id} logoUrl={brand?.logo_url} size="md" />
        <div>
          <a href={`/brands/${deal.brand_id}`} class="text-[15px] font-semibold uppercase tracking-[0.1em] text-ink hover:underline">
            {brand?.name || deal.brand_id}
          </a>
          <p class="text-[13px] text-ink-muted">
            Updated {deal.last_verified_at.split('T')[0]} · {deal.country === 'GLOBAL' ? 'Worldwide' : deal.country}
          </p>
        </div>
      </div>

      <span class="editorial-pill px-4 py-1.5 text-[14px] font-semibold text-ink">
        {deal.discount_value}
      </span>
    </div>

    <h1 class="text-3xl sm:text-5xl leading-[1.06] text-ink">
      {deal.title}
    </h1>

    <p class="mt-4 max-w-3xl text-[16px] leading-relaxed text-ink-muted">
      {deal.short_description}
    </p>

    <!-- Clean Redemption Strip -->
    <div class="mt-8 flex flex-col justify-between gap-5 border editorial-rule bg-base-900/55 p-6 sm:flex-row sm:items-center">
      {deal.promo_code ? (
        <div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-ink-muted">Promo Code</p>
          <div class="mt-2 flex flex-wrap items-center gap-3">
            <code class="border editorial-rule-strong bg-base-950 px-4 py-2 font-mono text-[16px] font-bold tracking-wider text-ink">
              {deal.promo_code}
            </code>
            <button
              type="button"
              class="copy-code-btn btn-outline px-4 py-2.5 text-[13.5px] font-semibold"
              data-code={deal.promo_code}
              data-outbound={deal.affiliate_url}
            >
              Copy Code & Visit Store
            </button>
          </div>
        </div>
      ) : (
        <div>
          <p class="text-[12px] font-semibold uppercase tracking-[0.15em] text-ink-muted">How to Redeem</p>
          <p class="mt-1 text-[16px] font-semibold text-ink">No code needed — discount is applied directly on store tags.</p>
        </div>
      )}

      <a
        href={`/go/${deal.slug}`}
        target="_blank"
        rel="nofollow sponsored noopener noreferrer"
        class="btn-primary inline-flex shrink-0 items-center justify-center gap-2 px-6 py-3 text-[14px] font-semibold"
      >
        <span>Visit Store</span>
        <Icon name="arrow" class="h-4 w-4" />
      </a>
    </div>

    {deal.bank_details && (
      <StackFinder
        baseSalePercent={deal.numeric_discount_percent || 40}
        bankCashbackPercent={deal.bank_details.cashback_percent || 15}
        promoCodePercent={deal.promo_code ? 5 : 0}
      />
    )}

    <!-- Terms & Conditions -->
    <div class="mt-8 border-t editorial-rule pt-6">
      <h2 class="text-2xl text-ink mb-3">Terms & Conditions</h2>
      <ul class="list-disc space-y-2 pl-5 text-[15px] leading-relaxed text-ink-muted">
        {deal.terms_and_conditions.map((term) => (
          <li>{term}</li>
        ))}
      </ul>
    </div>

    <!-- Branch Info -->
    {deal.branch_info && deal.branch_info.length > 0 && (
      <div class="mt-8 border-t editorial-rule pt-6">
        <h2 class="text-2xl text-ink mb-4">Participating Outlets</h2>
        <div class="grid grid-cols-1 border-l border-t editorial-rule sm:grid-cols-2">
          {deal.branch_info.map((branch) => (
            <div class="border-b border-r editorial-rule p-4">
              <p class="text-[15px] font-semibold text-ink">{branch.branch_name}</p>
              <p class="mt-1 text-[14px] text-ink-muted">{branch.address}</p>
              {branch.phone && <p class="mt-1.5 text-[13.5px] font-medium text-ink">{branch.phone}</p>}
            </div>
          ))}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
