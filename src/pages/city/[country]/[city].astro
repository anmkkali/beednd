---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DealBannerCard from '../../../components/deals/DealBannerCard.astro';
import { getCollection } from 'astro:content';
import { countries, slugify } from '../../../data/countries';

export async function getStaticPaths() {
  const allDeals = await getCollection('deals', ({ data }) => data.status === 'active');
  const allBrands = await getCollection('brands');
  const brandMap = new Map(allBrands.map((b) => [b.data.id, b.data]));

  return countries.flatMap((country) =>
    country.cities.map((city) => ({
      params: { country: country.code.toLowerCase(), city: city.slug },
      props: {
        country,
        city,
        brandMap,
        deals: allDeals.filter(
          (d) => d.data.country === country.code && d.data.cities.some((c) => slugify(c) === city.slug)
        ),
      },
    }))
  );
}

const { country, city, deals, brandMap } = Astro.props;
---

<BaseLayout
  title={`${city.name}, ${country.name} Deals and Discounts`}
  description={`Current store sales, promo codes and discounts available in ${city.name}, ${country.name}.`}
  noindex={deals.length === 0}
  ignoreMarket
>
  <div class="mb-8 border-b editorial-rule pb-8">
    <nav class="mb-3 flex items-center gap-2 text-[13.5px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span>{country.name}</span>
      <span>/</span>
      <span class="text-ink">{city.name}</span>
    </nav>
    <h1 class="text-5xl leading-[0.98] text-ink sm:text-6xl">{city.name} offers</h1>
    <p class="mt-3 max-w-2xl text-[16px] leading-relaxed text-ink-muted">
      Store sales and brand promotions available in {city.name}, {country.name}.
    </p>

    <div class="mt-6 flex flex-wrap gap-2">
      {country.cities.map((c) => (
        <a
          href={`/city/${country.code.toLowerCase()}/${c.slug}/`}
          class:list={[
            'editorial-pill px-4 py-1.5 text-[13.5px] font-medium',
            c.slug === city.slug ? 'btn-primary' : 'text-ink-muted hover:text-ink',
          ]}
        >
          {c.name}
        </a>
      ))}
    </div>
  </div>

  <div>
    {deals.length > 0 ? (
      deals.map((deal) => (
        <DealBannerCard
          deal={deal.data}
          brandName={brandMap.get(deal.data.brand_id)?.name}
          brandLogo={brandMap.get(deal.data.brand_id)?.logo_url}
        />
      ))
    ) : (
      <div class="border-y editorial-rule py-14 text-center">
        <p class="text-[16px] text-ink">No offers are listed for {city.name} yet.</p>
        <p class="mt-2 text-[14.5px] text-ink-muted">New offers are added as brands announce them. Browse all offers in the meantime.</p>
        <a href="/brands" class="btn-primary mt-5 inline-flex px-5 py-2.5 text-[14px] font-semibold">Browse Brands</a>
      </div>
    )}
  </div>
</BaseLayout>
