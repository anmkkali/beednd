---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/common/BrandMark.astro';
import Icon from '../../components/common/Icon.astro';
import Pagination from '../../components/common/Pagination.astro';
import { getCollection } from 'astro:content';

const brands = await getCollection('brands');
const deals = await getCollection('deals', ({ data }) => data.status === 'active');
const dealCounts = new Map<string, number>();
const topDiscounts = new Map<string, string>();

deals.forEach((deal) => {
  dealCounts.set(deal.data.brand_id, (dealCounts.get(deal.data.brand_id) || 0) + 1);
  if (!topDiscounts.has(deal.data.brand_id)) {
    topDiscounts.set(deal.data.brand_id, deal.data.discount_value);
  }
});
---

<BaseLayout title="Browse Brands on Sale" description="Explore brands with active discounts, promo codes, and seasonal sales.">
  <div class="mb-10 border-b editorial-rule pb-8">
    <nav class="mb-3 flex items-center gap-2 text-[13px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <span class="text-ink">Brands</span>
    </nav>
    <h1 class="text-4xl sm:text-6xl leading-[0.98] text-ink">Brands on Discount</h1>
    <p class="mt-3 max-w-2xl text-[15.5px] leading-relaxed text-ink-muted">
      Select any brand below to view all active discount cards, promo codes, and participating outlets for your market.
    </p>
  </div>

  <div id="brands-grid" class="scroll-mt-24 grid grid-cols-1 border-l border-t editorial-rule sm:grid-cols-2 md:grid-cols-3">
    {brands.map((brand) => (
      <a
        data-page-item
        href={`/brands/${brand.data.slug}`}
        data-market={brand.data.country}
        class="group flex flex-col justify-between border-b border-r editorial-rule p-6 transition-colors hover:bg-base-900/70"
      >
        <div>
          <div class="mb-5 flex items-start justify-between gap-3">
            <BrandMark name={brand.data.name} logoUrl={brand.data.logo_url} size="lg" />
            {topDiscounts.get(brand.data.id) && (
              <span class="editorial-pill px-3 py-1 text-[12px] font-semibold text-ink">
                {topDiscounts.get(brand.data.id)}
              </span>
            )}
          </div>

          <h2 class="text-3xl leading-tight text-ink group-hover:underline">
            {brand.data.name}
          </h2>
          <p class="mt-2 line-clamp-2 text-[14.5px] leading-relaxed text-ink-muted">
            {brand.data.short_bio}
          </p>
        </div>

        <div class="mt-6 flex items-center justify-between border-t editorial-rule pt-4 text-[13.5px]">
          <span class="font-medium text-ink">
            {dealCounts.get(brand.data.id) || 0} active {(dealCounts.get(brand.data.id) || 0) === 1 ? 'offer' : 'offers'}
          </span>
          <span class="inline-flex items-center gap-1.5 font-semibold text-ink">
            <span>View Deals</span>
            <Icon name="arrow" class="h-4 w-4" />
          </span>
        </div>
      </a>
    ))}
  </div>
  <Pagination target="brands-grid" />
</BaseLayout>
