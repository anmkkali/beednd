---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/common/Icon.astro';
import { getCollection } from 'astro:content';

const brands = await getCollection('brands');
const deals = await getCollection('deals', ({ data }) => data.status === 'active');
const dealCounts = new Map<string, number>();
deals.forEach((deal) => dealCounts.set(deal.data.brand_id, (dealCounts.get(deal.data.brand_id) || 0) + 1));
---

<BaseLayout title="Browse Brands" description="Browse every brand with active discounts and promo codes.">
  <div class="mb-8 max-w-2xl">
    <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-brand-blue">Brand directory</p>
    <h1 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">Brands with active deals</h1>
    <p class="mt-3 text-sm leading-6 text-gray-400">Only brands available in your detected market are shown by default.</p>
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3">
    {brands.map((brand) => (
      <a
        href={`/brands/${brand.data.slug}`}
        data-market={brand.data.country}
        class="group rounded-2xl bg-base-900 p-5 transition-colors hover:bg-base-800"
      >
        <div class="mb-6 flex items-start justify-between">
          <span class="flex h-14 w-14 items-center justify-center rounded-xl bg-white p-2.5">
            <img src={brand.data.logo_url} alt={`${brand.data.name} logo`} class="h-full w-full object-contain" />
          </span>
          <Icon name="arrow" class="h-4 w-4 text-gray-600 transition-colors group-hover:text-brand-blue" />
        </div>
        <h2 class="text-base font-bold text-white">{brand.data.name}</h2>
        <p class="mt-1 text-xs text-gray-500">{dealCounts.get(brand.data.id) || 0} active deals</p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {brand.data.categories.slice(0, 2).map((category) => (
            <span class="rounded-md bg-base-950 px-2 py-1 text-[10px] capitalize text-gray-500">{category.replaceAll('-', ' ')}</span>
          ))}
        </div>
      </a>
    ))}
  </div>
</BaseLayout>
