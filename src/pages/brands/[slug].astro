---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DealBannerCard from '../../components/deals/DealBannerCard.astro';
import BrandMark from '../../components/common/BrandMark.astro';
import Icon from '../../components/common/Icon.astro';
import BrandAbout from '../../components/common/BrandAbout.astro';
import Pagination from '../../components/common/Pagination.astro';
import { getCollection } from 'astro:content';
import { countryByCode } from '../../data/countries';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  const allDeals = await getCollection('deals', ({ data }) => data.status !== 'draft');
  const nowMs = Date.now();

  return brands.map((brand) => {
    const brandDeals = allDeals.filter((d) => d.data.brand_id === brand.data.id);
    const liveDeals = brandDeals
      .filter((d) => d.data.status === 'active' && (!d.data.end_date || Number.isNaN(Date.parse(d.data.end_date)) || Date.parse(d.data.end_date) >= nowMs))
      .sort((a, b) => b.data.last_verified_at.localeCompare(a.data.last_verified_at));
    const expiredDeals = brandDeals
      .filter((d) => d.data.status === 'expired' || (d.data.end_date && !Number.isNaN(Date.parse(d.data.end_date)) && Date.parse(d.data.end_date) < nowMs))
      .sort((a, b) => b.data.last_verified_at.localeCompare(a.data.last_verified_at));

    return {
      params: { slug: brand.data.slug },
      props: { brand: brand.data, deals: liveDeals, expiredDeals },
    };
  });
}

const { brand, deals, expiredDeals } = Astro.props;
const countryName = brand.country === 'GLOBAL' ? 'Available worldwide' : countryByCode.get(brand.country)?.name || brand.country;
const countryLabel = brand.country === 'GLOBAL' ? 'Worldwide' : countryByCode.get(brand.country)?.name || brand.country;
const topOffer = deals[0]?.data.badge_text || deals[0]?.data.discount_value || 'Latest Sales & Promo Codes';
const faqItems = [
  {
    q: `Does ${brand.name} have an active sale or discount right now?`,
    a: deals.length > 0
      ? `Yes — ${brand.name} currently has ${deals.length} verified ${deals.length === 1 ? 'offer' : 'offers'} live in ${countryLabel}, including ${topOffer}.`
      : `There are no live ${brand.name} sales verified right now, though past offers are archived below. Use "Notify me" to get an alert as soon as the next sale goes live.`,
  },
  {
    q: `How do I claim ${brand.name} discounts and promo codes in ${countryLabel}?`,
    a: `Select any verified ${brand.name} deal on this page to view its terms, eligible cities or channels, and official store link where the discount applies automatically or via promo code.`,
  },
  {
    q: `Where are ${brand.name} offers valid?`,
    a: `${brand.name} deals on BeeDND apply in ${countryLabel}${brand.known_for?.length ? ` across ${brand.known_for.join(', ').toLowerCase()}` : ''}. Always confirm store exclusions on the official ${brand.name} website before checkout.`,
  },
];
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout
  title={`${brand.name} — Latest Sale, Discounts & Promo Codes in ${countryLabel}`}
  description={`Find verified ${brand.name} sales, ${topOffer.toLowerCase()}, promo codes, and seasonal offers in ${countryLabel}. ${brand.short_bio} Updated daily on BeeDND.`}
  noindex={deals.length === 0 && expiredDeals.length === 0}
  structuredData={structuredData}
>
  <div class="mb-6 border-b editorial-rule pb-6">
    <nav class="mb-4 flex items-center gap-2 text-[13.5px] text-ink-muted" aria-label="Breadcrumb">
      <a href="/" class="hover:text-ink hover:underline">Home</a>
      <span>/</span>
      <a href="/brands" class="hover:text-ink hover:underline">Brands</a>
      <span>/</span>
      <span class="text-ink">{brand.name}</span>
    </nav>

    <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-start">
      <div class="flex items-start gap-4 sm:gap-5">
        <BrandMark name={brand.name} logoUrl={brand.logo_url} size="lg" />
        <div>
          <h1 class="text-4xl leading-none text-ink sm:text-5xl">{brand.name}</h1>
          <p class="mt-2.5 max-w-2xl text-[15.5px] leading-relaxed text-ink-muted">{brand.short_bio}</p>
        </div>
      </div>

      <div class="flex shrink-0 flex-wrap gap-2 self-start">
        <button type="button" data-notify-open data-brand={brand.id} class="btn-primary inline-flex items-center gap-2 px-4 py-2.5 text-[13.5px] font-semibold">
          <Icon name="bell" class="h-4 w-4" />
          Notify me
        </button>
        <a href={brand.website_url} target="_blank" rel="noopener noreferrer" class="btn-outline inline-flex items-center gap-2 px-4 py-2.5 text-[13.5px] font-semibold">
          Official store
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-3 text-[13.5px] text-ink-muted">
      <span class="editorial-pill px-3.5 py-1 font-semibold text-ink">{deals.length} active {deals.length === 1 ? 'offer' : 'offers'}</span>
      <span>{countryName}</span>
      {brand.return_policy_days ? <span>{brand.return_policy_days}-day return policy</span> : null}
    </div>
  </div>

  <div id="brand-deals" class="scroll-mt-24 border-t editorial-rule">
    {deals.length > 0 ? (
      deals.map((deal) => <DealBannerCard deal={deal.data} brandName={brand.name} brandLogo={brand.logo_url} />)
    ) : (
      <div class="border-b editorial-rule py-12 text-center text-[15px] text-ink-muted">
        No active offers listed for {brand.name} yet. Use "Notify me" and we will email you when one appears.
      </div>
    )}
  </div>
  <Pagination target="brand-deals" />

  {expiredDeals.length > 0 && (
    <section class="mt-10" aria-labelledby="expired-offers-heading">
      <div class="mb-3 flex items-center justify-between border-b editorial-rule pb-2">
        <h2 id="expired-offers-heading" class="text-2xl text-ink-muted">Past / Expired Offers</h2>
        <span class="editorial-pill px-2.5 py-0.5 text-[11px] font-mono text-ink-muted">{expiredDeals.length}</span>
      </div>
      <div id="expired-brand-deals" class="border-t editorial-rule opacity-75">
        {expiredDeals.map((deal) => (
          <DealBannerCard deal={deal.data} brandName={brand.name} brandLogo={brand.logo_url} />
        ))}
      </div>
    </section>
  )}

  <BrandAbout brand={brand} class="mt-10" />

  <section class="mt-10 border-t editorial-rule pt-8" aria-labelledby="brand-faq-heading">
    <h2 id="brand-faq-heading" class="mb-4 text-2xl text-ink">{brand.name} Sales &amp; Discounts — Frequently Asked Questions</h2>
    <div class="divide-y divide-[rgb(var(--ink)/0.12)] border-t border-b editorial-rule">
      {faqItems.map((item) => (
        <div class="py-4">
          <h3 class="text-[16px] font-semibold text-ink">{item.q}</h3>
          <p class="mt-1.5 text-[14.5px] leading-relaxed text-ink-muted">{item.a}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
