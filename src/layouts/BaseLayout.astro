---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import LeftSidebar from '../components/common/LeftSidebar.astro';
import PagefindModal from '../components/search/PagefindModal.astro';
import AdSlot from '../components/ads/AdSlot.astro';
import SponsorBar from '../components/common/SponsorBar.astro';
import BlogStrip from '../components/common/BlogStrip.astro';
import NotifyModal from '../components/common/NotifyModal.astro';
import SubmitDealModal from '../components/common/SubmitDealModal.astro';
import { ViewTransitions } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeTopic?: string;
  activeCategory?: string;
  structuredData?: any;
  showTopAd?: boolean;
  showBottom?: boolean;
  noindex?: boolean;
  ignoreMarket?: boolean;
}

const {
  title,
  description = 'Current brand discounts, promo codes and free trials, automatically matched to your country.',
  image = '/og-image.jpg',
  activeTopic = '',
  activeCategory = 'all',
  structuredData,
  showTopAd = true,
  showBottom = true,
  noindex = false,
  ignoreMarket = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://beednd.com');
const fontsUrl =
  'https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap';
---

<!doctype html>
<html lang="en" class="scroll-smooth" data-ignore-market={ignoreMarket ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/favicon-black.svg" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon-white.svg" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsUrl} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={fontsUrl} /></noscript>

    <!-- Runs before first paint: theme, sidebar state and country, so nothing flashes or shifts -->
    <script is:inline>
      (() => {
        try {
          const d = document.documentElement;
          const ls = localStorage;
          d.dataset.theme = ls.getItem('dealssite_theme') === 'dark' ? 'dark' : 'light';
          // Blog pages start with the sidebar minimised. Everywhere else follows the saved choice.
          if (location.pathname.indexOf('/blog') === 0 || ls.getItem('dealssite_sidebar') === 'collapsed') d.dataset.sidebar = 'collapsed';

          const TZ = {
            'Asia/Karachi': 'PK', 'Asia/Kolkata': 'IN', 'Asia/Calcutta': 'IN', 'Asia/Dhaka': 'BD', 'Asia/Colombo': 'LK',
            'Asia/Kathmandu': 'NP', 'Asia/Kabul': 'AF', 'Asia/Dubai': 'AE', 'Asia/Riyadh': 'SA', 'Asia/Qatar': 'QA',
            'Asia/Kuwait': 'KW', 'Asia/Muscat': 'OM', 'Asia/Bahrain': 'BH', 'Asia/Tehran': 'IR', 'Asia/Baghdad': 'IQ',
            'Asia/Jerusalem': 'IL', 'Asia/Amman': 'JO', 'Asia/Beirut': 'LB', 'Europe/Istanbul': 'TR', 'Asia/Istanbul': 'TR',
            'Europe/London': 'GB', 'Europe/Dublin': 'IE', 'Europe/Paris': 'FR', 'Europe/Berlin': 'DE', 'Europe/Madrid': 'ES',
            'Europe/Rome': 'IT', 'Europe/Amsterdam': 'NL', 'Europe/Brussels': 'BE', 'Europe/Zurich': 'CH', 'Europe/Vienna': 'AT',
            'Europe/Stockholm': 'SE', 'Europe/Oslo': 'NO', 'Europe/Copenhagen': 'DK', 'Europe/Helsinki': 'FI', 'Europe/Warsaw': 'PL',
            'Europe/Prague': 'CZ', 'Europe/Athens': 'GR', 'Europe/Lisbon': 'PT', 'Europe/Kyiv': 'UA', 'Europe/Kiev': 'UA',
            'Europe/Moscow': 'RU', 'Asia/Shanghai': 'CN', 'Asia/Hong_Kong': 'HK', 'Asia/Tokyo': 'JP', 'Asia/Seoul': 'KR',
            'Asia/Singapore': 'SG', 'Asia/Kuala_Lumpur': 'MY', 'Asia/Jakarta': 'ID', 'Asia/Bangkok': 'TH', 'Asia/Ho_Chi_Minh': 'VN',
            'Asia/Manila': 'PH', 'Asia/Taipei': 'TW', 'Australia/Sydney': 'AU', 'Australia/Melbourne': 'AU', 'Australia/Brisbane': 'AU',
            'Australia/Perth': 'AU', 'Pacific/Auckland': 'NZ', 'Africa/Cairo': 'EG', 'Africa/Lagos': 'NG', 'Africa/Nairobi': 'KE',
            'Africa/Johannesburg': 'ZA', 'Africa/Casablanca': 'MA', 'Africa/Accra': 'GH', 'Africa/Addis_Ababa': 'ET',
            'Africa/Algiers': 'DZ', 'Africa/Tunis': 'TN', 'America/Toronto': 'CA', 'America/Vancouver': 'CA',
            'America/Montreal': 'CA', 'America/Edmonton': 'CA', 'America/Winnipeg': 'CA', 'America/Halifax': 'CA',
            'America/Mexico_City': 'MX', 'America/Sao_Paulo': 'BR', 'America/Argentina/Buenos_Aires': 'AR',
            'America/Bogota': 'CO', 'America/Lima': 'PE', 'America/Santiago': 'CL', 'America/Caracas': 'VE',
          };
          const US = /^(America\/(New_York|Chicago|Denver|Los_Angeles|Phoenix|Detroit|Anchorage|Boise|Indiana|Kentucky|North_Dakota|Juneau|Nome|Sitka|Yakutat|Adak|Metlakatla|Menominee|Puerto_Rico)|Pacific\/Honolulu|US\/)/;
          const detect = () => {
            try {
              const ipCached = sessionStorage.getItem('dealssite_ip_country');
              if (ipCached && /^[A-Z]{2}$/.test(ipCached)) return ipCached;
            } catch {}
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            if (TZ[tz]) return TZ[tz];
            if (US.test(tz)) return 'US';
            const langs = navigator.languages || [navigator.language || ''];
            for (const lang of langs) {
              const region = String(lang).split('-')[1];
              if (region && /^[A-Za-z]{2}$/.test(region)) return region.toUpperCase();
            }
            return 'ALL';
          };
          window.__detectMarket = detect;

          const saved = ls.getItem('dealssite_market');
          const manual = saved && saved !== 'AUTO' && /^([A-Z]{2}|ALL)$/.test(saved);
          const market = manual ? saved : detect();
          d.dataset.activeMarket = market;
          d.dataset.marketMode = manual ? 'manual' : 'auto';
          if (market !== 'ALL') {
            const style = document.createElement('style');
            style.id = 'market-style';
            style.textContent = 'html:not([data-ignore-market]) [data-market]:not([data-market="' + market + '"]):not([data-market="GLOBAL"]){display:none!important}';
            document.head.appendChild(style);
          }
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <title>{title} | DealsSite</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DealsSite" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | DealsSite`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | DealsSite`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <ViewTransitions />
  </head>
  <body class="bg-base-950 text-ink">
    <div id="sticky-top" class="sticky top-0 z-30 w-full" transition:persist="sticky-top">
      <SponsorBar />
      <Header />
    </div>
    <div class="flex min-h-[calc(100vh-65px)]">
      <LeftSidebar activeTopic={activeTopic} activeCategory={activeCategory} />

      <div class="flex min-w-0 flex-1 flex-col">
        <main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-20 pt-6 sm:px-6 lg:px-10" transition:animate="fade">
          <slot />
          {showBottom && (
            <>
              <AdSlot slotType="leaderboard" />
              <BlogStrip />
            </>
          )}
        </main>
        <Footer />
      </div>
    </div>

    <PagefindModal />
    <NotifyModal />
    <SubmitDealModal />

    <script>
      import { countries, countryByCode } from '../data/countries';
      import { COUNTRY_DEFAULT_LANG, SUPPORTED_LANGUAGES, UI_TRANSLATIONS, type LangCode } from '../data/i18n';

      const root = document.documentElement;
      const visible = (el: Element) => getComputedStyle(el).display !== 'none';

      function updateFavicon(theme: string) {
        const fav = document.querySelector<HTMLLinkElement>('link[rel="icon"]');
        if (fav) fav.href = theme === 'dark' ? '/favicon-white.svg' : '/favicon-black.svg';
      }

      if (root.dataset.theme) updateFavicon(root.dataset.theme);

      // Light / dark theme: every [data-theme-toggle] button works the same way
      document.querySelectorAll('[data-theme-toggle]').forEach((button) =>
        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          localStorage.setItem('dealssite_theme', next);
          updateFavicon(next);
        })
      );

      // Country selector, filled with every country
      const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('[data-country-select]'));
      const optionsHtml = countries.map((c) => `<option value="${c.code}">${c.name}</option>`).join('');
      selects.forEach((select) => select.insertAdjacentHTML('beforeend', optionsHtml));

      function marketName(market: string) {
        return market === 'ALL' ? 'All countries' : countryByCode.get(market)?.name || market;
      }

      function renderCities(market: string) {
        const country = countryByCode.get(market);
        const html = country
          ? `<p class="px-4 pb-1 pt-3 text-[12px] font-semibold uppercase tracking-[0.14em] text-ink-muted">Cities in ${country.name}</p>` +
            country.cities
              .map(
                (city) =>
                  `<a href="/city/${country.code.toLowerCase()}/${city.slug}/" class="block px-4 py-2.5 text-[14.5px] text-ink hover:bg-base-900">${city.name}</a>`
              )
              .join('')
          : `<p class="px-4 py-4 text-[14px] leading-relaxed text-ink-muted">Pick a country to see its cities.</p>`;
        document.querySelectorAll('[data-cities-panel]').forEach((panel) => (panel.innerHTML = html));
      }

      function updateBell() {
        const items = Array.from(document.querySelectorAll<HTMLElement>('[data-notif-item]')).filter(visible);
        const count = items.length > 0 ? items.length : 8;
        const seen = Number(localStorage.getItem('dealssite_notif_seen') || 0);
        const unread = items.filter((item) => Number(item.dataset.ts) > seen).length;
        const displayCount = unread > 0 ? unread : count;
        document.querySelectorAll<HTMLElement>('[data-bell-badge]').forEach((badge) => {
          badge.textContent = String(displayCount);
          badge.classList.remove('hidden');
        });
        document.querySelectorAll('[data-notif-empty]').forEach((el) => el.classList.toggle('hidden', items.length > 0));
      }

      function applyMarket(market: string, automatic: boolean) {
        root.dataset.activeMarket = market;
        root.dataset.marketMode = automatic ? 'auto' : 'manual';
        let style = document.getElementById('market-style') as HTMLStyleElement | null;
        if (!style) {
          style = document.createElement('style');
          style.id = 'market-style';
          document.head.appendChild(style);
        }
        style.textContent =
          market === 'ALL'
            ? ''
            : `html:not([data-ignore-market]) [data-market]:not([data-market="${market}"]):not([data-market="GLOBAL"]){display:none!important}`;

        const name = marketName(market);
        document.querySelectorAll('[data-country-label]').forEach((label) => {
          label.textContent = automatic && market !== 'ALL' ? `${name} (Auto)` : name;
        });
        selects.forEach((select) => (select.value = automatic ? 'AUTO' : market));
        renderCities(market);
        updateBell();
        if (!localStorage.getItem('dealssite_lang')) {
          const autoLang = COUNTRY_DEFAULT_LANG[market] || 'en';
          applyLanguage(autoLang, true);
        }
        window.dispatchEvent(new CustomEvent('dealssite:market-updated', { detail: { market } }));
      }

      // Language switching & full-site translation
      const langSelects = Array.from(document.querySelectorAll<HTMLSelectElement>('[data-lang-select]'));
      const langLabels = Array.from(document.querySelectorAll<HTMLElement>('[data-lang-label]'));
      const originalTexts = new WeakMap<Element, string>();

      function getTrCache(lang: string): Record<string, string> {
        try {
          return JSON.parse(localStorage.getItem(`dealssite_tr_${lang}`) || '{}');
        } catch {
          return {};
        }
      }

      function setTrCache(lang: string, cache: Record<string, string>) {
        try {
          const keys = Object.keys(cache);
          if (keys.length > 400) {
            keys.slice(0, keys.length - 400).forEach((k) => delete cache[k]);
          }
          localStorage.setItem(`dealssite_tr_${lang}`, JSON.stringify(cache));
        } catch {}
      }

      async function translateDynamic(lang: LangCode) {
        const targets = Array.from(
          document.querySelectorAll<HTMLElement>(
            'h1, h2, h3 a, [data-page-item] p, .sb-cat summary .sb-label, #hero-market-caption, [data-i18n-dyn]'
          )
        ).filter((el) => {
          if (el.hasAttribute('data-i18n') || el.closest('[data-i18n]')) return false;
          const txt = (originalTexts.get(el) ?? el.textContent ?? '').trim();
          return txt.length >= 2 && txt.length <= 260;
        });

        targets.forEach((el) => {
          if (!originalTexts.has(el)) originalTexts.set(el, (el.textContent || '').trim());
        });

        if (lang === 'en') {
          targets.forEach((el) => {
            const orig = originalTexts.get(el);
            if (orig && el.textContent !== orig) el.textContent = orig;
          });
          return;
        }

        const cache = getTrCache(lang);
        const missing = new Set<string>();
        targets.forEach((el) => {
          const orig = originalTexts.get(el) || '';
          if (cache[orig]) el.textContent = cache[orig];
          else if (orig) missing.add(orig);
        });

        const toFetch = Array.from(missing).slice(0, 45);
        if (!toFetch.length) return;

        // Translate in small batches via Google Translate public endpoint & cache locally
        for (let i = 0; i < toFetch.length; i += 8) {
          const batch = toFetch.slice(i, i + 8);
          await Promise.all(
            batch.map(async (text) => {
              try {
                const res = await fetch(
                  `https://translate.googleapis.com/translate_a/single?client=gtx&sl=en&tl=${encodeURIComponent(lang)}&dt=t&q=${encodeURIComponent(text)}`
                );
                if (!res.ok) return;
                const data = await res.json();
                const translated = Array.isArray(data?.[0]) ? data[0].map((s: any) => s?.[0] || '').join('') : '';
                if (translated) cache[text] = translated;
              } catch {}
            })
          );
          if (root.dataset.activeLang !== lang) return;
          targets.forEach((el) => {
            const orig = originalTexts.get(el) || '';
            if (cache[orig]) el.textContent = cache[orig];
          });
        }
        setTrCache(lang, cache);
      }

      function applyLanguage(lang: LangCode, automatic: boolean) {
        const meta = SUPPORTED_LANGUAGES.find((l) => l.code === lang) || SUPPORTED_LANGUAGES[0];
        root.lang = meta.code;
        root.dir = meta.rtl ? 'rtl' : 'ltr';
        root.dataset.activeLang = meta.code;

        const dict = UI_TRANSLATIONS[meta.code] || UI_TRANSLATIONS.en;
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n || '';
          if (dict[key]) el.textContent = dict[key];
        });

        langLabels.forEach((el) => (el.textContent = meta.native));
        langSelects.forEach((sel) => (sel.value = automatic ? 'AUTO' : meta.code));
        translateDynamic(meta.code);
      }

      const savedLang = localStorage.getItem('dealssite_lang') as LangCode | null;
      const detect = (window as any).__detectMarket as (() => string) | undefined;
      const saved = localStorage.getItem('dealssite_market');
      const manual = saved && saved !== 'AUTO' && /^([A-Z]{2}|ALL)$/.test(saved);
      const initialMarket = manual ? saved! : detect ? detect() : 'ALL';
      applyMarket(initialMarket, !manual);
      if (savedLang && SUPPORTED_LANGUAGES.some((l) => l.code === savedLang)) {
        applyLanguage(savedLang, false);
      } else {
        applyLanguage(COUNTRY_DEFAULT_LANG[initialMarket] || 'en', true);
      }

      langSelects.forEach((sel) =>
        sel.addEventListener('change', () => {
          if (sel.value === 'AUTO') {
            localStorage.removeItem('dealssite_lang');
            const m = root.dataset.activeMarket || 'ALL';
            applyLanguage(COUNTRY_DEFAULT_LANG[m] || 'en', true);
          } else {
            const chosen = sel.value as LangCode;
            localStorage.setItem('dealssite_lang', chosen);
            applyLanguage(chosen, false);
          }
        })
      );

      // IP-based country detection (fixes users abroad seeing wrong timezone/country)
      if (!manual) {
        (async () => {
          try {
            let ipCountry = sessionStorage.getItem('dealssite_ip_country') || '';
            if (!ipCountry) {
              try {
                const r = await fetch('/api/geo');
                if (r.ok) {
                  const j = await r.json();
                  if (j?.country && /^[A-Z]{2}$/.test(j.country)) ipCountry = j.country;
                }
              } catch {}
            }
            if (!ipCountry) {
              try {
                const r2 = await fetch('https://api.country.is/');
                if (r2.ok) {
                  const j2 = await r2.json();
                  if (j2?.country && /^[A-Z]{2}$/.test(j2.country)) ipCountry = j2.country;
                }
              } catch {}
            }
            if (ipCountry && /^[A-Z]{2}$/.test(ipCountry)) {
              sessionStorage.setItem('dealssite_ip_country', ipCountry);
              if (root.dataset.marketMode === 'auto' && root.dataset.activeMarket !== ipCountry) {
                applyMarket(ipCountry, true);
              }
            }
          } catch {}
        })();
      }

      // User behavior interest tracking (used to personalize homepage All offers feed)
      function recordInterest(cat: string, weight = 2) {
        if (!cat) return;
        try {
          const map = JSON.parse(localStorage.getItem('dealssite_interest') || '{}');
          map[cat] = (Number(map[cat]) || 0) + weight;
          localStorage.setItem('dealssite_interest', JSON.stringify(map));
        } catch {}
      }

      const catPathMatch = window.location.pathname.match(/^\/categories\/([^/]+)/);
      if (catPathMatch?.[1]) recordInterest(catPathMatch[1], 3);

      // Preserve theme, sidebar, market, and language state across Astro ClientRouter transitions (zero flicker)
      document.addEventListener('astro:before-swap', (ev: any) => {
        const newDoc = ev.newDocument as Document;
        if (!newDoc) return;
        const nr = newDoc.documentElement;
        if (root.dataset.theme) nr.dataset.theme = root.dataset.theme;
        if (root.dataset.sidebar) nr.dataset.sidebar = root.dataset.sidebar;
        if (root.dataset.activeMarket) nr.dataset.activeMarket = root.dataset.activeMarket;
        if (root.dataset.marketMode) nr.dataset.marketMode = root.dataset.marketMode;
        if (root.dataset.activeLang) nr.dataset.activeLang = root.dataset.activeLang;
        nr.lang = root.lang;
        nr.dir = root.dir;
        const mStyle = document.getElementById('market-style');
        if (mStyle && !newDoc.getElementById('market-style')) {
          newDoc.head.appendChild(mStyle.cloneNode(true));
        }
      });

      document.addEventListener('astro:page-load', () => {
        const m = window.location.pathname.match(/^\/categories\/([^/]+)/);
        if (m?.[1]) recordInterest(m[1], 3);
        const curLang = (root.dataset.activeLang || 'en') as LangCode;
        if (curLang !== 'en') applyLanguage(curLang, !localStorage.getItem('dealssite_lang'));
        updateBell();
      });

      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const dealEl = target.closest<HTMLElement>('[data-category]');
        if (dealEl?.dataset.category && target.closest('a, button')) {
          recordInterest(dealEl.dataset.category, 2);
        }
      });

      selects.forEach((select) =>
        select.addEventListener('change', () => {
          if (select.value === 'AUTO') {
            localStorage.removeItem('dealssite_market');
            sessionStorage.removeItem('dealssite_ip_country');
            applyMarket(detect ? detect() : 'ALL', true);
          } else {
            localStorage.setItem('dealssite_market', select.value);
            applyMarket(select.value, false);
          }
        })
      );

      // Opening the bell marks everything as read
      document.querySelector('[data-bell]')?.addEventListener('toggle', (event) => {
        if ((event.target as HTMLDetailsElement).open) {
          localStorage.setItem('dealssite_notif_seen', String(Date.now()));
        }
      });

      // Full-width mobile panels are placed right under the header, wherever the page is scrolled
      document.addEventListener(
        'toggle',
        (event) => {
          const details = event.target as HTMLDetailsElement;
          if (!details.open) return;
          const panel = details.querySelector<HTMLElement>('[data-mobile-panel]');
          const header = details.closest('header');
          if (panel && getComputedStyle(panel).position === 'fixed') {
            // Bell sits in the header; the Cities button sits in the quick row, so anchor to its own bottom
            const anchor = header ? header.getBoundingClientRect().bottom : details.getBoundingClientRect().bottom + 4;
            panel.style.top = `${Math.round(anchor)}px`;
          }
        },
        true
      );

      // Close dropdowns on outside click or Escape
      document.addEventListener('click', (event) => {
        document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown][open]').forEach((dropdown) => {
          if (!dropdown.contains(event.target as Node)) dropdown.removeAttribute('open');
        });
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          document.querySelectorAll('details[data-dropdown][open]').forEach((dropdown) => dropdown.removeAttribute('open'));
          delete root.dataset.sidebarOpen;
        }
      });
    </script>
  </body>
</html>
