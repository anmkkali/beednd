---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import LeftSidebar from '../components/common/LeftSidebar.astro';
import PagefindModal from '../components/search/PagefindModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeTopic?: string;
  activeCategory?: string;
  structuredData?: any;
}

const {
  title,
  description = "DealsSite - Discover verified retail discounts, coupons, bank card promotions, and store sales across Pakistan and the United States.",
  image = "/og-image.jpg",
  activeTopic = '',
  activeCategory = 'all',
  structuredData
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dealssite.com');
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | DealsSite</title>
    <meta name="title" content={`${title} | DealsSite`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | DealsSite`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | DealsSite`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Schema.org Structured Data -->
    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-base-950 text-gray-100 flex flex-col min-h-screen">
    <Header />

    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-8 flex-1 flex gap-10">
      <LeftSidebar activeTopic={activeTopic} activeCategory={activeCategory} />

      <main class="flex-1 min-w-0 pb-16">
        <slot />
      </main>
    </div>

    <Footer />
    <PagefindModal />

    <script>
      const countryLabel = document.getElementById('detected-country-label');
      const countrySwitcher = document.getElementById('country-switcher') as HTMLSelectElement | null;

      const marketNames: Record<string, string> = {
        PK: 'Pakistan',
        US: 'United States',
        ALL: 'All markets',
        GLOBAL: 'Global',
      };

      function fallbackCountry() {
        const locale = navigator.language || '';
        const region = locale.split('-')[1]?.toUpperCase();
        if (region === 'PK' || region === 'US') return region;
        const timezone = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (timezone === 'Asia/Karachi') return 'PK';
        return region || 'GLOBAL';
      }

      function applyMarket(market: string, automatic = false) {
        const normalized = market === 'PK' || market === 'US' || market === 'ALL' ? market : 'GLOBAL';
        document.documentElement.dataset.market = normalized;
        document.querySelectorAll<HTMLElement>('[data-market]').forEach((item) => {
          const itemMarket = item.dataset.market || 'GLOBAL';
          const visible = normalized === 'ALL' || itemMarket === 'GLOBAL' || itemMarket === normalized;
          item.classList.toggle('market-hidden', !visible);
        });
        if (countryLabel) {
          countryLabel.textContent = automatic
            ? `${marketNames[normalized] || 'Global'} · Auto`
            : marketNames[normalized] || 'Global';
        }
      }

      async function detectMarket() {
        const saved = localStorage.getItem('dealssite_market');
        if (saved && saved !== 'AUTO') {
          if (countrySwitcher) countrySwitcher.value = saved;
          applyMarket(saved);
          return;
        }

        const fallback = fallbackCountry();
        applyMarket(fallback, true);

        try {
          const controller = new AbortController();
          const timeout = window.setTimeout(() => controller.abort(), 1800);
          const response = await fetch('https://ipapi.co/json/', { signal: controller.signal });
          window.clearTimeout(timeout);
          if (!response.ok) return;
          const data = await response.json();
          if (data.country_code) applyMarket(String(data.country_code).toUpperCase(), true);
        } catch {
          // Locale and timezone fallback stays active when geo lookup is unavailable.
        }
      }

      countrySwitcher?.addEventListener('change', () => {
        const value = countrySwitcher.value;
        if (value === 'AUTO') {
          localStorage.removeItem('dealssite_market');
          detectMarket();
        } else {
          localStorage.setItem('dealssite_market', value);
          applyMarket(value);
        }
      });

      detectMarket();
    </script>
  </body>
</html>
