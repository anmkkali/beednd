---
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import LeftSidebar from '../components/common/LeftSidebar.astro';
import PagefindModal from '../components/search/PagefindModal.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  activeTopic?: string;
  activeCategory?: string;
  structuredData?: any;
}

const {
  title,
  description = 'Current brand discounts, promo codes, and local store sales automatically tailored to your country.',
  image = '/og-image.jpg',
  activeTopic = '',
  activeCategory = 'all',
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dealssite.com');
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Fast Non-Blocking Editorial Font Wiring -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      />
    </noscript>

    <!-- Zero-Latency Theme & Country Initialization Before Paint -->
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('dealssite_theme');
          document.documentElement.dataset.theme = savedTheme === 'dark' ? 'dark' : 'light';

          const detectVisitorCountry = () => {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
            if (tz === 'Asia/Karachi') return 'PK';
            if (
              tz.startsWith('America/New_York') ||
              tz.startsWith('America/Chicago') ||
              tz.startsWith('America/Denver') ||
              tz.startsWith('America/Los_Angeles') ||
              tz.startsWith('America/Phoenix') ||
              tz.startsWith('America/Detroit') ||
              tz.startsWith('US/')
            ) {
              return 'US';
            }
            const langs = navigator.languages || [navigator.language || ''];
            for (const lang of langs) {
              const region = String(lang).split('-')[1]?.toUpperCase();
              if (region === 'PK' || region === 'US') return region;
            }
            return 'ALL';
          };

          const savedMarket = localStorage.getItem('dealssite_market');
          const market = savedMarket && savedMarket !== 'AUTO' ? savedMarket : detectVisitorCountry();
          document.documentElement.dataset.market = market;
          document.documentElement.dataset.marketMode = savedMarket && savedMarket !== 'AUTO' ? 'manual' : 'auto';
        } catch {
          document.documentElement.dataset.theme = 'light';
          document.documentElement.dataset.market = 'ALL';
        }
      })();
    </script>

    <title>{title} | DealsSite</title>
    <meta name="title" content={`${title} | DealsSite`} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | DealsSite`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | DealsSite`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    {structuredData && (
      <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    )}
  </head>
  <body class="bg-base-950 text-ink flex flex-col min-h-screen">
    <Header />

    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-10 flex-1 flex gap-10">
      <LeftSidebar activeTopic={activeTopic} activeCategory={activeCategory} />

      <main class="flex-1 min-w-0 pb-20">
        <slot />
      </main>
    </div>

    <Footer />
    <PagefindModal />

    <script>
      const countryLabel = document.getElementById('detected-country-label');
      const countrySwitcher = document.getElementById('country-switcher') as HTMLSelectElement | null;

      const marketNames: Record<string, string> = {
        PK: 'Pakistan',
        US: 'United States',
        ALL: 'All Countries',
        GLOBAL: 'Worldwide',
      };

      function detectVisitorCountry(): string {
        const tz = Intl.DateTimeFormat().resolvedOptions().timeZone || '';
        if (tz === 'Asia/Karachi') return 'PK';
        if (
          tz.startsWith('America/New_York') ||
          tz.startsWith('America/Chicago') ||
          tz.startsWith('America/Denver') ||
          tz.startsWith('America/Los_Angeles') ||
          tz.startsWith('America/Phoenix') ||
          tz.startsWith('America/Detroit') ||
          tz.startsWith('US/')
        ) {
          return 'US';
        }
        const langs = navigator.languages || [navigator.language || ''];
        for (const lang of langs) {
          const region = String(lang).split('-')[1]?.toUpperCase();
          if (region === 'PK' || region === 'US') return region;
        }
        return 'ALL';
      }

      function applyMarket(market: string, automatic = false) {
        const normalized = market === 'PK' || market === 'US' || market === 'ALL' ? market : 'ALL';
        document.documentElement.dataset.market = normalized;
        document.querySelectorAll<HTMLElement>('[data-market]').forEach((item) => {
          const itemMarket = item.dataset.market || 'GLOBAL';
          const visible = normalized === 'ALL' || itemMarket === 'GLOBAL' || itemMarket === normalized;
          item.classList.toggle('market-hidden', !visible);
        });
        if (countryLabel) {
          const label = marketNames[normalized] || 'All Countries';
          countryLabel.textContent = automatic && normalized !== 'ALL' ? `${label} (Auto)` : label;
        }
        window.dispatchEvent(new CustomEvent('dealssite:market-updated', { detail: { market: normalized } }));
      }

      const saved = localStorage.getItem('dealssite_market');
      if (saved && saved !== 'AUTO') {
        if (countrySwitcher) countrySwitcher.value = saved;
        applyMarket(saved, false);
      } else {
        if (countrySwitcher) countrySwitcher.value = 'AUTO';
        applyMarket(detectVisitorCountry(), true);
      }

      countrySwitcher?.addEventListener('change', () => {
        const value = countrySwitcher.value;
        if (value === 'AUTO') {
          localStorage.removeItem('dealssite_market');
          applyMarket(detectVisitorCountry(), true);
        } else {
          localStorage.setItem('dealssite_market', value);
          applyMarket(value, false);
        }
      });

      // Close dropdown <details> menus cleanly when clicking outside
      document.addEventListener('click', (event) => {
        document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown][open]').forEach((dropdown) => {
          if (!dropdown.contains(event.target as Node)) {
            dropdown.removeAttribute('open');
          }
        });
      });
    </script>
  </body>
</html>
